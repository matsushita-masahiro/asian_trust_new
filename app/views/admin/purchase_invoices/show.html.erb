<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h4>購入請求書詳細 - 管理者画面</h4>
          <span class="badge bg-<%= @purchase_invoice.status == 0 ? 'secondary' : @purchase_invoice.status == 1 ? 'warning' : @purchase_invoice.status == 2 ? 'success' : @purchase_invoice.status == 3 ? 'info' : 'primary' %> fs-6">
            <%= @purchase_invoice.status_display_name %>
          </span>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-sm-3"><strong>請求書番号:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.invoice_number %></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>請求日:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.invoice_date.strftime("%Y年%m月%d日") %></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>支払期限:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.due_date.strftime("%Y年%m月%d日") %></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>購入者:</strong></div>
            <div class="col-sm-9">
              <%= link_to @purchase_invoice.buyer.name, admin_user_path(@purchase_invoice.buyer), 
                  class: "text-decoration-none" %>
              (<%= @purchase_invoice.buyer.email %>)
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>販売者:</strong></div>
            <div class="col-sm-9">
              <%= link_to @purchase_invoice.user.name, admin_user_path(@purchase_invoice.user), 
                  class: "text-decoration-none" %>
              (<%= @purchase_invoice.user.email %>)
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>購入日:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.purchased_at.strftime("%Y年%m月%d日 %H:%M") %></div>
          </div>
          
          <hr>
          
          <h5>購入明細</h5>
          <div class="table-responsive">
            <table class="table table-sm table-striped">
              <thead class="table-dark">
                <tr>
                  <th>商品名</th>
                  <th class="text-end">単価</th>
                  <th class="text-end">数量</th>
                  <th class="text-end">小計</th>
                </tr>
              </thead>
              <tbody>
                <% @purchase_invoice.purchase_items.each do |item| %>
                  <tr>
                    <td><%= item.product.name %></td>
                    <td class="text-end"><%= number_with_delimiter(item.unit_price) %>円</td>
                    <td class="text-end"><%= item.quantity %></td>
                    <td class="text-end"><%= number_with_delimiter(item.total_price) %>円</td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr class="table-primary">
                  <th colspan="3" class="text-end">合計金額:</th>
                  <th class="text-end"><%= number_with_delimiter(@purchase_invoice.total_amount) %>円</th>
                </tr>
              </tfoot>
            </table>
          </div>
          
          <% if @purchase_invoice.notes.present? %>
            <hr>
            <h6>備考</h6>
            <p><%= simple_format(@purchase_invoice.notes) %></p>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5>管理者操作</h5>
        </div>
        <div class="card-body">
          <% if @purchase_invoice.draft? %>
            <%= link_to "請求書送付", send_invoice_admin_purchase_invoice_path(@purchase_invoice), 
                method: :patch, class: "btn btn-primary btn-sm mb-2 w-100",
                confirm: "請求書を送付しますか？" %>
          <% end %>
          
          <% if @purchase_invoice.sent? %>
            <%= link_to "支払い確認", confirm_payment_admin_purchase_invoice_path(@purchase_invoice), 
                method: :patch, class: "btn btn-success btn-sm mb-2 w-100",
                confirm: "支払いを確認しますか？" %>
          <% end %>
          
          <% if @purchase_invoice.receipt_requested? %>
            <%= link_to "領収書発行", send_receipt_admin_purchase_invoice_path(@purchase_invoice), 
                method: :patch, class: "btn btn-info btn-sm mb-2 w-100",
                confirm: "領収書を発行しますか？" %>
          <% end %>
          
          <%= link_to "編集", edit_admin_purchase_invoice_path(@purchase_invoice), 
              class: "btn btn-outline-secondary btn-sm mb-2 w-100" %>
          
          <%= link_to "一覧に戻る", admin_purchase_invoices_path, class: "btn btn-secondary btn-sm w-100" %>
        </div>
      </div>
      
      <div class="card mt-3">
        <div class="card-header">
          <h6>ステータス履歴</h6>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li><i class="fas fa-check text-success"></i> 作成済み (<%= @purchase_invoice.created_at.strftime("%m/%d %H:%M") %>)</li>
            <% if @purchase_invoice.sent_at %>
              <li><i class="fas fa-check text-success"></i> 送付済み (<%= @purchase_invoice.sent_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
            <% if @purchase_invoice.confirmed_at %>
              <li><i class="fas fa-check text-success"></i> 支払い確認済み (<%= @purchase_invoice.confirmed_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
            <% if @purchase_invoice.receipt_requested_at %>
              <li><i class="fas fa-check text-success"></i> 領収書依頼済み (<%= @purchase_invoice.receipt_requested_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
            <% if @purchase_invoice.receipt_sent_at %>
              <li><i class="fas fa-check text-success"></i> 領収書発行済み (<%= @purchase_invoice.receipt_sent_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
          </ul>
        </div>
      </div>
      
      <div class="card mt-3">
        <div class="card-header">
          <h6>関連情報</h6>
        </div>
        <div class="card-body">
          <p><strong>購入ID:</strong> <%= @purchase_invoice.purchase.id %></p>
          <p><strong>購入者レベル:</strong> <%= @purchase_invoice.buyer.level&.name %></p>
          <p><strong>販売者レベル:</strong> <%= @purchase_invoice.user.level&.name %></p>
          <p><strong>支払い方法:</strong> <%= @purchase_invoice.purchase.payment_type == 'cash' ? '銀行振込' : 'クレジットカード' %></p>
        </div>
      </div>
    </div>
  </div>
</div>