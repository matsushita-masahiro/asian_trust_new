<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>請求書</title>
  <style>
    @page {
      size: A4;
      margin: 15mm;
    }
    
    body {
      font-family: 'Yu Gothic', 'Hiragino Kaku Gothic ProN', 'Meiryo', 'MS Gothic', sans-serif;
      font-size: 12px;
      line-height: 1.5;
      margin: 0;
      padding: 0;
      color: #000;
    }
    
    .header {
      text-align: center !important;
      margin: 0 auto 30px auto;
      page-break-after: avoid;
      width: 100%;
      display: block;
      clear: both;
    }
    
    .title {
      text-align: center;
      font-size: 20px;
      font-weight: 600;
    }
    
    .header p {
      text-align: center !important;
      margin: 5px auto 0 auto;
    }
    
    .invoice-info {
      display: flex;
      justify-content: space-between;
      margin-bottom: 15px;
      width: 100%;
      clear: both;
    }
    
    .invoice-info:after {
      content: "";
      display: table;
      clear: both;
    }
    
    .invoice-info .left {
      width: 48%;
      float: left;
    }
    
    .invoice-info .right {
      width: 48%;
      float: right;
      text-align: right;
    }
    
    .company-header {
      text-align: right !important;
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid #ddd;
      width: 100%;
    }
    
    .company-header h3 {
      font-weight: bold;
      color: #333;
      text-align: right !important;
      margin: 5px 0;
    }
    
    .company-header div {
      text-align: right !important;
    }
    
    .invoice-info table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .invoice-info th,
    .invoice-info td {
      padding: 3px;
      text-align: left;
      border-bottom: 1px solid #ddd;
      font-size: 10px;
    }
    
    .invoice-info th {
      background-color: #f5f5f5;
      font-weight: bold;
      width: 30%;
    }
    
    .amount-section {
      text-align: center;
      margin: 15px 0;
      padding: 15px;
      border: 2px solid #333;
      background-color: #f9f9f9;
    }
    
    .amount-section h2 {
      margin: 0 0 8px 0;
      font-size: 16px;
    }
    
    .amount {
      font-size: 24px;
      font-weight: bold;
      color: #2e7d32;
    }
    
    .details-section {
      margin: 15px 0;
    }
    
    .details-section h3 {
      font-size: 14px;
      margin-bottom: 10px;
      padding-bottom: 3px;
      border-bottom: 1px solid #333;
    }
    
    .details-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 10px;
      font-family: 'Yu Gothic', 'Hiragino Kaku Gothic ProN', 'Meiryo', 'MS Gothic', sans-serif;
      page-break-inside: auto;
    }
    
    .details-table thead {
      /* ヘッダーの繰り返し表示を無効化 */
    }
    
    @media print {
      .details-table thead {
        display: none !important;
      }
      .details-table thead:first-child {
        display: table-header-group !important;
      }
    }
    
    .details-table tr {
      page-break-inside: avoid;
    }
    
    .details-table tbody {
      page-break-inside: auto;
    }
    

    
    .details-table th,
    .details-table td {
      padding: 6px;
      text-align: left;
      border: 1px solid #333;
      font-size: 9px;
      vertical-align: middle;
    }
    
    .details-table th {
      background-color: #f5f5f5;
      font-weight: bold;
    }
    
    .details-table .number {
      text-align: right;
    }
    
    .footer {
      margin-top: 15px;
      font-size: 9px;
      color: #666;
      page-break-inside: avoid;
    }
    
    .no-break {
      page-break-inside: avoid;
    }
    
    .page-break-before {
      page-break-before: always;
    }
    
    .page-break-after {
      page-break-after: always;
    }
    
    .company-info {
      margin-top: 15px;
      padding: 10px;
      background-color: #f9f9f9;
      border: 1px solid #ddd;
    }
    
    .company-info h4 {
      margin: 0 0 8px 0;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <%
    # ローカル変数が渡されているかチェック
    purchase_invoice = local_assigns[:purchase_invoice] if local_assigns.key?(:purchase_invoice)
    purchase = local_assigns[:purchase] if local_assigns.key?(:purchase)
    user = local_assigns[:user] if local_assigns.key?(:user)
    purchase_items = local_assigns[:purchase_items] || []
    total_with_tax = local_assigns[:total_with_tax] || 0
    subtotal = local_assigns[:subtotal] || 0
    tax = local_assigns[:tax] || 0
    
    # 会社情報と銀行情報を環境変数から取得（ローカル変数が優先）
    company_name = local_assigns[:company_name] || ENV['COMPANY_NAME'] || "株式会社アジアビジネストラスト"
    company_address = local_assigns[:company_address] || "〒#{ENV['COMPANY_POSTAL_CODE'] || '104-0061'} #{ENV['COMPANY_ADDRESS'] || '東京都中央区銀座4丁目8-1'} #{ENV['COMPANY_BUILDING'] || '銀座穂月ビル３階'}"
    company_postal_code = local_assigns[:company_postal_code] || "〒#{ENV['COMPANY_POSTAL_CODE'] || '104-0061'}"
    company_tel = local_assigns[:company_tel] || "TEL:#{ENV['COMPANY_TEL'] || '03-5904-8148'}"
    company_email = local_assigns[:company_email] || "Email: #{ENV['COMPANY_EMAIL'] || 'abt1@asia-b-t.com'}"
    company_footer = local_assigns[:company_footer] || ENV['COMPANY_FOOTER'] || "アジアビジネストラスト 事務局"
    # インボイス登録番号：データベース優先、フォールバックで環境変数
    admin_user = User.find_by(admin: true)
    invoice_recipient = admin_user&.invoice_recipient
    registration_number = local_assigns[:registration_number] || 
                         invoice_recipient&.invoice_registration_number || 
                         ENV['COMPANY_REGISTRATION_NUMBER'] || 
                         "T4210001009156"
    
    bank_name = local_assigns[:bank_name] || ENV['BANK_NAME'] || "楽天銀行"
    bank_branch = local_assigns[:bank_branch] || ENV['BANK_BRANCH'] || "第三営業支店"
    bank_branch_code = local_assigns[:bank_branch_code] || ENV['BANK_BRANCH_CODE'] || "252"
    bank_account_type = local_assigns[:bank_account_type] || ENV['BANK_ACCOUNT_TYPE'] || "普通預金"
    bank_account_number = local_assigns[:bank_account_number] || ENV['BANK_ACCOUNT_NUMBER'] || "7247552"
    bank_account_name = local_assigns[:bank_account_name] || company_name
  %>

  <div class="title">請求書</div>

  <div class="invoice-info">
    <div class="left">
      <h3>請求先</h3>
      <table>
        <tr>
          <th>宛先</th>
          <td><%= user&.invoice_recipient&.name || user&.name || "お客" %> 様</td>
        </tr>
        <% if user&.invoice_recipient&.postal_code.present? %>
        <tr>
          <th>郵便番号</th>
          <td>〒<%= user&.invoice_recipient&.postal_code %></td>
        </tr>
        <% end %>
        <% if user&.invoice_recipient&.address.present? %>
        <tr>
          <th>住所</th>
          <td><%= user&.invoice_recipient&.address %></td>
        </tr>
        <% end %>
        <% if user&.invoice_recipient&.phone.present? %>
        <tr>
          <th>電話</th>
          <td><%= user&.invoice_recipient&.phone %></td>
        </tr>
        <% end %>
      </table>
      
      <!-- 請求書情報を左側に移動 -->
      <h3 style="margin-top: 20px;">請求書情報</h3>
      <table>
        <tr>
          <th>請求書番号</th>
          <td><%= purchase_invoice&.invoice_number || "PUR-#{purchase&.id&.to_s&.rjust(6, '0')}" %></td>
        </tr>
        <tr>
          <th>発行日</th>
          <td><%= purchase_invoice&.invoice_date&.strftime("%Y年%m月%d日") || Date.current.strftime("%Y年%m月%d日") %></td>
        </tr>
        <tr>
          <th>支払期限</th>
          <td><%= purchase_invoice&.due_date&.strftime("%Y年%m月%d日") || (Date.current + 30.days).strftime("%Y年%m月%d日") %></td>
        </tr>
        <tr>
          <th>登録番号</th>
          <td><%= registration_number %></td>
        </tr>
      </table>
    </div>
    
    <div class="right">
      <!-- 発行者情報とロゴのみ -->
      <div class="company-header">
        <%= wicked_pdf_image_tag "abt_logo.png", style: "height: 40px; margin-bottom: 10px;" %>
        <h3 style="margin: 5px 0; font-size: 14px;"><%= company_name %></h3>
        <div style="font-size: 10px; line-height: 1.3; margin-bottom: 15px;">
          <%= company_postal_code %><br>
          <%= company_address %><br>
          TEL: <%= company_tel %><br>
          <%= company_email %>
        </div>
      </div>
    </div>
  </div>

  <div class="amount-section">
    <h2>ご請求金額</h2>
    <div class="amount">¥<%= number_with_delimiter(total_with_tax) %>-</div>
    <p>（商品代金）</p>
  </div>

  <% if purchase_items.any? %>
  <div class="details-section">
    <h3>商品明細</h3>
    <table class="details-table">
      <thead>
        <tr>
          <th>商品名</th>
          <th class="number">数量</th>
          <th class="number">単価</th>
          <th class="number">金額</th>
        </tr>
      </thead>
      <tbody>
        <% purchase_items.each do |item| %>
        <% 
          # 骨髄幹細胞培養上清液（ID: 1）の場合は、保存されている数量を5で割って表示
          display_quantity = (item.product_id == 1) ? (item.quantity / 5) : item.quantity
          # 単価取得（seller_priceがあればそれを使用、なければunit_price）
          unit_price = item.seller_price || item.unit_price
          # 骨髄幹細胞培養上清液（ID: 1）の場合は10cc単位の価格（5倍）
          display_unit_price = (item.product_id == 1) ? (unit_price * 5) : unit_price
          # 小計計算
          item_subtotal = display_unit_price * display_quantity
        %>
        <tr>
          <td><%= item.product&.name || item.product&.title || "商品名不明" %></td>
          <td class="number"><%= display_quantity %></td>
          <td class="number">¥<%= number_with_delimiter(display_unit_price) %></td>
          <td class="number">¥<%= number_with_delimiter(item_subtotal) %></td>
        </tr>
        <% end %>
        <!-- 送料行を追加 -->
        <% if local_assigns[:shipping_fee] && local_assigns[:shipping_fee] > 0 %>
        <% 
          # 購入の配送先情報から実際の配送先名を取得
          purchase_obj = local_assigns[:purchase]
          delivery_informations = local_assigns[:delivery_informations] || purchase_obj&.delivery_informations || []
          shipping_fees_data = purchase_obj&.shipping_fees || []
          
          # 配送先情報が存在する場合は実際の配送先名を使用
          if delivery_informations.any?
            delivery_informations.each_with_index do |delivery_info, index|
              shipping_label = case delivery_info.delivery_type
              when 'clinic'
                clinic_name = delivery_info.clinic&.name || 'クリニック'
                "送料（#{clinic_name}）"
              when 'home'
                address_type = delivery_info.address_type == 'shipping' ? '配送先住所' : '登録住所'
                "送料（#{address_type}）"
              when 'other'
                recipient_name = delivery_info.recipient_name || 'その他お届け先'
                "送料（#{recipient_name}）"
              else
                "送料（配送先#{index + 1}）"
              end
        %>
        <tr>
          <td><%= shipping_label %></td>
          <td class="number">-</td>
          <td class="number">-</td>
          <td class="number">¥6,000</td>
        </tr>
        <%   end %>
        <% elsif shipping_fees_data.any? %>
          <!-- 配送先情報がないが送料データがある場合 -->
          <% shipping_fees_data.each_with_index do |shipping_fee_record, index| %>
            <% 
              shipping_label = case shipping_fee_record.shipping_type
              when 'clinic_delivery'
                "送料（クリニック配送）"
              when 'home_delivery'
                "送料（登録住所）"
              when 'other_delivery'
                "送料（その他お届け先）"
              when 'bone_marrow'
                "送料（骨髄別送）"
              when 'standard'
                "送料"
              else
                if shipping_fees_data.size == 1
                  "送料"
                else
                  "送料（配送先#{index + 1}）"
                end
              end
            %>
        <tr>
          <td><%= shipping_label %></td>
          <td class="number">-</td>
          <td class="number">-</td>
          <td class="number">¥<%= number_with_delimiter(shipping_fee_record.amount) %></td>
        </tr>
        <%   end %>
        <% else %>
          <!-- 送料データがない場合は総額から計算 -->
          <% 
            shipping_fees_count = (local_assigns[:shipping_fee] / 6000).to_i
            shipping_fees_count = 1 if shipping_fees_count == 0 && local_assigns[:shipping_fee] > 0
            
            shipping_fees_count.times do |index|
              shipping_label = if shipping_fees_count == 1
                "送料"
              else
                "送料（配送先#{index + 1}）"
              end
          %>
        <tr>
          <td><%= shipping_label %></td>
          <td class="number">-</td>
          <td class="number">-</td>
          <td class="number">¥6,000</td>
        </tr>
        <%   end %>
        <% end %>
        <% end %>
        <!-- 事務手数料行を追加 -->
        <% if local_assigns[:admin_fee] && local_assigns[:admin_fee] > 0 %>
        <tr>
          <td>事務手数料</td>
          <td class="number">-</td>
          <td class="number">-</td>
          <td class="number">¥<%= number_with_delimiter(local_assigns[:admin_fee]) %></td>
        </tr>
        <% end %>
        <!-- 合計行を tbody 内の最後の行として配置 -->
        <tr style="font-weight: bold; page-break-inside: avoid;">
          <td colspan="3" style="text-align: center;">小計（税抜）</td>
          <td class="number">¥<%= number_with_delimiter(subtotal) %></td>
        </tr>
        <tr style="font-weight: bold; page-break-inside: avoid;">
          <td colspan="3" style="text-align: center;">消費税（10%）</td>
          <td class="number">¥<%= number_with_delimiter(tax) %></td>
        </tr>
        <tr style="background-color: #f0f0f0; color: #000; font-weight: bold; page-break-inside: avoid;">
          <td colspan="3" style="text-align: center; background-color: #f0f0f0; color: #000;">合計</td>
          <td class="number" style="background-color: #f0f0f0; color: #000;">¥<%= number_with_delimiter(total_with_tax) %></td>
        </tr>
      </tbody>
    </table>
  </div>
  <% end %>

  <div class="company-info no-break">
    <h4>振込先情報</h4>
    <p>
      <strong>銀行名：</strong><%= bank_name %><br>
      <strong>支店名：</strong><%= bank_branch %><br>
      <% if bank_branch_code.present? %>
      <strong>支店番号：</strong><%= bank_branch_code %><br>
      <% end %>
      <strong>口座種別：</strong><%= bank_account_type %><br>
      <strong>口座番号：</strong><%= bank_account_number %><br>
      <strong>口座名義：</strong><%= bank_account_name %>
    </p>
  </div>

  <div class="footer no-break">
    <p>※ お振込手数料はお客様のご負担でお願いいたします。</p>
  </div>
</body>
</html>