<div class="container-fluid" style="padding-top: 100px;">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-primary">
          <i class="fas fa-level-up-alt me-2"></i>
          WOTTレベル昇格申請詳細
        </h4>
        <%= link_to admin_wott_level_upgrade_requests_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-arrow-left me-1"></i>一覧に戻る
        <% end %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">申請情報</h5>
        </div>
        <div class="card-body">
          <table class="table">
            <tr>
              <th style="width: 200px;">申請日時</th>
              <td><%= @request.created_at.strftime("%Y年%m月%d日 %H:%M") %></td>
            </tr>
            <tr>
              <th>ユーザー</th>
              <td>
                <%= link_to admin_user_path(@request.user) do %>
                  <%= @request.user.name %> (<%= @request.user.email %>)
                <% end %>
              </td>
            </tr>
            <tr>
              <th>現在のWOTTレベル</th>
              <td>
                <span class="badge bg-secondary" style="font-size: 1rem;">
                  <%= @request.current_level_name %>
                </span>
              </td>
            </tr>
            <tr>
              <th>申請WOTTレベル</th>
              <td>
                <span class="badge bg-primary" style="font-size: 1rem;">
                  <%= @request.requested_level_name %>
                </span>
              </td>
            </tr>
            <tr>
              <th>関連購入</th>
              <td>
                <% if @request.purchase %>
                  <%= link_to admin_purchase_path(@request.purchase), class: "btn btn-sm btn-outline-primary" do %>
                    <i class="fas fa-shopping-cart me-1"></i>購入 #<%= @request.purchase.id %>を表示
                  <% end %>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
            <tr>
              <th>ステータス</th>
              <td>
                <% 
                  status_badge = case @request.status
                                when 'pending' then 'bg-warning'
                                when 'approved' then 'bg-success'
                                when 'rejected' then 'bg-danger'
                                else 'bg-secondary'
                                end
                  status_text = case @request.status
                               when 'pending' then '承認待ち'
                               when 'approved' then '承認済み'
                               when 'rejected' then '却下'
                               else @request.status
                               end
                %>
                <span class="badge <%= status_badge %>" style="font-size: 1rem;"><%= status_text %></span>
              </td>
            </tr>
            <% if @request.processed_by %>
              <tr>
                <th>処理者</th>
                <td><%= @request.processed_by.name %></td>
              </tr>
              <tr>
                <th>処理日時</th>
                <td><%= @request.processed_at.strftime("%Y年%m月%d日 %H:%M") %></td>
              </tr>
            <% end %>
            <% if @request.admin_notes.present? %>
              <tr>
                <th>管理者メモ</th>
                <td><%= simple_format(@request.admin_notes) %></td>
              </tr>
            <% end %>
          </table>
        </div>
      </div>

      <% if @request.pending? %>
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">申請処理</h5>
          </div>
          <div class="card-body">
            <%= form_with url: approve_admin_wott_level_upgrade_request_path(@request), method: :post, local: true do |f| %>
              <div class="mb-3">
                <%= f.label :admin_notes, '管理者メモ（任意）', class: 'form-label' %>
                <%= f.text_area :admin_notes, class: 'form-control', rows: 3, placeholder: '承認理由や備考を入力' %>
              </div>
              <div class="d-flex gap-2">
                <%= f.submit '承認する', class: 'btn btn-success', data: { confirm: "#{@request.user.name}さんのWOTTレベルを#{@request.requested_level_name}に昇格させますか？" } %>
                <%= button_to '却下する', reject_admin_wott_level_upgrade_request_path(@request), 
                    method: :post, 
                    params: { admin_notes: params[:admin_notes] },
                    class: 'btn btn-danger', 
                    data: { confirm: 'この申請を却下しますか？' } %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">ユーザー情報</h5>
        </div>
        <div class="card-body">
          <p><strong>名前:</strong> <%= @request.user.name %></p>
          <p><strong>メール:</strong> <%= @request.user.email %></p>
          <p><strong>電話:</strong> <%= @request.user.phone %></p>
          <p><strong>幹細胞レベル:</strong> <%= @request.user.level&.name || '未設定' %></p>
          <p><strong>現在のWOTTレベル:</strong> <%= @request.user.wott_level&.name || '未設定' %></p>
          <%= link_to 'ユーザー詳細を表示', admin_user_path(@request.user), class: 'btn btn-sm btn-outline-primary w-100' %>
        </div>
      </div>
    </div>
  </div>
</div>
