.clinic-date-field {
  position: relative;
}

.clinic-date-field:invalid {
  border-color: #dc3545;
  box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
}

/* 日付ピッカーで無効な日付を視覚的に示す */
