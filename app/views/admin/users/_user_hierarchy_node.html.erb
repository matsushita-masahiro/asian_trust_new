<div class="hierarchy-row level-<%= level %>">
  <%= link_to admin_user_path(user), class: "user-node-link" do %>
    <div class="user-node">
      <div class="user-name">
        <%= user.name.present? ? user.name : user.email %>
        
        <% # 幹細胞レベル（アドバイザー側）を先に表示 %>
        <% if user.level %>
          <span class="badge <%= level_badge_class(user.level.name) %> ms-2" style="font-size: 0.5rem; padding: 0.2rem 0.4rem;">
            <i class="fas fa-user-tie me-1"></i><%= user.level.name %>（幹細胞）
          </span>
        <% end %>
        
        <% # WOTTレベル（お客様側）を後に表示 %>
        <% if user.wott_level %>
          <span class="badge <%= wott_level_badge_class(user.wott_level.name) %> ms-1" style="font-size: 0.5rem; padding: 0.2rem 0.4rem; opacity: 0.85;">
            <i class="fas fa-shopping-cart me-1"></i><%= user.wott_level.name %>（WOTT）
          </span>
        <% end %>
        
        <span class="badge bg-info ms-1" style="font-size: 0.45rem; padding: 0.2rem 0.4rem;">ID: <%= user.id %></span>
      </div>
      
      <div class="user-stats">
        <% stats = @user_stats[user.id] %>
        <div class="row">
          <div class="col-6">
            <strong><%= @current_month_name %>:</strong><br>
            売上 <span class="<%= stats[:current][:sales] > 0 ? 'sales-positive' : 'sales-zero' %>">¥<%= number_with_delimiter(stats[:current][:sales]) %></span><br>
            ボーナス <span class="<%= stats[:current][:bonus] > 0 ? 'bonus-positive' : 'bonus-zero' %>">¥<%= number_with_delimiter(stats[:current][:bonus]) %></span>
          </div>
          <div class="col-6">
            <strong><%= @last_month_name %>:</strong><br>
            売上 <span class="<%= stats[:last][:sales] > 0 ? 'sales-positive' : 'sales-zero' %>">¥<%= number_with_delimiter(stats[:last][:sales]) %></span><br>
            ボーナス <span class="<%= stats[:last][:bonus] > 0 ? 'bonus-positive' : 'bonus-zero' %>">¥<%= number_with_delimiter(stats[:last][:bonus]) %></span>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  
  <% if user.referrals.any? %>
    <div class="children-container">
      <% user.referrals.order(:id).each do |child| %>
        <%= render 'user_hierarchy_node', user: child, level: level + 1 %>
      <% end %>
    </div>
  <% end %>
</div>