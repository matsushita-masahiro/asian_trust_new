<% 
  # ページ全体で使用する変数を最初に定義
  delivery_destinations = []
  clinic_ids = []
  has_home_delivery = false
  
  has_other_delivery = false
  
  if @cart_items_with_delivery.present?
    @cart_items_with_delivery.each do |item_info|
      if item_info[:delivery_type] == 'clinic' && item_info[:clinic_id].present?
        clinic_ids << item_info[:clinic_id] unless clinic_ids.include?(item_info[:clinic_id])
      elsif item_info[:delivery_type] == 'home'
        has_home_delivery = true
      elsif item_info[:delivery_type] == 'other'
        has_other_delivery = true
      end
    end
    
    # クリニック配送先を追加
    clinic_ids.each do |clinic_id|
      clinic = Clinic.find_by(id: clinic_id)
      if clinic
        items = @cart_items_with_delivery.select { |i| i[:clinic_id] == clinic_id }
        product_names = items.map { |i| i[:item].product.name }.join(', ')
        
        delivery_destinations << {
          title: "#{clinic.name}（クリニック配送）",
          icon: 'fas fa-hospital',
          address: "クリニック配送",
          note: product_names,
          phone: clinic.user.phone,
          type: 'clinic'
        }
      end
    end
    
    # 自宅配送先を追加
    if has_home_delivery
      home_items = @cart_items_with_delivery.select { |i| i[:delivery_type] == 'home' }
      address_type = home_items.first[:address_type]
      selected_address = address_type == 'shipping' ? current_user.shipping_address : current_user.registration_address
      address_type_label = address_type == 'shipping' ? '配送先住所' : '登録住所'
      product_names = home_items.map { |i| i[:item].product.name }.join(', ')
      
      delivery_destinations << {
        title: "#{address_type_label}（自宅配送）",
        icon: 'fas fa-home',
        address: (selected_address&.postal_code.present? && selected_address&.address.present?) ? 
                 "〒#{selected_address.postal_code}<br>#{selected_address.address}".html_safe : 
                 '<span class="text-danger">住所が登録されていません</span>'.html_safe,
        note: product_names,
        type: 'home'
      }
    end
    
    # その他配送先を追加
    if has_other_delivery
      other_items = @cart_items_with_delivery.select { |i| i[:delivery_type] == 'other' }
      other_items.each do |item_info|
        item = item_info[:item]
        if item.other_postal_code.present? && item.other_address.present?
          delivery_destinations << {
            title: "#{item.other_recipient_name || 'その他お届け先'}（その他配送）",
            icon: 'fas fa-map-marker-alt',
            address: "〒#{item.other_postal_code}<br>#{item.other_address}".html_safe,
            note: item.product.name,
            phone: item.other_phone_number,
            type: 'other'
          }
        end
      end
    end
  end
  
  # 配送先数を計算
  has_stem_cell_product = clinic_ids.any?
  has_other_products = has_home_delivery || has_other_delivery
%>

<div class="container mt-4">
  <h3>購入確認</h3>
  
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5>注文内容</h5>
        </div>
        <div class="card-body">
          <% if @cart&.cart_items&.any? %>
            <table class="table">
              <thead>
                <tr>
                  <th>商品名</th>
                  <th class="text-center">数量</th>
                  <th class="text-end">単価</th>
                  <th class="text-end">小計</th>
                  <th>配送先</th>
                </tr>
              </thead>
              <tbody>
                <% @cart.cart_items.each do |item| %>
                  <% 
                    # 骨髄幹細胞培養上清液（ID: 1）の場合は、保存されている数量を5で割って表示
                    display_quantity = (item.product.id == 1) ? (item.quantity / 5) : item.quantity
                    # 骨髄幹細胞培養上清液（ID: 1）の場合は10cc単位で表示
                    display_unit = (item.product.id == 1) ? "10cc" : item.product.display_unit
                    # 単価取得
                    unit_price = item.product.price_for(current_user.level_symbol) || 0
                    # 骨髄幹細胞培養上清液（ID: 1）の場合は10cc単位の価格（5倍）
                    display_unit_price = (item.product.id == 1) ? (unit_price * 5) : unit_price
                    # 小計計算
                    item_subtotal = display_unit_price * display_quantity
                    
                    # 配送先情報を取得
                    item_delivery_info = @cart_items_with_delivery.find { |i| i[:item].id == item.id }
                    delivery_type = item_delivery_info[:delivery_type]
                    clinic_id = item_delivery_info[:clinic_id]
                    address_type = item_delivery_info[:address_type]
                  %>
                  <tr>
                    <td>
                      <h6 class="mb-1"><%= item.product.name %></h6>
                      <small class="text-muted">単位: <%= display_unit %></small>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-secondary">× <%= display_quantity %></span>
                    </td>
                    <td class="text-end">
                      ¥<%= number_with_delimiter(display_unit_price) %>
                    </td>
                    <td class="text-end">
                      <strong>¥<%= number_with_delimiter(item_subtotal) %></strong>
                    </td>
                    <td>
                      <% if delivery_type == 'clinic' && clinic_id.present? %>
                        <% clinic = Clinic.find_by(id: clinic_id) %>
                        <div class="small">
                          <i class="fas fa-hospital text-primary"></i>
                          <strong><%= clinic&.name || 'クリニック' %></strong>
                          <div class="text-muted" style="font-size: 0.85em;">
                            クリニック配送
                          </div>
                        </div>
                      <% elsif delivery_type == 'other' %>
                        <div class="small">
                          <i class="fas fa-map-marker-alt text-warning"></i>
                          <strong><%= item.other_recipient_name || 'その他お届け先' %></strong>
                          <% if item.other_postal_code.present? && item.other_address.present? %>
                            <div class="text-muted" style="font-size: 0.85em;">
                              〒<%= item.other_postal_code %><br>
                              <%= item.other_address %>
                              <% if item.other_phone_number.present? %>
                                <br>TEL: <%= item.other_phone_number %>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% else %>
                        <% 
                          selected_address = address_type == 'shipping' ? current_user.shipping_address : current_user.registration_address
                          address_label = address_type == 'shipping' ? '配送先住所' : '登録住所'
                        %>
                        <div class="small">
                          <i class="fas fa-home text-success"></i>
                          <strong><%= address_label %></strong>
                          <% if selected_address %>
                            <div class="text-muted" style="font-size: 0.85em;">
                              〒<%= selected_address.postal_code %><br>
                              <%= selected_address.address %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted">カートに商品がありません</p>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <!-- 配送先情報サマリー -->
      <% if delivery_destinations.any? %>
        <div class="card mb-3">
          <div class="card-header bg-info text-white">
            <h6 class="mb-0">
              <i class="fas fa-shipping-fast me-2"></i>
              配送先サマリー
            </h6>
          </div>
          <div class="card-body">
            <div class="alert alert-light mb-0">
              <small>
                <i class="fas fa-info-circle me-2"></i>
                <strong>配送先数:</strong> <%= delivery_destinations.size %>箇所<br>
                <% delivery_destinations.each_with_index do |dest, index| %>
                  <% case dest[:type] %>
                  <% when 'clinic' %>
                    <i class="fas fa-hospital text-primary me-1"></i>
                  <% when 'home' %>
                    <i class="fas fa-home text-success me-1"></i>
                  <% when 'other' %>
                    <i class="fas fa-map-marker-alt text-warning me-1"></i>
                  <% end %>
                  <%= dest[:title] %><br>
                <% end %>
              </small>
            </div>
          </div>
        </div>
      <% end %>

      <!-- 注文合計カード -->
      <div class="card">
        <div class="card-header">
          <h5>注文合計</h5>
        </div>
        <div class="card-body">
          <% 
            # 基本料金計算（ユーザーに応じた価格で計算）
            subtotal = @cart&.total_amount_for_user(current_user) || 0
            
            # 配送先数を計算
            delivery_count = delivery_destinations.size
            shipping_fee = delivery_count * 6000
            
            # 事務手数料（クリニック配送がある場合）
            admin_fee = has_stem_cell_product ? 10000 : 0
            
            # 合計金額
            total_amount = subtotal + shipping_fee + admin_fee
          %>
          
          <div class="d-flex justify-content-between mb-2">
            <span>商品代金:</span>
            <span>¥<%= number_with_delimiter(subtotal) %></span>
          </div>
          <!-- 配送先ごとに送料を表示 -->
          <% delivery_destinations.each_with_index do |dest, index| %>
            <div class="d-flex justify-content-between mb-2">
              <span>
                <% case dest[:type] %>
                <% when 'clinic' %>
                  送料（クリニック配送）:
                <% when 'home' %>
                  送料（登録住所）:
                <% when 'other' %>
                  送料（その他お届け先）:
                <% end %>
              </span>
              <span>¥6,000</span>
            </div>
          <% end %>
          <% if admin_fee > 0 %>
            <div class="d-flex justify-content-between mb-2">
              <span>事務手数料:</span>
              <span class="text-warning">¥<%= number_with_delimiter(admin_fee) %></span>
            </div>
          <% end %>
          <% 
            # 税抜き合計（商品代金+送料+事務手数料）
            subtotal_before_tax = subtotal + shipping_fee + admin_fee
            # 消費税計算
            tax_amount = calculate_tax(subtotal_before_tax)
            # 税込み合計
            total_amount_with_tax = subtotal_before_tax + tax_amount
          %>
          <div class="d-flex justify-content-between mb-2">
            <span>小計（税抜）:</span>
            <span>¥<%= number_with_delimiter(subtotal_before_tax) %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>消費税（<%= tax_rate_percentage %>%）:</span>
            <span>¥<%= number_with_delimiter(tax_amount) %></span>
          </div>
          <hr>
          <div class="d-flex justify-content-between mb-3">
            <strong>合計:</strong>
            <strong class="text-success">¥<%= number_with_delimiter(total_amount_with_tax) %></strong>
          </div>
          
          <!-- 料金説明 -->
          <div class="alert alert-light small">
            <i class="fas fa-info-circle me-2"></i>
            <strong>料金について:</strong>
            <ul class="mb-0 mt-2">
              <li>送料: 配送先1箇所につき ¥6,000（合計<%= delivery_count %>箇所 = ¥<%= number_with_delimiter(shipping_fee) %>）</li>
              <% if admin_fee > 0 %>
                <li class="text-warning">事務手数料: クリニック配送 ¥10,000</li>
              <% end %>
            </ul>
          </div>
          
          <div class="d-grid gap-2">
            <% if @cart_items_with_delivery.present? %>
              <% 
                # カートアイテムの配送先情報をパラメータとして渡す
                payment_params = {}
                @cart_items_with_delivery.each_with_index do |item_info, index|
                  item = item_info[:item]
                  payment_params["items[#{item.id}][delivery_type]"] = item_info[:delivery_type]
                  payment_params["items[#{item.id}][clinic_id]"] = item_info[:clinic_id] if item_info[:clinic_id].present?
                  payment_params["items[#{item.id}][address_type]"] = item_info[:address_type]
                  
                  # その他配送の場合の追加情報
                  if item_info[:delivery_type] == 'other'
                    payment_params["items[#{item.id}][other_recipient_name]"] = item.other_recipient_name
                    payment_params["items[#{item.id}][other_postal_code]"] = item.other_postal_code
                    payment_params["items[#{item.id}][other_address]"] = item.other_address
                    payment_params["items[#{item.id}][other_phone_number]"] = item.other_phone_number
                  end
                end
              %>
              <%= link_to "お支払い方法を選択する", select_method_payments_path(payment_params), 
                  class: "btn btn-success btn-lg" %>
            <% else %>
              <%= link_to "カートに戻って配送先を選択", cart_path, class: "btn btn-warning btn-lg" %>
            <% end %>
            <%= link_to "カートに戻る", cart_path, class: "btn btn-outline-secondary" %>
            <%= link_to "商品一覧に戻る", orders_products_path, class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
