<%
  # 会社情報を変数として定義
  company_name = "株式会社アジアビジネストラスト"
  company_department = "アジアビジネストラスト事業部"
  company_address = "〒104-0061 東京都中央区銀座4丁目6-1"
  company_building = "銀座医科ビル3階"
  company_tel = "TEL:03-5904-8148"
  company_email = "Email: abt1@asia-b-t.com"
  company_footer = "アジアビジネストラスト 事務局"
  registration_number = "T4210001009156"
  
  # 銀行情報を変数として定義
  bank_name = "楽天銀行"
  bank_branch = "第二営業支店"
  bank_branch_code = "252"
  bank_account_type = "普通預金"
  bank_account_number = "7747552"
  bank_account_name = company_name
  
  # 税計算（内税）
  total_with_tax = @purchase_invoice.total_amount
  subtotal = (total_with_tax / 1.1).to_i
  tax = total_with_tax - subtotal
%>

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body {
      font-family: 'MS Gothic', 'Hiragino Sans', sans-serif;
      font-size: 12px;
      line-height: 1.4;
      margin: 0;
      padding: 40px;
      color: #000;
    }
    
    .invoice-title {
      text-align: center;
      font-size: 24px;
      font-weight: bold;
      margin: 0 0 40px 0;
      letter-spacing: 3px;
    }
    
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 30px;
    }
    
    .invoice-info {
      flex: 1;
    }
    
    .invoice-info p {
      margin: 5px 0;
      font-size: 12px;
    }
    
    .customer-name {
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 20px;
    }
    
    .company-info {
      text-align: right;
      flex: 1;
      font-size: 11px;
      line-height: 1.4;
    }
    
    .company-info h3 {
      font-size: 12px;
      font-weight: bold;
      margin: 0 0 5px 0;
    }
    
    .company-info p {
      margin: 2px 0;
    }
    
    .subject {
      margin: 20px 0;
      font-size: 14px;
    }
    
    .subject-label {
      font-weight: bold;
      display: inline-block;
      width: 60px;
    }
    
    .amount-section {
      text-align: center;
      margin: 30px 0;
      padding: 20px;
      border: 2px solid #000;
      background-color: #f8f8f8;
    }
    
    .amount-label {
      font-size: 14px;
      font-weight: bold;
      margin-bottom: 10px;
    }
    
    .amount-value {
      font-size: 24px;
      font-weight: bold;
      color: #000;
    }
    
    .section-title {
      font-size: 14px;
      font-weight: bold;
      margin: 20px 0 10px 0;
      padding-bottom: 5px;
      border-bottom: 1px solid #000;
    }
    
    .details-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }
    
    .details-table th,
    .details-table td {
      border: 1px solid #000;
      padding: 8px;
      text-align: center;
      font-size: 12px;
    }
    
    .details-table th {
      background-color: #f8f8f8;
      font-weight: bold;
    }
    
    .details-table .item-name {
      text-align: left;
      width: 300px;
    }
    
    .details-table .quantity {
      width: 80px;
    }
    
    .details-table .price {
      width: 100px;
      text-align: right;
    }
    
    .total-row {
      background-color: #f0f0f0;
      font-weight: bold;
    }
    
    .tax-summary {
      width: 300px;
      margin-left: auto;
      border-collapse: collapse;
      margin-top: 10px;
    }
    
    .tax-summary td {
      border: 1px solid #000;
      padding: 6px;
      text-align: right;
      font-size: 12px;
    }
    
    .bank-info {
      margin: 30px 0;
    }
    
    .bank-info table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .bank-info td {
      padding: 8px;
      border: 1px solid #000;
      font-size: 12px;
    }
    
    .bank-info td:first-child {
      background-color: #f8f8f8;
      font-weight: bold;
      width: 120px;
      text-align: center;
    }
    
    .notes {
      margin: 30px 0;
    }
    
    .notes table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .notes td {
      padding: 8px;
      border: 1px solid #000;
      font-size: 12px;
      vertical-align: top;
    }
    
    .notes td:first-child {
      background-color: #f8f8f8;
      font-weight: bold;
      width: 60px;
    }
    
    .page-number {
      text-align: center;
      margin-top: 30px;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <!-- 請求書タイトル -->
  <h1 class="invoice-title">請求書</h1>

  <!-- ヘッダー情報 -->
  <div class="header">
    <div class="invoice-info">
      <div class="customer-name"><%= @purchase_invoice.buyer.name %> 様</div>
      <p><strong>請求書番号:</strong> <%= @purchase_invoice.invoice_number %></p>
      <p><strong>発行日:</strong> <%= @purchase_invoice.invoice_date.strftime('%Y年%m月%d日') %></p>
      <p><strong>支払期限:</strong> <%= @purchase_invoice.due_date.strftime('%Y年%m月%d日') %></p>
      <p><strong>登録番号:</strong> <%= registration_number %></p>
    </div>
    
    <div class="company-info">
      <h3><%= company_name %></h3>
      <p><%= company_department %></p>
      <p><%= company_address %></p>
      <p><%= company_building %></p>
      <p><%= company_tel %></p>
      <p><%= company_email %></p>
      <p><%= company_footer %></p>
    </div>
  </div>

  <!-- 件名 -->
  <div class="subject">
    <span class="subject-label"><strong>件名</strong></span>
    <span>幹細胞商品代</span>
  </div>

  <!-- 請求金額 -->
  <div class="amount-section">
    <div class="amount-label">請求金額</div>
    <div class="amount-value">¥<%= number_with_delimiter(total_with_tax) %></div>
  </div>

  <!-- 商品明細 -->
  <div class="section-title">商品明細</div>
  <table class="details-table">
    <thead>
      <tr>
        <th class="item-name">摘要</th>
        <th class="quantity">数量</th>
        <th class="price">単価</th>
        <th class="price">明細金額</th>
      </tr>
    </thead>
    <tbody>
      <% @purchase_invoice.purchase_items.each do |item| %>
      <tr>
        <td class="item-name"><%= item.product.name %></td>
        <td class="quantity"><%= item.quantity %></td>
        <td class="price">¥<%= number_with_delimiter(item.unit_price) %></td>
        <td class="price">¥<%= number_with_delimiter(item.total_price) %></td>
      </tr>
      <% end %>
      
      <!-- 空行を追加（最大10行まで） -->
      <% (10 - @purchase_invoice.purchase_items.count).times do %>
      <tr>
        <td class="item-name">&nbsp;</td>
        <td class="quantity">&nbsp;</td>
        <td class="price">&nbsp;</td>
        <td class="price">&nbsp;</td>
      </tr>
      <% end %>
      
      <tr class="total-row">
        <td colspan="3"><strong>小計（税抜）</strong></td>
        <td class="price"><strong>¥<%= number_with_delimiter(subtotal) %></strong></td>
      </tr>
      <tr class="total-row">
        <td colspan="3"><strong>消費税（10%）</strong></td>
        <td class="price"><strong>¥<%= number_with_delimiter(tax) %></strong></td>
      </tr>
      <tr class="total-row">
        <td colspan="3"><strong>合計</strong></td>
        <td class="price"><strong>¥<%= number_with_delimiter(total_with_tax) %></strong></td>
      </tr>
    </tbody>
  </table>

  <!-- 振込先情報 -->
  <div class="bank-info">
    <div class="section-title">お振込先</div>
    <table>
      <tr>
        <td>銀行名</td>
        <td><%= bank_name %></td>
      </tr>
      <tr>
        <td>支店名</td>
        <td><%= bank_branch %></td>
      </tr>
      <tr>
        <td>支店番号</td>
        <td><%= bank_branch_code %></td>
      </tr>
      <tr>
        <td>口座種別</td>
        <td><%= bank_account_type %></td>
      </tr>
      <tr>
        <td>口座番号</td>
        <td><%= bank_account_number %></td>
      </tr>
      <tr>
        <td>口座名義</td>
        <td><%= bank_account_name %></td>
      </tr>
    </table>
  </div>

  <!-- 備考 -->
  <div class="notes">
    <table>
      <tr>
        <td>備考</td>
        <td>振込手数料はお客様負担にて、期日までのお振込をお願いいたします。</td>
      </tr>
    </table>
  </div>

  <!-- ページ番号 -->
  <div class="page-number">1 / 1</div>
</body>
</html>