<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4" style="margin-top: 80px;">
        <h3 class="text-primary">購入情報作成</h3>
        <div>
          <%= link_to "購入履歴一覧に戻る", admin_purchases_path, class: "btn btn-outline-secondary me-2" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">新しい購入情報の入力</h5>
        </div>
        <div class="card-body">
          <%= form_with model: [:admin, @purchase], local: true, class: "needs-validation", novalidate: true do |form| %>
            <% if @purchase.errors.any? %>
              <div class="alert alert-danger">
                <h6>エラーが発生しました:</h6>
                <ul class="mb-0">
                  <% @purchase.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- 購入者選択 -->
            <div class="row mb-3">
              <div class="col-md-12">
                <div class="mb-3">
                  <%= form.label :user_id, "購入者（#{@buyers_count}）", class: "form-label" %>
                  
                  <!-- 購入者検索欄 -->
                  <div class="mb-2">
                    <input type="text" 
                           id="user_search" 
                           class="form-control" 
                           placeholder="購入者名で検索..." 
                           autocomplete="off">
                    <div class="form-text">
                      <small class="text-muted">名前またはメールアドレスで検索できます</small>
                    </div>
                  </div>
                  
                  <%= form.select :user_id, 
                      options_from_collection_for_select(@buyers, :id, :display_name, @purchase.user_id),
                      { prompt: "購入者を選択してください" },
                      { class: "form-select", required: true, id: "user_select" } %>
                  <div class="invalid-feedback">
                    購入者を選択してください。
                  </div>
                  <div class="form-text">
                    <small class="text-muted">
                      ※ 購入者が販売店レベル（総代理店、代理店、アドバイザー、クリニック、サロン）の場合は自己購入、お客様の場合は紹介者が販売店となります
                    </small>
                  </div>
                </div>
              </div>
            </div>

            <!-- 商品選択 -->
            <div class="row mb-3">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :product_id, "商品", class: "form-label" %>
                  <%= form.select :product_id, 
                      options_from_collection_for_select(@products, :id, :name),
                      { prompt: "商品を選択してください" },
                      { class: "form-select", required: true, id: "product_select" } %>
                  <div class="invalid-feedback">
                    商品を選択してください。
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :purchased_at, "購入日時", class: "form-label" %>
                  <%= form.datetime_local_field :purchased_at, 
                      class: "form-control", 
                      required: true,
                      value: @purchase.purchased_at&.strftime('%Y-%m-%dT%H:%M') || Time.current.strftime('%Y-%m-%dT%H:%M') %>
                  <div class="invalid-feedback">
                    購入日時を入力してください。
                  </div>
                </div>
              </div>
            </div>

            <!-- 数量・単価 -->
            <div class="row mb-3">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :quantity, "数量", class: "form-label" %>
                  <%= form.number_field :quantity, 
                      class: "form-control form-control-lg", 
                      min: 1, 
                      required: true,
                      id: "quantity_input",
                      placeholder: "数量を入力" %>
                  <div class="invalid-feedback">
                    数量は1以上で入力してください。
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :unit_price, "単価", class: "form-label" %>
                  <div class="input-group">
                    <span class="input-group-text">¥</span>
                    <%= form.number_field :unit_price, 
                        class: "form-control form-control-lg", 
                        min: 0, 
                        required: true,
                        id: "unit_price_input",
                        placeholder: "単価を入力" %>
                  </div>
                  <div class="invalid-feedback">
                    単価は0以上で入力してください。
                  </div>
                </div>
              </div>
            </div>

            <!-- 計算結果表示 -->
            <div class="row mb-4">
              <div class="col-12">
                <div class="card border-success">
                  <div class="card-body text-center">
                    <h6 class="card-title text-muted">合計金額</h6>
                    <h3 class="text-success mb-0" id="total_amount">¥0</h3>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <%= link_to "キャンセル", admin_purchases_path, class: "btn btn-secondary me-md-2" %>
              <%= form.submit "作成する", class: "btn btn-success me-md-2" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // リアルタイム計算
  function updateTotal() {
    const quantity = document.getElementById('quantity_input').value || 0;
    const unitPrice = document.getElementById('unit_price_input').value || 0;
    const total = quantity * unitPrice;
    
    document.getElementById('total_amount').textContent = 
      '¥' + total.toLocaleString();
  }

  // 購入者のレベルに応じた商品価格を取得
  function loadUserLevelPrice() {
    const userSelect = document.getElementById('user_select');
    const productSelect = document.getElementById('product_select');
    const unitPriceInput = document.getElementById('unit_price_input');
    
    if (!userSelect.value || !productSelect.value) {
      unitPriceInput.value = '';
      updateTotal();
      return;
    }
    
    // 購入者のレベルに応じた価格情報を取得
    fetch(`/admin/purchases/get_user_level_price?user_id=${userSelect.value}&product_id=${productSelect.value}`)
      .then(response => response.json())
      .then(data => {
        if (data.error) {
          console.error('価格情報の取得エラー:', data.error);
          unitPriceInput.value = 0;
        } else {
          unitPriceInput.value = data.price || 0;
          console.log(`${data.user_name}（${data.level_name}）の価格: ¥${data.price}`);
        }
        updateTotal();
      })
      .catch(error => {
        console.error('価格情報の取得に失敗しました:', error);
        unitPriceInput.value = 0;
        updateTotal();
      });
  }

  // 商品選択時に単価を自動入力（購入者も選択されている場合はレベル価格を取得）
  function loadProductPrice() {
    const userSelect = document.getElementById('user_select');
    const productSelect = document.getElementById('product_select');
    const unitPriceInput = document.getElementById('unit_price_input');
    
    if (!productSelect.value) {
      unitPriceInput.value = '';
      updateTotal();
      return;
    }
    
    // 購入者が選択されている場合はレベル価格を取得
    if (userSelect.value) {
      loadUserLevelPrice();
    } else {
      // 購入者が未選択の場合は基本価格を取得
      fetch(`/admin/products/${productSelect.value}/price_info`)
        .then(response => response.json())
        .then(data => {
          unitPriceInput.value = data.base_price || 0;
          updateTotal();
        })
        .catch(error => {
          console.error('価格情報の取得に失敗しました:', error);
        });
    }
  }

  // 購入者検索機能
  let allUsers = [];
  
  function initializeUserSearch() {
    const userSelect = document.getElementById('user_select');
    const userSearch = document.getElementById('user_search');
    
    if (!userSelect || !userSearch) return;
    
    // 全ユーザーのオプションを保存
    allUsers = Array.from(userSelect.options).slice(1); // 最初のpromptオプションを除く
    
    // 検索機能
    userSearch.addEventListener('input', function() {
      const searchTerm = this.value.toLowerCase().trim();
      
      // selectをクリア（promptオプションは残す）
      userSelect.innerHTML = '<option value="">購入者を選択してください</option>';
      
      if (searchTerm === '') {
        // 検索欄が空の場合は全ユーザーを表示
        allUsers.forEach(option => {
          userSelect.appendChild(option.cloneNode(true));
        });
      } else {
        // 検索条件に一致するユーザーのみ表示
        const filteredUsers = allUsers.filter(option => {
          const text = option.textContent.toLowerCase();
          return text.includes(searchTerm);
        });
        
        filteredUsers.forEach(option => {
          userSelect.appendChild(option.cloneNode(true));
        });
        
        // 検索結果が1件の場合は自動選択
        if (filteredUsers.length === 1) {
          userSelect.value = filteredUsers[0].value;
          // 価格を更新
          loadUserLevelPrice();
        }
      }
    });
    
    // Enterキーでの送信を防ぐ
    userSearch.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
      }
    });
  }

  // 入力フィールドにイベントリスナーを追加
  document.addEventListener('DOMContentLoaded', function() {
    const quantityInput = document.getElementById('quantity_input');
    const unitPriceInput = document.getElementById('unit_price_input');
    const productSelect = document.getElementById('product_select');
    
    if (quantityInput && unitPriceInput) {
      quantityInput.addEventListener('input', updateTotal);
      unitPriceInput.addEventListener('input', updateTotal);
    }
    
    // 商品選択時に価格を自動入力
    if (productSelect) {
      productSelect.addEventListener('change', loadProductPrice);
    }
    
    // 購入者選択時に価格を更新
    const userSelect = document.getElementById('user_select');
    if (userSelect) {
      userSelect.addEventListener('change', loadUserLevelPrice);
    }
    
    // 購入者検索機能を初期化
    initializeUserSearch();
    
    // Bootstrap validation
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      });
    });
  });
</script>

