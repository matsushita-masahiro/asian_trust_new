<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">
            <i class="fas fa-credit-card me-2"></i>
            お支払い方法を選択してください
          </h4>
        </div>
        <div class="card-body">
          <!-- 注文内容詳細 -->
          <div class="card mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">
                <i class="fas fa-shopping-cart me-2"></i>
                ご注文内容
              </h6>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-sm mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>商品名</th>
                      <th class="text-center">数量</th>
                      <th class="text-end">単価</th>
                      <th class="text-end">小計</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @cart.cart_items.each do |item| %>
                      <tr>
                        <td>
                          <div class="fw-bold"><%= item.product.name %></div>
                          <small class="text-muted">単位: <%= item.product.display_unit %></small>
                        </td>
                        <td class="text-center">
                          <span class="badge bg-secondary"><%= item.quantity %></span>
                        </td>
                        <td class="text-end">
                          <% 
                            if item.product.respond_to?(:category) && item.product.category == 'wott' && current_user.has_wott_level?
                              unit_price = item.product.wott_price_for(current_user.wott_level_symbol) || 0
                            else
                              unit_price = item.product.price_for(current_user.level_symbol) || 0
                            end
                          %>
                          ¥<%= number_with_delimiter(unit_price) %>
                        </td>
                        <td class="text-end fw-bold">
                          ¥<%= number_with_delimiter(item.subtotal(current_user.level_symbol, current_user)) %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                  <tfoot class="table-light">
                    <% 
                      # 料金計算
                      subtotal = @cart.total_amount_for_user(current_user)
                      
                      # 商品別配送先判定
                      stem_cell_items = @cart.cart_items.select { |item| item.product.name.include?('骨髄幹細胞培培養上清液') }
                      other_items = @cart.cart_items.select { |item| !item.product.name.include?('骨髄幹細胞培培養上清液') }
                      
                      has_stem_cell_product = stem_cell_items.any?
                      has_other_products = other_items.any?
                      
                      # 配送先数を計算
                      delivery_destinations = 0
                      delivery_destinations += 1 if has_stem_cell_product  # クリニック配送
                      delivery_destinations += 1 if has_other_products     # 自宅配送
                      
                      shipping_fee = delivery_destinations * 6000
                      
                      # 事務手数料（クリニック配送の場合）
                      admin_fee = has_stem_cell_product ? 10000 : 0
                      
                      # 合計金額
                      total_amount = subtotal + shipping_fee + admin_fee
                    %>
                    
                    <tr>
                      <th colspan="3" class="text-end">商品代金計:</th>
                      <th class="text-end">¥<%= number_with_delimiter(subtotal) %></th>
                    </tr>
                    <% if has_stem_cell_product && has_other_products %>
                      <!-- 複数配送先の場合：送料を2行で表示 -->
                      <tr>
                        <th colspan="3" class="text-end">送料:</th>
                        <th class="text-end">¥6,000</th>
                      </tr>
                      <tr>
                        <th colspan="3" class="text-end">送料（骨髄別送）:</th>
                        <th class="text-end">¥6,000</th>
                      </tr>
                    <% else %>
                      <!-- 単一配送先の場合：従来通り -->
                      <tr>
                        <th colspan="3" class="text-end">送料 (<%= delivery_destinations %>箇所):</th>
                        <th class="text-end">¥<%= number_with_delimiter(shipping_fee) %></th>
                      </tr>
                    <% end %>
                    <% if admin_fee > 0 %>
                      <tr>
                        <th colspan="3" class="text-end">事務手数料:</th>
                        <th class="text-end text-warning">¥<%= number_with_delimiter(admin_fee) %></th>
                      </tr>
                    <% end %>
                    <% 
                      # 税抜き合計（商品代金+送料+事務手数料）
                      subtotal_before_tax = subtotal + shipping_fee + admin_fee
                      # 消費税計算
                      tax_amount = calculate_tax(subtotal_before_tax)
                      # 税込み合計
                      total_amount_with_tax = subtotal_before_tax + tax_amount
                    %>
                    <tr>
                      <th colspan="3" class="text-end">小計（税抜）:</th>
                      <th class="text-end">¥<%= number_with_delimiter(subtotal_before_tax) %></th>
                    </tr>
                    <tr>
                      <th colspan="3" class="text-end">消費税（<%= tax_rate_percentage %>%）:</th>
                      <th class="text-end">¥<%= number_with_delimiter(tax_amount) %></th>
                    </tr>
                    <tr class="table-success">
                      <th colspan="3" class="text-end fs-5">合計金額:</th>
                      <th class="text-end text-success fs-5">
                        ¥<%= number_with_delimiter(total_amount_with_tax) %>
                      </th>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
          </div>

          <!-- 料金説明 -->
          <div class="alert alert-info mb-4">
            <i class="fas fa-info-circle me-2"></i>
            <strong>料金について:</strong>
            <ul class="mb-0 mt-2">
              <% if has_stem_cell_product && has_other_products %>
                <li>送料: ご登録住所への配送 ¥6,000</li>
                <li>送料（骨髄別送）: クリニックへの配送 ¥6,000</li>
                <li class="text-warning">事務手数料: クリニック配送 ¥10,000</li>
                <li class="text-info">複数配送先: 骨髄幹細胞培培養上清液はクリニック、その他商品はご登録住所へ配送</li>
            </ul>
            
            <div class="mt-3 p-3 bg-light border-start border-4 border-warning">
              <h6 class="text-warning mb-2">
                <i class="fas fa-exclamation-triangle me-2"></i>
                お支払いについて
              </h6>
              <p class="mb-2">下記の通り2回にわけてお願いしております。</p>
              <div class="mb-2">
                <strong>①幹細胞商品代等</strong><br>
                ⇒添付の請求書にて期限内にお支払いお願いします。
              </div>
              <div class="mb-2">
                <strong>②病院使用料等　22,000円税込</strong><br>
                （※施術方法が複数箇所の場合はそれぞれ費用がかかります。腰を選択の場合、別途整形外科診察料が必要です。）<br>
                ⇒当日、現金にて直接クリニックへお願いします。
              </div>
              <p class="mb-0 text-danger">
                <small>
                  <i class="fas fa-info-circle me-1"></i>
                  また、入金確認後メーカーに発注いたしますので、メーカー発送後のキャンセルはお受けいたしかねますのでご了承くださいませ。
                </small>
              </p>
            </div>
            
            <ul class="mb-0 mt-2" style="display: none;">
              <% elsif has_stem_cell_product %>
                <li>送料（骨髄別送）: クリニックへの配送 ¥6,000</li>
                <li class="text-warning">事務手数料: クリニック配送 ¥10,000</li>
              <% else %>
                <li>送料: 配送先1箇所につき ¥6,000</li>
              <% end %>
            </ul>
          </div>

          <!-- 支払い方法選択 -->
          <div class="row g-4">
            <!-- 銀行振込 -->
            <div class="col-md-6">
              <div class="card h-100 border-2 payment-option" style="cursor: pointer;">
                <div class="card-body text-center p-4">
                  <div class="mb-3">
                    <i class="fas fa-university fa-3x text-primary"></i>
                  </div>
                  <h5 class="card-title">銀行振込</h5>
                  <p class="card-text text-muted">
                  請求書を（振込先口座情報）登録されている<br>
                  メールアドレスにお送りします。
                  </p>
                  <ul class="list-unstyled text-start small">
                    <li><i class="fas fa-check text-success me-2"></i>振込手数料はお客様負担</li>
                    <li><i class="fas fa-check text-success me-2"></i>入金確認まで1-2営業日</li>
                    <li><i class="fas fa-check text-success me-2"></i>法人・個人どちらでも可</li>
                  </ul>
                  <%= form_with url: bank_transfer_payments_path, method: :post, local: true, class: "mt-3" do |f| %>
                    <%= f.hidden_field :delivery_type, value: params[:delivery_type] %>
                    <%= f.hidden_field :address_type, value: params[:address_type] %>
                    <%= f.hidden_field :clinic_id, value: params[:clinic_id] %>
                    <%= f.hidden_field :delivery_notes, value: params[:delivery_notes] %>
                    <%= f.submit "銀行振込で注文する", class: "btn btn-primary btn-lg w-100", 
                        confirm: "銀行振込で注文を確定しますか？" %>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- クレジットカード -->
            <div class="col-md-6">
              <div class="card h-100 border-2 payment-option-disabled">
                <div class="card-body text-center p-4">
                  <div class="mb-3">
                    <i class="fas fa-credit-card fa-3x text-muted"></i>
                  </div>
                  <h5 class="card-title text-muted">クレジットカード</h5>
                  <p class="card-text text-muted">
                    VISA、MasterCard、JCB等<br>
                    主要カードブランドに対応予定です。
                  </p>
                  <ul class="list-unstyled text-start small text-muted">
                    <li><i class="fas fa-clock text-warning me-2"></i>即座に決済完了（予定）</li>
                    <li><i class="fas fa-clock text-warning me-2"></i>分割払い・リボ払い対応（予定）</li>
                    <li><i class="fas fa-clock text-warning me-2"></i>SSL暗号化で安全（予定）</li>
                  </ul>
                  <div class="mt-3">
                    <button type="button" class="btn btn-secondary btn-lg w-100" disabled>
                      クレジットカード支払開始予定
                    </button>
                    <small class="text-muted d-block mt-2">
                      <i class="fas fa-info-circle me-1"></i>
                      現在準備中です。しばらくお待ちください。
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 戻るボタン -->
          <div class="text-center mt-4">
            <%= link_to "注文内容を確認する", checkout_orders_path, class: "btn btn-outline-secondary me-2" %>
            <%= link_to "カートに戻る", cart_path, class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

