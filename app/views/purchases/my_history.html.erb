<div class="container-fluid mt-5">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-primary">🛒 購入履歴</h4>
        <div class="d-flex align-items-center">
          <!-- 月選択フォーム -->
          <%= form_with url: my_history_purchases_path, method: :get, local: true, class: "d-flex align-items-center me-3" do |f| %>
            <label class="form-label me-2 mb-0">対象月:</label>
            <%= f.month_field :month, value: @selected_month, class: "form-control", style: "width: 180px;", onchange: "this.form.submit();" %>
          <% end %>
          
          <%= link_to "マイページに戻る", mysales_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  </div>

  <!-- 購入履歴一覧 -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0"><%= @selected_month_name %>の購入履歴</h5>
        </div>
        <div class="card-body">
          <% if @purchases.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead class="table-light">
                  <tr>
                    <th>購入日</th>
                    <th>商品情報</th>
                    <th>数量</th>
                    <th>合計金額</th>
                    <th>状況</th>
                    <th>クリニック予約</th>
                    <th>詳細</th>
                  </tr>
                </thead>
                <tbody>
                  <% @purchases.each do |purchase| %>
                    <tr>
                      <td>
                        <div class="fw-bold"><%= purchase.purchased_at.strftime("%Y/%m/%d") %></div>
                        <small class="text-muted"><%= purchase.purchased_at.strftime("%H:%M") %></small>
                      </td>
                      <td>
                        <% if purchase.purchase_items.count == 1 %>
                          <!-- 単一商品の場合 -->
                          <% item = purchase.purchase_items.first %>
                          <div class="fw-bold"><%= item.product.name %></div>
                          <small class="text-muted">単価: ¥<%= number_with_delimiter(item.seller_price) %></small>
                        <% else %>
                          <!-- 複数商品の場合 -->
                          <div class="fw-bold">複数商品 (<%= purchase.purchase_items.count %>種類)</div>
                          <small class="text-muted">
                            <% purchase.purchase_items.limit(2).each do |item| %>
                              <%= item.product.name %><br>
                            <% end %>
                            <% if purchase.purchase_items.count > 2 %>
                              他<%= purchase.purchase_items.count - 2 %>商品...
                            <% end %>
                          </small>
                        <% end %>
                      </td>
                      <td>
                        <span class="badge bg-secondary fs-6">
                          <%= purchase.purchase_items.sum(:quantity) %>個
                        </span>
                      </td>
                      <td>
                        <% 
                          # purchase_invoiceがある場合は税込み金額を使用
                          if purchase.purchase_invoice&.total_with_tax.present? && purchase.purchase_invoice.total_with_tax > 0
                            total_amount = purchase.purchase_invoice.total_with_tax
                            product_amount = purchase.purchase_invoice.total_amount
                            shipping_fee = purchase.purchase_invoice.shipping_fee
                            admin_fee = purchase.purchase_invoice.admin_fee
                            tax_amount = purchase.purchase_invoice.tax_amount
                          else
                            # 従来の計算方法（税抜き）
                            product_amount = purchase.total_price
                            shipping_fee = purchase.total_shipping_fees
                            admin_fee = purchase.purchase_invoice&.admin_fee || 0
                            subtotal_before_tax = product_amount + shipping_fee + admin_fee
                            tax_amount = calculate_tax(subtotal_before_tax)
                            total_amount = subtotal_before_tax + tax_amount
                          end
                        %>
                        <div class="fw-bold text-success">¥<%= number_with_delimiter(total_amount) %></div>
                        <% if shipping_fee > 0 || admin_fee > 0 || tax_amount > 0 %>
                          <small class="text-muted">
                            商品: ¥<%= number_with_delimiter(product_amount) %>
                            <% if shipping_fee > 0 %>
                              + 送料: ¥<%= number_with_delimiter(shipping_fee) %>
                            <% end %>
                            <% if admin_fee > 0 %>
                              + 手数料: ¥<%= number_with_delimiter(admin_fee) %>
                            <% end %>
                            <% if tax_amount > 0 %>
                              + 税: ¥<%= number_with_delimiter(tax_amount) %>
                            <% end %>
                          </small>
                        <% end %>
                      </td>
                      <td>
                        <% if purchase.purchase_invoice.present? %>
                          <div class="d-flex flex-column align-items-start gap-1">
                            <% if purchase.purchase_invoice.status == 3 %>
                              <%= link_to "領収書発行依頼", request_receipt_purchase_invoice_path(purchase.purchase_invoice), 
                                  method: :patch,
                                  class: "btn btn-xs btn-success", 
                                  style: "font-size: 0.7rem; padding: 2px 6px;",
                                  confirm: "領収書の発行を依頼しますか？" %>
                            <% elsif purchase.purchase_invoice.status == 4 %>
                              <span class="btn btn-xs btn-secondary disabled" style="font-size: 0.7rem; padding: 2px 6px;">
                                領収書発行依頼済み
                              </span>
                            <% elsif purchase.purchase_invoice.status == 5 %>
                              <span class="badge bg-success" style="font-size: 0.7rem;">
                                領収書発行済み
                              </span>
                            <% else %>
                              <span class="badge bg-info" style="font-size: 0.7rem;">
                                <%= purchase.purchase_invoice.status_display_name %>
                              </span>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="badge bg-secondary">請求書未作成</span>
                        <% end %>
                      </td>
                      <td>
                        <% if purchase.purchase_invoice.present? %>
                          <% case purchase.purchase_invoice.clinic_reservation_status %>
                          <% when :not_required %>
                            <span class="badge bg-secondary">予約不要</span>
                          <% when :payment_required %>
                            <span class="badge bg-warning">入金後予約可能</span>
                          <% when :reserved %>
                            <span class="badge bg-success">予約済み</span>
                            <div class="mt-1">
                              <%= link_to "予約詳細", clinic_reservation_path(purchase.clinic_reservation), 
                                  class: "btn btn-xs btn-outline-info", style: "font-size: 0.7rem; padding: 2px 6px;" %>
                            </div>
                          <% when :not_reserved %>
                            <%= link_to "クリニック予約", new_purchase_clinic_reservation_path(purchase), 
                                class: "btn btn-xs btn-primary", style: "font-size: 0.7rem; padding: 2px 6px;" %>
                          <% end %>
                        <% else %>
                          <span class="badge bg-secondary">請求書未作成</span>
                        <% end %>
                      </td>
                      <td>
                        <% if purchase.purchase_invoice.present? %>
                          <%= link_to "請求書・予約", purchase_invoice_path(purchase.purchase_invoice), class: "btn btn-sm btn-outline-primary" %>
                        <% else %>
                          <%= link_to "詳細を見る", purchase_path(purchase), class: "btn btn-sm btn-outline-secondary" %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
              <h5 class="text-muted">購入履歴がありません</h5>
              <p class="text-muted"><%= @selected_month_name %>には購入がありませんでした。</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>