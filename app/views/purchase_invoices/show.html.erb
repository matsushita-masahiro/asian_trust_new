<div class="container mt-4">
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h4>購入請求書詳細</h4>
          <span class="badge bg-<%= @purchase_invoice.status == 0 ? 'secondary' : @purchase_invoice.status == 1 ? 'warning' : @purchase_invoice.status == 2 ? 'success' : 'info' %> fs-6">
            <%= @purchase_invoice.status_display_name %>
          </span>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-sm-3"><strong>請求書番号:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.invoice_number %></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>請求日:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.invoice_date.strftime("%Y年%m月%d日") %></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>支払期限:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.due_date.strftime("%Y年%m月%d日") %></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>購入者:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.purchase.user.name %></div>
          </div>
          <% if current_user.level&.value == 6 %>
            <div class="row mb-3">
              <div class="col-sm-3"><strong>販売者:</strong></div>
              <div class="col-sm-9">
                <% if current_user.referrer %>
                  <%= current_user.referrer.name %>
                <% else %>
                  <span class="text-muted">紹介者なし</span>
                <% end %>
              </div>
            </div>
          <% end %>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>購入日:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.purchased_at.strftime("%Y年%m月%d日") %></div>
          </div>
          
          <hr>
          
          <h5>購入明細</h5>
          <div class="table-responsive">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>商品名</th>
                  <th class="text-end">単価</th>
                  <th class="text-end">数量</th>
                  <th class="text-end">小計</th>
                </tr>
              </thead>
              <tbody>
                <% @purchase_invoice.purchase_items.each do |item| %>
                  <tr>
                    <td><%= item.product.name %></td>
                    <td class="text-end"><%= number_with_delimiter(item.unit_price.to_i) %>円</td>
                    <td class="text-end"><%= item.quantity %></td>
                    <td class="text-end"><%= number_with_delimiter(item.total_price.to_i) %>円</td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <% 
                  # DBから保存された値を取得（新しいレコードの場合）
                  if @purchase_invoice.total_with_tax.present? && @purchase_invoice.total_with_tax > 0
                    # DBに保存された値を使用
                    product_amount = @purchase_invoice.total_amount.to_i
                    shipping_fee = @purchase_invoice.shipping_fee.to_i
                    admin_fee = @purchase_invoice.admin_fee.to_i
                    tax_amount = @purchase_invoice.tax_amount.to_i
                    subtotal_before_tax = @purchase_invoice.subtotal_before_tax.to_i
                    total_with_tax = @purchase_invoice.total_with_tax.to_i
                    tax_rate_percent = (@purchase_invoice.tax_rate.to_f * 100).to_i
                    
                    # 配送先数を表示用に計算
                    delivery_destinations = 0
                    delivery_destinations += 1 if shipping_fee > 0 && admin_fee > 0  # クリニック配送
                    delivery_destinations += 1 if shipping_fee > 6000  # 複数配送先
                    delivery_destinations = 1 if delivery_destinations == 0 && shipping_fee > 0  # 単一配送先
                  else
                    # 既存レコード用：従来の計算方法
                    product_amount = @purchase_invoice.total_amount.to_i
                    
                    # 商品別配送先判定
                    purchase_items = @purchase_invoice.purchase.purchase_items
                    stem_cell_items = purchase_items.select { |item| item.product.name.include?('骨髄幹細胞培培養上清液') }
                    other_items = purchase_items.select { |item| !item.product.name.include?('骨髄幹細胞培培養上清液') }
                    
                    has_stem_cell_product = stem_cell_items.any?
                    has_other_products = other_items.any?
                    
                    # 配送先数を計算
                    delivery_destinations = 0
                    delivery_destinations += 1 if has_stem_cell_product  # クリニック配送
                    delivery_destinations += 1 if has_other_products     # 自宅配送
                    
                    shipping_fee = delivery_destinations * 6000
                    admin_fee = has_stem_cell_product ? 10000 : 0
                    subtotal_before_tax = product_amount + shipping_fee + admin_fee
                    tax_amount = calculate_tax(subtotal_before_tax)
                    total_with_tax = subtotal_before_tax + tax_amount
                    tax_rate_percent = tax_rate_percentage
                  end
                %>
                <tr>
                  <th colspan="3" class="text-end">商品代金:</th>
                  <th class="text-end"><%= number_with_delimiter(product_amount) %>円</th>
                </tr>
                <% if shipping_fee > 0 %>
                  <tr>
                    <th colspan="3" class="text-end">送料 (<%= delivery_destinations %>箇所):</th>
                    <th class="text-end"><%= number_with_delimiter(shipping_fee) %>円</th>
                  </tr>
                <% end %>
                <% if admin_fee > 0 %>
                  <tr>
                    <th colspan="3" class="text-end">事務手数料:</th>
                    <th class="text-end text-warning"><%= number_with_delimiter(admin_fee) %>円</th>
                  </tr>
                <% end %>
                <tr>
                  <th colspan="3" class="text-end">小計（税抜）:</th>
                  <th class="text-end"><%= number_with_delimiter(subtotal_before_tax) %>円</th>
                </tr>
                <tr>
                  <th colspan="3" class="text-end">消費税（<%= tax_rate_percent %>%）:</th>
                  <th class="text-end"><%= number_with_delimiter(tax_amount) %>円</th>
                </tr>
                <tr class="table-success">
                  <th colspan="3" class="text-end fs-5">合計金額:</th>
                  <th class="text-end fs-5"><%= number_with_delimiter(total_with_tax) %>円</th>
                </tr>
              </tfoot>
            </table>
          </div>
          
          <% if @purchase_invoice.notes.present? %>
            <hr>
            <h6>備考</h6>
            <p><%= simple_format(@purchase_invoice.notes) %></p>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5>操作</h5>
        </div>
        <div class="card-body">
          <% if current_user.level&.value == 0 %>
            <!-- 管理者用操作 -->
            <% if @purchase_invoice.draft? %>
              <%= link_to "請求書送付", send_invoice_purchase_invoice_path(@purchase_invoice), 
                  method: :patch, class: "btn btn-primary btn-sm mb-2 w-100",
                  confirm: "請求書を送付しますか？" %>
            <% end %>
            
            <% if @purchase_invoice.sent? %>
              <%= link_to "支払い確認", confirm_payment_purchase_invoice_path(@purchase_invoice), 
                  method: :patch, class: "btn btn-success btn-sm mb-2 w-100",
                  confirm: "支払いを確認しますか？" %>
            <% end %>
            
            <% if @purchase_invoice.receipt_requested? %>
              <%= link_to "領収書発行", send_receipt_purchase_invoice_path(@purchase_invoice), 
                  method: :patch, class: "btn btn-info btn-sm mb-2 w-100",
                  confirm: "領収書を発行しますか？" %>
            <% end %>
            
            <%= link_to "編集", edit_admin_purchase_invoice_path(@purchase_invoice), 
                class: "btn btn-outline-secondary btn-sm mb-2 w-100" %>
          <% else %>
            <!-- 一般ユーザー用操作 -->
            <% if @purchase_invoice.paid? && !@purchase_invoice.receipt_requested? %>
              <%= link_to "領収書発行依頼", request_receipt_purchase_invoice_path(@purchase_invoice), 
                  method: :patch, class: "btn btn-success btn-sm mb-2 w-100",
                  confirm: "領収書発行を依頼しますか？" %>
            <% end %>
          <% end %>
          
          <%= link_to "一覧に戻る", purchase_invoices_path, class: "btn btn-secondary btn-sm w-100" %>
        </div>
      </div>
      
      <div class="card mt-3">
        <div class="card-header">
          <h6>ステータス履歴</h6>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li><i class="fas fa-check text-success"></i> 作成済み</li>
            <% if @purchase_invoice.sent_at %>
              <li><i class="fas fa-check text-success"></i> 送付済み (<%= @purchase_invoice.sent_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
            <% if @purchase_invoice.confirmed_at %>
              <li><i class="fas fa-check text-success"></i> 支払い確認済み (<%= @purchase_invoice.confirmed_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
            <% if @purchase_invoice.receipt_requested_at %>
              <li><i class="fas fa-check text-success"></i> 領収書依頼済み (<%= @purchase_invoice.receipt_requested_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
            <% if @purchase_invoice.receipt_sent_at %>
              <li><i class="fas fa-check text-success"></i> 領収書発行済み (<%= @purchase_invoice.receipt_sent_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>