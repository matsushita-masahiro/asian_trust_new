<div class="container mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <h4 class="text-primary mb-4">
        <i class="fas fa-envelope me-2"></i>
        お問合せ履歴
      </h4>

      <% if @inquiries.any? %>
        <div class="list-group">
          <% @inquiries.each do |inquiry| %>
            <%= link_to inquiry_path(inquiry), class: "list-group-item list-group-item-action mb-2" do %>
              <div class="d-flex w-100 justify-content-between align-items-start">
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center mb-2">
                    <% if inquiry.answers.any? %>
                      <span class="badge bg-success me-2">回答済み</span>
                    <% else %>
                      <span class="badge bg-secondary me-2">未回答</span>
                    <% end %>
                    <h6 class="mb-0">
                      <%= truncate(inquiry.message, length: 50) %>
                    </h6>
                  </div>
                  <small class="text-muted">
                    <i class="fas fa-clock me-1"></i>
                    <%= inquiry.created_at.strftime('%Y年%m月%d日 %H:%M') %>
                  </small>
                </div>
                <div class="ms-3">
                  <i class="fas fa-chevron-right text-muted"></i>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-info text-center">
          <i class="fas fa-info-circle me-2"></i>
          お問合せ履歴はありません
        </div>
      <% end %>

      <div class="mt-4 text-center">
        <%= link_to "マイページに戻る", mypage_users_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>
