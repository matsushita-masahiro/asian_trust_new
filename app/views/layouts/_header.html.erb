<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
  <div class="container-fluid">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
      <%= image_tag "abt_logo.png", alt: "ABT Logo", class: "navbar-logo me-3" %>
      <%= ENV['COMPANY_NAME'] %>
    <% end %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <% unless current_user.admin? %>
            <li class="nav-item">
              <%= link_to "予約・注文", orders_path, class: "nav-link" %>
            </li>
          <% end %>
          <% if user_signed_in? && !current_user.admin %>
            <li class="nav-item">
              <%= link_to "請求書管理", invoices_path, class: "nav-link" %>
            </li>
          <% end %>
          <% if user_signed_in? && !current_user.admin? && current_user.bonus_eligible? %>
            <li class="nav-item">
              <%= link_to "インセンティブ", incentives_path, class: "nav-link" %>
            </li>
          <% end %>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="mypageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              マイページ
            </a>
            <ul class="dropdown-menu dropdown-menu-custom" aria-labelledby="mypageDropdown">
              <li><%= link_to "マイアカウント", user_path(current_user), class: "dropdown-item" %></li>
              <li>
                <% if current_user.level.value == 7 %>
                  <%= link_to "購入情報", mysales_path, class: "dropdown-item" %>
                <% else %>
                  <%= link_to "売上情報", mysales_path, class: "dropdown-item" %>
                <% end %>
              </li>
              <% if current_user&.level&.value && ![4, 5, 7].include?(current_user.level.value) %>
                <li><%= link_to "紹介機能", referrals_path, class: "dropdown-item" %></li>
              <% end %>
            </ul>
          </li>
          <li class="nav-item">
            <%= link_to "ログアウト", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "nav-link" %>
          </li>
          <% if current_user.admin? || current_user.level&.value == 0 %>
            <li class="nav-item">
              <%= link_to "ダッシュボード", admin_root_path, class: "nav-link" %>
            </li>
          <% end %>
        <% else %>
          <li class="nav-item">
            <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>


