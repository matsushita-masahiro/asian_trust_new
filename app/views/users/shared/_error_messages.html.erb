<% if resource.errors.any? %>
  <div class="alert alert-danger" role="alert" style="margin-bottom: 20px; border-radius: 8px; border: 1px solid #f5c6cb; background-color: #f8d7da; padding: 15px;">
    <div style="display: flex; align-items: flex-start;">
      <div style="margin-right: 10px; margin-top: 2px;">
        <i class="fas fa-exclamation-triangle" style="color: #721c24; font-size: 16px;"></i>
      </div>
      <div style="flex: 1;">
        <% resource.errors.full_messages.each do |message| %>
          <div style="color: #721c24; font-size: 14px; line-height: 1.4; margin-bottom: 5px;">
            <%= message %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>