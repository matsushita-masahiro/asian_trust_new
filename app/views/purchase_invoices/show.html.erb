<div class="container mt-4">
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h4>購入詳細</h4>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-sm-3"><strong>請求書番号:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.invoice_number %></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>請求日:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.invoice_date.strftime("%Y年%m月%d日") %></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>支払期限:</strong></div>
            <div class="col-sm-9 text-danger fw-bold"><%= @purchase_invoice.due_date.strftime("%Y年%m月%d日") %></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>購入者:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.purchase.user.name %></div>
          </div>
          <% if current_user.level&.value == 7 %>
            <div class="row mb-3">
              <div class="col-sm-3"><strong>販売者:</strong></div>
              <div class="col-sm-9">
                <% if current_user.referrer %>
                  <%= current_user.referrer.name %>
                <% else %>
                  <span class="text-muted">紹介者なし</span>
                <% end %>
              </div>
            </div>
          <% end %>
          <div class="row mb-3">
            <div class="col-sm-3"><strong>購入日:</strong></div>
            <div class="col-sm-9"><%= @purchase_invoice.purchased_at.strftime("%Y年%m月%d日") %></div>
          </div>
          
          <hr>
          
          <h5>購入明細</h5>
          <div class="table-responsive">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>商品名</th>
                  <th class="text-end">単価</th>
                  <th class="text-end">数量</th>
                  <th class="text-end">小計</th>
                </tr>
              </thead>
              <tbody>
                <% @purchase_invoice.purchase_items.each do |item| %>
                  <% 
                    # 骨髄幹細胞培養上清液（ID: 1）の場合は、保存されている数量を5で割って表示
                    display_quantity = (item.product_id == 1) ? (item.quantity / 5) : item.quantity
                    # 単価取得
                    unit_price = (item.seller_price || item.unit_price).to_i
                    # 骨髄幹細胞培養上清液（ID: 1）の場合は10cc単位の価格（5倍）
                    display_unit_price = (item.product_id == 1) ? (unit_price * 5) : unit_price
                    # 小計計算
                    item_subtotal = display_unit_price * display_quantity
                  %>
                  <tr>
                    <td><%= item.product.name %></td>
                    <td class="text-end"><%= number_with_delimiter(display_unit_price) %>円</td>
                    <td class="text-end"><%= display_quantity %></td>
                    <td class="text-end"><%= number_with_delimiter(item_subtotal) %>円</td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <% 
                  # 基本商品代金
                  product_amount = @purchase_invoice.total_amount.to_i
                  
                  # 配送先情報に基づいて送料を再計算
                  if @delivery_informations.present?
                    # 実際の配送先数に基づいて送料を計算
                    actual_delivery_count = @delivery_informations.count
                    calculated_shipping_fee = actual_delivery_count * 6000
                  else
                    # 配送先情報がない場合は従来の方法
                    purchase_items = @purchase_invoice.purchase.purchase_items
                    stem_cell_items = purchase_items.select { |item| item.product.name.include?('骨髄幹細胞培培養上清液') }
                    other_items = purchase_items.select { |item| !item.product.name.include?('骨髄幹細胞培培養上清液') }
                    
                    has_stem_cell_product = stem_cell_items.any?
                    has_other_products = other_items.any?
                    
                    delivery_count = 0
                    delivery_count += 1 if has_stem_cell_product  # クリニック配送
                    delivery_count += 1 if has_other_products     # 自宅配送
                    
                    calculated_shipping_fee = delivery_count * 6000
                    actual_delivery_count = delivery_count
                  end
                  
                  # DBに保存された値と計算値のどちらを使用するかを決定
                  if @purchase_invoice.total_with_tax.present? && @purchase_invoice.total_with_tax > 0
                    # DBに保存された値を基本とするが、送料は再計算した値を使用
                    shipping_fee = calculated_shipping_fee
                    admin_fee = @purchase_invoice.admin_fee.to_i
                    tax_amount = @purchase_invoice.tax_amount.to_i
                    subtotal_before_tax = product_amount + shipping_fee + admin_fee
                    # 税額を再計算（送料が変わった場合）
                    recalculated_tax = calculate_tax(subtotal_before_tax)
                    total_with_tax = subtotal_before_tax + recalculated_tax
                    tax_rate_percent = (@purchase_invoice.tax_rate.to_f * 100).to_i
                    
                    # 表示用の税額（再計算した値を使用）
                    tax_amount = recalculated_tax
                  else
                    # 既存レコード用：全て再計算
                    shipping_fee = calculated_shipping_fee
                    
                    # 事務手数料の計算
                    has_stem_cell_product = @purchase_invoice.purchase.purchase_items.any? { |item| item.product_id == 1 }
                    admin_fee = has_stem_cell_product ? 10000 : 0
                    
                    subtotal_before_tax = product_amount + shipping_fee + admin_fee
                    tax_amount = calculate_tax(subtotal_before_tax)
                    total_with_tax = subtotal_before_tax + tax_amount
                    tax_rate_percent = tax_rate_percentage
                  end
                %>
                <tr>
                  <th colspan="3" class="text-end">商品代金:</th>
                  <th class="text-end"><%= number_with_delimiter(product_amount) %>円</th>
                </tr>
                <% if shipping_fee > 0 %>
                  <% if @delivery_informations.present? && @delivery_informations.count > 1 %>
                    <!-- 複数配送先の場合：配送先ごとに表示 -->
                    <% @delivery_informations.each_with_index do |delivery_info, index| %>
                      <tr>
                        <th colspan="3" class="text-end">
                          送料 (<%= case delivery_info.delivery_type
                          when 'clinic'
                            delivery_info.clinic&.name || 'クリニック'
                          when 'home'
                            delivery_info.address_type == 'shipping' ? '配送先住所' : '登録住所'
                          when 'other'
                            delivery_info.recipient_name || 'その他お届け先'
                          else
                            "配送先#{index + 1}"
                          end %>):
                        </th>
                        <th class="text-end">6,000円</th>
                      </tr>
                    <% end %>
                  <% elsif @delivery_informations.present? && @delivery_informations.count == 1 %>
                    <!-- 単一配送先の場合 -->
                    <tr>
                      <th colspan="3" class="text-end">送料 (1箇所):</th>
                      <th class="text-end">6,000円</th>
                    </tr>
                  <% else %>
                    <!-- 配送先情報がない場合：計算された送料を表示 -->
                    <tr>
                      <th colspan="3" class="text-end">送料 (<%= actual_delivery_count %>箇所):</th>
                      <th class="text-end"><%= number_with_delimiter(shipping_fee) %>円</th>
                    </tr>
                  <% end %>
                <% end %>
                <% if admin_fee > 0 %>
                  <tr>
                    <th colspan="3" class="text-end">事務手数料:</th>
                    <th class="text-end text-warning"><%= number_with_delimiter(admin_fee) %>円</th>
                  </tr>
                <% end %>
                <tr>
                  <th colspan="3" class="text-end">小計（税抜）:</th>
                  <th class="text-end"><%= number_with_delimiter(subtotal_before_tax) %>円</th>
                </tr>
                <tr>
                  <th colspan="3" class="text-end">消費税（<%= tax_rate_percent %>%）:</th>
                  <th class="text-end"><%= number_with_delimiter(tax_amount) %>円</th>
                </tr>
                <tr class="table-success">
                  <th colspan="3" class="text-end fs-5">合計金額:</th>
                  <th class="text-end fs-5 text-danger fw-bold"><%= number_with_delimiter(total_with_tax) %>円</th>
                </tr>
              </tfoot>
            </table>
          </div>
          
          <!-- 配送先情報 -->
          <% if @delivery_informations.present? %>
            <hr>
            <h5>配送先情報 (配送先数: <%= @delivery_informations.count %>)</h5>
            <% @delivery_informations.each_with_index do |delivery_info, index| %>
              <div class="card mb-3">
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6">
                      <h6 class="card-title">
                        <% case delivery_info.delivery_type %>
                        <% when 'clinic' %>
                          <i class="fas fa-hospital text-primary me-2"></i>クリニック配送
                        <% when 'home' %>
                          <i class="fas fa-home text-success me-2"></i>
                          <%= delivery_info.address_type == 'shipping' ? '配送先住所' : '登録住所' %>配送
                        <% when 'other' %>
                          <i class="fas fa-map-marker-alt text-warning me-2"></i>その他配送
                        <% when 'multiple' %>
                          <i class="fas fa-shipping-fast text-info me-2"></i>複数配送先
                        <% else %>
                          <i class="fas fa-truck me-2"></i>配送
                        <% end %>
                      </h6>
                      
                      <% if delivery_info.delivery_type == 'clinic' && delivery_info.clinic %>
                        <p class="mb-1"><strong>配送先:</strong> <%= delivery_info.clinic.name %></p>
                      <% elsif delivery_info.delivery_type == 'other' && delivery_info.recipient_name.present? %>
                        <p class="mb-1"><strong>お届け先名:</strong> <%= delivery_info.recipient_name %></p>
                      <% end %>
                      
                      <% if delivery_info.delivery_address.present? %>
                        <% addresses = delivery_info.delivery_address.split("\n") %>
                        <% addresses.each do |address| %>
                          <% address_parts = address.split("|") %>
                          <% if address_parts.size >= 2 %>
                            <p class="mb-1">
                              <strong>住所:</strong><br>
                              〒<%= address_parts[0] %><br>
                              <%= address_parts[1] %>
                              <% if address_parts[2].present? %>
                                <br><small class="text-muted">(<%= address_parts[2] %>)</small>
                              <% end %>
                            </p>
                          <% end %>
                        <% end %>
                      <% end %>
                      
                      <% if delivery_info.delivery_type == 'other' %>
                        <% if delivery_info.postal_code.present? %>
                          <p class="mb-1"><strong>郵便番号:</strong> 〒<%= delivery_info.postal_code %></p>
                        <% end %>
                        <% if delivery_info.phone_number.present? %>
                          <p class="mb-1"><strong>電話番号:</strong> <%= delivery_info.phone_number %></p>
                        <% end %>
                      <% end %>
                    </div>
                    
                    <div class="col-md-6">
                      <h6>配送商品</h6>
                      <% 
                        # この配送先に関連する商品を取得
                        related_items = case delivery_info.delivery_type
                        when 'clinic'
                          @purchase_invoice.purchase_items.select { |item| item.product_id == 1 } # 骨髄幹細胞培養上清液
                        when 'home', 'other'
                          @purchase_invoice.purchase_items.select { |item| item.product_id != 1 } # その他の商品
                        when 'multiple'
                          @purchase_invoice.purchase_items # 全商品
                        else
                          @purchase_invoice.purchase_items
                        end
                      %>
                      
                      <% if related_items.any? %>
                        <ul class="list-unstyled">
                          <% related_items.each do |item| %>
                            <% 
                              display_quantity = (item.product_id == 1) ? (item.quantity / 5) : item.quantity
                              display_unit = (item.product_id == 1) ? "10cc" : item.product.display_unit
                            %>
                            <li class="mb-1">
                              <i class="fas fa-box text-muted me-1"></i>
                              <%= item.product.name %>
                              <small class="text-muted">× <%= display_quantity %><%= display_unit %></small>
                            </li>
                          <% end %>
                        </ul>
                      <% else %>
                        <p class="text-muted">関連商品なし</p>
                      <% end %>
                    </div>
                  </div>
                  
                  <% if delivery_info.delivery_notes.present? %>
                    <hr>
                    <p class="mb-0">
                      <strong>配送メモ:</strong><br>
                      <%= simple_format(delivery_info.delivery_notes) %>
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
          
          <% if @purchase_invoice.notes.present? %>
            <hr>
            <h6>備考</h6>
            <p><%= simple_format(@purchase_invoice.notes) %></p>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5>操作</h5>
        </div>
        <div class="card-body">
          <% if current_user.level&.value == 0 %>
            <!-- 管理者用操作 -->
            <% if @purchase_invoice.sent? %>
              <%= link_to "支払い確認", confirm_payment_purchase_invoice_path(@purchase_invoice), 
                  method: :patch, class: "btn btn-success btn-sm mb-2 w-100",
                  confirm: "支払いを確認しますか？" %>
            <% end %>
            
            <% if @purchase_invoice.receipt_requested? %>
              <%= link_to "領収書発行", send_receipt_purchase_invoice_path(@purchase_invoice), 
                  method: :patch, class: "btn btn-info btn-sm mb-2 w-100",
                  confirm: "領収書を発行しますか？" %>
            <% end %>
            
            <%= link_to "編集", edit_admin_purchase_invoice_path(@purchase_invoice), 
                class: "btn btn-outline-secondary btn-sm mb-2 w-100" %>
          <% else %>
            <!-- 一般ユーザー用操作 -->
            <% if @purchase_invoice.paid? && !@purchase_invoice.receipt_requested? %>
              <%= link_to "領収書発行依頼", request_receipt_purchase_invoice_path(@purchase_invoice), 
                  method: :patch, class: "btn btn-success btn-sm mb-2 w-100",
                  confirm: "領収書発行を依頼しますか？" %>
            <% elsif @purchase_invoice.receipt_sent? %>
              <%= link_to "領収書PDF", purchase_invoice_path(@purchase_invoice, format: :pdf, type: :receipt), 
                  class: "btn btn-primary btn-sm mb-2 w-100", target: "_blank" %>
            <% end %>
          <% end %>
          
          <%= link_to "請求書PDF", purchase_invoice_path(@purchase_invoice, format: :pdf), 
              class: "btn btn-outline-primary btn-sm mb-2 w-100", target: "_blank" %>
          
          <% if @purchase_invoice.sent? && @purchase_invoice.purchase.user == current_user %>
            <%= link_to "支払完了", mark_as_paid_purchase_invoice_path(@purchase_invoice), 
                method: :patch,
                class: "btn btn-success btn-sm mb-2 w-100",
                confirm: "支払いが完了しましたか？管理者に支払確認を依頼します。" %>
          <% end %>
          
          <%= link_to "購入履歴へ", my_history_purchases_path, class: "btn btn-secondary btn-sm w-100" %>
        </div>
      </div>
      
      <div class="card mt-3">
        <div class="card-header">
          <h6><i class="fas fa-university me-2"></i>振込口座情報</h6>
        </div>
        <div class="card-body">
          <% if @bank_info %>
            <div class="row mb-2">
              <div class="col-4"><strong>銀行名:</strong></div>
              <div class="col-8"><%= @bank_info.bank_name %></div>
            </div>
            <div class="row mb-2">
              <div class="col-4"><strong>支店名:</strong></div>
              <div class="col-8"><%= @bank_info.bank_branch_name %></div>
            </div>
            <div class="row mb-2">
              <div class="col-4"><strong>口座種別:</strong></div>
              <div class="col-8">
                <% if @bank_info.bank_account_type == 'savings' %>
                  普通
                <% elsif @bank_info.bank_account_type == 'checking' %>
                  当座
                <% else %>
                  <%= @bank_info.bank_account_type %>
                <% end %>
              </div>
            </div>
            <div class="row mb-2">
              <div class="col-4"><strong>口座番号:</strong></div>
              <div class="col-8"><%= @bank_info.bank_account_number %></div>
            </div>
            <div class="row mb-2">
              <div class="col-4"><strong>口座名義:</strong></div>
              <div class="col-8"><%= @bank_info.bank_account_name %></div>
            </div>
            <hr class="my-3">
            <div class="alert alert-info small mb-0">
              <i class="fas fa-info-circle me-2"></i>
              お振込の際は、請求書番号（<strong><%= @purchase_invoice.invoice_number %></strong>）を必ずお振込名義人欄にご記入ください。
            </div>
          <% else %>
            <div class="alert alert-warning mb-0">
              <i class="fas fa-exclamation-triangle me-2"></i>
              振込先情報が設定されていません。管理者にお問い合わせください。
            </div>
          <% end %>
        </div>
      </div>
      
      <!-- クリニック予約セクション -->
      <div class="card mt-3">
        <div class="card-header">
          <h6><i class="fas fa-calendar-alt me-2"></i>クリニック予約</h6>
        </div>
        <div class="card-body">
          <% if @purchase_invoice.purchase.emergency_reservation_requested? %>
            <div class="alert alert-danger mb-3">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <strong>緊急予約依頼</strong>
            </div>
            <div class="mb-3">
              <strong>依頼内容:</strong><br>
              <div class="border p-2 bg-light rounded">
                <%= simple_format(@purchase_invoice.purchase.emergency_reservation_message) %>
              </div>
            </div>
            <div class="text-muted small">
              事務局が確認後、ご連絡いたします。
            </div>
          <% else %>
            <% case @purchase_invoice.clinic_reservation_status %>
            <% when :not_required %>
            <div class="alert alert-secondary mb-0">
              <i class="fas fa-info-circle me-2"></i>
              この購入にはクリニック予約は不要です。
            </div>
          <% when :payment_required %>
            <div class="alert alert-warning mb-0">
              <i class="fas fa-exclamation-triangle me-2"></i>
              入金確認後にクリニック予約が可能になります。
            </div>
          <% when :reserved %>
            <div class="alert alert-success mb-3">
              <i class="fas fa-check-circle me-2"></i>
              クリニック予約済みです。
            </div>
            <% reservation = @purchase_invoice.clinic_reservation %>
            <div class="mb-2">
              <strong>予約状況:</strong> 
              <span class="badge bg-<%= reservation.pending? ? 'warning' : reservation.confirmed? ? 'success' : 'info' %>">
                <%= reservation.status_name %>
              </span>
            </div>
            <div class="mb-2">
              <strong>第1希望:</strong> <%= reservation.preferred_date_1&.strftime('%Y/%m/%d') %> <%= reservation.preferred_time_1 %>
            </div>
            <% if reservation.preferred_date_2.present? %>
              <div class="mb-2">
                <strong>第2希望:</strong> <%= reservation.preferred_date_2&.strftime('%Y/%m/%d') %> <%= reservation.preferred_time_2 %>
              </div>
            <% end %>
            <% if reservation.preferred_date_3.present? %>
              <div class="mb-3">
                <strong>第3希望:</strong> <%= reservation.preferred_date_3&.strftime('%Y/%m/%d') %> <%= reservation.preferred_time_3 %>
              </div>
            <% end %>
            <%= link_to "予約詳細を見る", clinic_reservation_path(reservation), 
                class: "btn btn-outline-primary btn-sm w-100" %>
          <% when :not_reserved %>
            <%= link_to "クリニック予約", new_purchase_clinic_reservation_path(@purchase_invoice.purchase), 
                class: "btn btn-primary btn-sm w-100" %>
            <% end %>
          <% end %>
        </div>
      </div>
      
      <div class="card mt-3">
        <div class="card-header">
          <h6>ステータス履歴</h6>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li><i class="fas fa-check text-success"></i> 作成済み</li>
            <% if @purchase_invoice.sent_at %>
              <li><i class="fas fa-check text-success"></i> 送付済み (<%= @purchase_invoice.sent_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
            <% if @purchase_invoice.confirmed_at %>
              <li><i class="fas fa-check text-success"></i> 支払い確認済み (<%= @purchase_invoice.confirmed_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
            <% if @purchase_invoice.receipt_requested_at %>
              <li><i class="fas fa-check text-success"></i> 領収書依頼済み (<%= @purchase_invoice.receipt_requested_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
            <% if @purchase_invoice.receipt_sent_at %>
              <li><i class="fas fa-check text-success"></i> 領収書発行済み (<%= @purchase_invoice.receipt_sent_at.strftime("%m/%d %H:%M") %>)</li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>