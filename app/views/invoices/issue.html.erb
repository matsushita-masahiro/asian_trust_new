<div class="container py-5 pt-5 mt-5">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-primary">📋 請求書発行</h4>
        <div class="d-flex align-items-center">
          <div class="me-3">
            <%= form_with url: issue_invoices_path, method: :get, local: true, class: "d-flex align-items-center" do |f| %>
              <small class="text-muted me-3">請求元: <%= current_user.name.presence || current_user.email %></small>
              <label class="form-label me-2 mb-0">対象月:</label>
              <%= f.month_field :month, value: @selected_month, class: "form-control me-2", style: "width: 180px;", onchange: "this.form.submit();" %>
            <% end %>
          </div>
          <div>
            <%= link_to "履歴を見る", history_invoices_path, class: "btn btn-outline-info me-2" %>
            <%= link_to "請求書管理に戻る", invoices_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-light">
          <h5 class="mb-0">新しい請求書を作成</h5>
        </div>
        <div class="card-body">
          <% if @invoice_recipients.any? %>
            <%= form_with model: @invoice, local: true, class: "needs-validation", novalidate: true do |f| %>
              <%= f.hidden_field :target_month, value: @selected_month %>
              <div class="mb-3">
                <%= f.label :invoice_recipient_id, "請求先", class: "form-label" %>
                <%= f.select :invoice_recipient_id, 
                    options_from_collection_for_select(@invoice_recipients, :id, :name), 
                    { prompt: '請求先を選択してください' }, 
                    { class: "form-select", required: true } %>
                <div class="invalid-feedback">
                  請求先を選択してください。
                </div>
              </div>

              <div class="mb-3">
                <%= f.label :invoice_date, "請求書発行日", class: "form-label" %>
                <%= f.date_field :invoice_date, class: "form-control", required: true %>
                <div class="invalid-feedback">
                  請求書発行日を入力してください。
                </div>
              </div>

              <div class="mb-3">
                <%= f.label :total_amount, "請求金額（#{@selected_month}のインセンティブ合計）", class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text">¥</span>
                  <%= f.number_field :total_amount, class: "form-control bg-light", readonly: true %>
                </div>
                <div class="form-text">※ 選択された月のインセンティブ合計額が自動計算されます</div>
              </div>

              <div class="mb-3">
                <label class="form-label">支払期限</label>
                <div class="form-control bg-light text-muted">
                  <%= @invoice.due_date.strftime("%Y年%m月%d日") %>
                </div>
                <%= f.hidden_field :due_date %>
              </div>

              <div class="mb-3">
                <%= f.label :notes, "備考・詳細", class: "form-label" %>
                <%= f.text_area :notes, class: "form-control", rows: 4, placeholder: "請求内容の詳細や備考を入力してください" %>
              </div>

              <!-- 銀行情報セクション -->
              <h6 class="text-muted mb-3 mt-4">振込先情報（インセンティブ受取口座）</h6>
              
              <% if @existing_invoice_base %>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label">銀行名</label>
                    <div class="form-control bg-light text-muted">
                      <%= @existing_invoice_base.bank_name.presence || "未設定" %>
                    </div>
                    <%= f.hidden_field :bank_name, value: @existing_invoice_base.bank_name %>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="form-label">支店名</label>
                    <div class="form-control bg-light text-muted">
                      <%= @existing_invoice_base.bank_branch_name.presence || "未設定" %>
                    </div>
                    <%= f.hidden_field :bank_branch_name, value: @existing_invoice_base.bank_branch_name %>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label">口座種別</label>
                    <div class="form-control bg-light text-muted">
                      <%= @existing_invoice_base.bank_account_type == 'savings' ? '普通' : (@existing_invoice_base.bank_account_type == 'checking' ? '当座' : '未設定') %>
                    </div>
                    <%= f.hidden_field :bank_account_type, value: @existing_invoice_base.bank_account_type %>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="form-label">口座番号</label>
                    <div class="form-control bg-light text-muted">
                      <%= @existing_invoice_base.bank_account_number.presence || "未設定" %>
                    </div>
                    <%= f.hidden_field :bank_account_number, value: @existing_invoice_base.bank_account_number %>
                  </div>
                </div>

                <div class="mb-3">
                  <label class="form-label">口座名義</label>
                  <div class="form-control bg-light text-muted">
                    <%= @existing_invoice_base.bank_account_name.presence || "未設定" %>
                  </div>
                  <%= f.hidden_field :bank_account_name, value: @existing_invoice_base.bank_account_name %>
                </div>
              <% else %>
                <div class="alert alert-warning">
                  <i class="fas fa-exclamation-triangle me-2"></i>
                  口座情報が設定されていません。
                  <%= link_to "請求書情報設定", settings_invoices_path, class: "alert-link" %>で口座情報を登録してください。
                </div>
              <% end %>

              <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <%= link_to "キャンセル", invoices_path, class: "btn btn-outline-secondary me-md-2" %>
                <%= f.submit "請求書作成・確認", class: "btn btn-primary" %>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-4">
              <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
              <h5>請求先が設定されていません</h5>
              <p class="text-muted">請求書を発行するには、管理者に請求先情報の設定を依頼してください。</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- インセンティブ内訳セクション -->
  <% if @bonus_details.any? %>
    <div class="row justify-content-center mt-4">
      <div class="col-md-10">
        <div class="card shadow">
          <div class="card-header bg-light">
            <h5 class="mb-0">📊 <%= @selected_month %> インセンティブ内訳</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead class="table-light">
                  <tr>
                    <th>購入者</th>
                    <th style="text-align: center;">商品名</th>
                    <th style="text-align: right;">数量</th>
                    <th class="text-end">インセンティブ単価</th>
                    <th class="text-end">インセンティブ小計</th>
                    <th style="text-align: center;">購入日</th>
                  </tr>
                </thead>
                <tbody>
                  <% @bonus_details.sort_by { |detail| detail[:purchased_at] }.each do |detail| %>
                    <tr>
                      <td><%= detail[:user_name] %></td>
                      <td><%= detail[:product_name] %></td>
                      <td style="text-align: right;"><%= detail[:quantity] %></td>
                      <td class="text-end">¥<%= number_with_delimiter(detail[:unit_bonus]) %></td>
                      <td class="text-end text-success fw-bold">¥<%= number_with_delimiter(detail[:total_bonus]) %></td>
                      <td style="text-align: center;"><%= detail[:purchased_at].strftime("%Y/%m/%d") %></td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <th colspan="4" class="text-end">合計インセンティブ:</th>
                    <th class="text-end text-primary fw-bold">¥<%= number_with_delimiter(@total_bonus) %></th>
                    <th></th>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row justify-content-center mt-4">
      <div class="col-md-8">
        <div class="card shadow">
          <div class="card-body text-center py-4">
            <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
            <h5>インセンティブ内訳なし</h5>
            <p class="text-muted"><%= @selected_month %> にはインセンティブ対象の販売がありませんでした。</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
// Bootstrap form validation
(function() {
  'use strict';
  window.addEventListener('load', function() {
    var forms = document.getElementsByClassName('needs-validation');
    var validation = Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  }, false);
})();
</script>