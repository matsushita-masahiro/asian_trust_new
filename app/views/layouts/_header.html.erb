<nav class="navbar navbar-expand-lg navbar-dark fixed-top custom-navbar" data-turbo-permanent>
  <div class="container-fluid">
    <%= link_to root_path, class: "navbar-brand align-items-center" do %>
      <%= image_tag "abt_logo.png", alt: "ABT Logo", class: "navbar-logo me-3" %>
      <%= ENV['APRICATION_NAME'] %>
    <% end %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <% if current_user.level&.name.in?(['総代理店', '代理店', 'アドバイザー', 'サポーター']) %>
            <li class="nav-item">
              <span class="nav-link" style="color: #ffd700; font-weight: bold;">
                総販売実績: <%= number_with_delimiter(current_user.total_purchase_volume_cc.to_i) %> cc
              </span>
            </li>
          <% end %>
          <% unless current_user.admin? || current_user.level&.name == 'アドバイザー認定前' %>
            <li class="nav-item">
              <%= link_to "予約・注文", orders_path, class: "nav-link" %>
            </li>
          <% end %>
          <% if user_signed_in? && !current_user.admin? && current_user.bonus_eligible? %>
            <li class="nav-item custom-dropdown">
              <a class="nav-link custom-dropdown-toggle" href="#" id="incentiveDropdown" role="button">
                インセンティブ <i class="fas fa-chevron-down ms-1"></i>
              </a>
              <ul class="custom-dropdown-menu" id="incentiveDropdownMenu">
                <li><%= link_to "インセンティブ", incentives_path, class: "custom-dropdown-item" %></li>
                <li><%= link_to "請求書管理", invoices_path, class: "custom-dropdown-item" %></li>
              </ul>
            </li>
          <% end %>
          <% if user_signed_in? && !current_user.admin? && current_user.referrals.any? && !['サロン', 'クリニック'].include?(current_user.level&.name) %>
            <li class="nav-item">
              <%= link_to "階層図", hierarchy_path, class: "nav-link" %>
            </li>
          <% end %>

          <li class="nav-item custom-dropdown">
            <a class="nav-link custom-dropdown-toggle" href="#" id="mypageDropdown" role="button">
              マイページ <i class="fas fa-chevron-down ms-1"></i>
            </a>
            <ul class="custom-dropdown-menu" id="mypageDropdownMenu">
              <li><%= link_to "マイアカウント", mypage_users_path, class: "custom-dropdown-item" %></li>
              <li>
                <%= link_to notifications_path, class: "custom-dropdown-item d-flex justify-content-between align-items-center", style: "white-space: nowrap;" do %>
                  <span>事務局からのお知らせ</span>
                  <% unread_count = current_user.notifications.unread.count %>
                  <% if unread_count > 0 %>
                    <span class="badge bg-danger ms-2"><%= unread_count %></span>
                  <% end %>
                <% end %>
              </li>
              <% unless current_user.level.value.in?([6, 7, 8]) || current_user.level&.name == 'アドバイザー認定前' %>
                <li><%= link_to "売上情報", mysales_path, class: "custom-dropdown-item" %></li>
              <% end %>
              <% unless current_user.admin? || current_user.level&.name == 'アドバイザー認定前' %>
                <li><%= link_to "購入履歴", my_history_purchases_path, class: "custom-dropdown-item" %></li>
              <% end %>
              <% unless current_user.admin? %>
                <li><%= link_to "お問合せ履歴", inquiries_path, class: "custom-dropdown-item" %></li>
              <% end %>
              <% if current_user.admin? || (current_user&.level&.value && [1, 2, 3].include?(current_user.level.value)) %>
                <li><%= link_to "紹介機能", new_referral_invitation_path, class: "custom-dropdown-item" %></li>
              <% end %>
            </ul>
          </li>
          <li class="nav-item">
            <%= link_to "ログアウト", destroy_user_session_path, 
                data: { 
                  turbo_method: :delete,
                  turbo_confirm: "ログアウトしますか？"
                }, 
                class: "nav-link",
                id: "logout-link" %>
          </li>
          <% if current_user.admin? || current_user.level&.value == 0 %>
            <li class="nav-item">
              <%= link_to "ダッシュボード", admin_root_path, class: "nav-link" %>
            </li>
          <% end %>
        <% else %>
          <li class="nav-item">
            <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<script>
// カスタムドロップダウンの制御
function initializeCustomDropdown() {
  // マイページドロップダウン
  const mypageToggle = document.getElementById('mypageDropdown');
  const mypageMenu = document.getElementById('mypageDropdownMenu');
  
  // インセンティブドロップダウン
  const incentiveToggle = document.getElementById('incentiveDropdown');
  const incentiveMenu = document.getElementById('incentiveDropdownMenu');
  
  // ドロップダウンの初期化関数
  function setupDropdown(toggle, menu) {
    if (!toggle || !menu) return;
    
    // 既存のイベントリスナーを削除
    const newToggle = toggle.cloneNode(true);
    toggle.parentNode.replaceChild(newToggle, toggle);
    
    // クリックイベントでドロップダウンを切り替え
    newToggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      const isShown = menu.classList.contains('show');
      
      // 他のドロップダウンを閉じる
      document.querySelectorAll('.custom-dropdown-menu.show').forEach(otherMenu => {
        if (otherMenu !== menu) {
          otherMenu.classList.remove('show');
        }
      });
      
      // 現在のドロップダウンを切り替え
      if (isShown) {
        menu.classList.remove('show');
      } else {
        menu.classList.add('show');
      }
    });
    
    return newToggle;
  }
  
  // 各ドロップダウンを初期化
  const newMypageToggle = setupDropdown(mypageToggle, mypageMenu, 'Mypage');
  const newIncentiveToggle = setupDropdown(incentiveToggle, incentiveMenu, 'Incentive');
  
  // 外側をクリックしたらドロップダウンを閉じる
  document.addEventListener('click', function(e) {
    const allToggles = [newMypageToggle, newIncentiveToggle].filter(Boolean);
    const allMenus = [mypageMenu, incentiveMenu].filter(Boolean);
    
    let clickedInsideAnyDropdown = false;
    
    allToggles.forEach((toggle, index) => {
      const menu = allMenus[index];
      if (toggle && menu && (toggle.contains(e.target) || menu.contains(e.target))) {
        clickedInsideAnyDropdown = true;
      }
    });
    
    if (!clickedInsideAnyDropdown) {
      allMenus.forEach(menu => {
        if (menu) menu.classList.remove('show');
      });
    }
  });
  
  // ESCキーでドロップダウンを閉じる
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.custom-dropdown-menu.show').forEach(menu => {
        menu.classList.remove('show');
      });
    }
  });
}

// より確実な初期化
function ensureDropdownInitialization() {
  // 少し遅延させて確実に要素が存在することを確認
  setTimeout(() => {
    initializeCustomDropdown();
  }, 100);
}

// 複数のイベントで初期化を試行
document.addEventListener('DOMContentLoaded', ensureDropdownInitialization);
document.addEventListener('turbo:load', ensureDropdownInitialization);
document.addEventListener('turbo:render', ensureDropdownInitialization);

// ページが完全に読み込まれた後にも実行
window.addEventListener('load', ensureDropdownInitialization);
</script>
