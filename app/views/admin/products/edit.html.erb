<div class="container py-5 mt-5">
  <div class="card shadow">
    <div class="card-body">
      <h2 class="mb-4">🧪 商品編集</h2>

      <%= form_with(model: [:admin, @product], local: true) do |form| %>
        <div class="mb-4">
          <%= form.label :name, "商品名", class: "form-label fw-bold" %>
          <%= form.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-4">
          <%= form.label :short_name, "商品略称", class: "form-label fw-bold" %>
          <%= form.text_field :short_name, class: "form-control", placeholder: "例: 骨髄幹細胞" %>
          <div class="form-text">表示用の短縮名を入力してください</div>
        </div>

        <div class="mb-4">
          <%= form.label :base_price, "基本価格（円）", class: "form-label fw-bold" %>
          <%= form.number_field :base_price, class: "form-control" %>
        </div>

        <div class="mb-4">
          <%= form.label :unit_quantity, "販売数量", class: "form-label fw-bold" %>
          <%= form.number_field :unit_quantity, 
              value: (@product.unit_quantity % 1 == 0 ? @product.unit_quantity.to_i : @product.unit_quantity),
              step: 1, 
              class: "form-control", 
              placeholder: "例: 2" %>
        </div>

        <div class="mb-4">
          <%= form.label :unit_label, "販売単位", class: "form-label fw-bold" %>
          <%= form.text_field :unit_label, class: "form-control", placeholder: "例: cc, 回, 箱" %>
        </div>

        <%= render partial: 'level_prices', locals: { product: @product, form: form } %>

        <div class="d-flex justify-content-between mt-4">
          <div>
            <%= link_to "削除", admin_product_path(@product), 
                method: :delete, 
                class: "btn btn-danger px-4",
                data: { 
                  confirm: "本当に「#{@product.name}」を削除しますか？\n削除後は商品一覧に表示されなくなります。" 
                } %>
          </div>
          <div>
            <%= link_to "キャンセル", admin_products_path, class: "btn btn-secondary me-2" %>
            <%= form.submit "更新", class: "btn btn-primary px-4" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
