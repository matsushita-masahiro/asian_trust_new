<div class="container mt-4" data-checkout-path="<%= orders_checkout_path %>">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4>
      <% if @category == 'wott' %>
        WOTT 商品一覧
      <% elsif @category == 'ms' %>
        マナーズサウンド 商品一覧
      <% else %>
        幹細胞培養上精液 商品一覧
      <% end %>
    </h4>
    <div>
      <%= link_to "カートを見る (#{@cart.total_items})", cart_path, class: "btn btn-outline-primary" %>
      <%= link_to "戻る", orders_path, class: "btn btn-secondary" %>
    </div>
  </div>
  
  <% if @products.any? %>
    <div class="row">
      <% @products.each do |product| %>
        <% 
          if @category == 'wott'
            user_price = product.wott_price_for(current_user.wott_level_symbol)
          else
            user_price = product.price_for(current_user.level_symbol)
          end
          
          # 骨髄幹細胞培培養上清液（ID: 1）の場合は10cc単位で表示
          is_bone_marrow = product.id == 1
          display_unit = is_bone_marrow ? "10cc" : product.display_unit
          display_price = is_bone_marrow ? (user_price * 5) : user_price
        %>
        <% if user_price %>
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title"><%= product.name %></h5>
                <p class="text-muted">単位: <%= display_unit %></p>
                <p class="h5 text-success">¥<%= number_with_delimiter(display_price) %></p>
                <% if @category == 'wott' %>
                  <p class="small text-muted mb-2">
                    ※上清液のレベルは<%= current_user.level_label %>ですが、WOTTの購入レベルは<%= current_user.wott_level_name %>です
                  </p>
                <% end %>
              
              <%= form_with url: add_item_cart_path, method: :post, local: true, class: "mt-3" do |f| %>
                <%= f.hidden_field :product_id, value: product.id %>
                
                <div class="mb-3">
                  <%= f.label :quantity, "数量", class: "form-label" %>
                  <% 
                    max_quantity = (@category == 'ms' || @category == 'wott') ? 5 : 10
                    quantity_options = (1..max_quantity).map { |i| [i, i] }
                  %>
                  <%= f.select :quantity, options_for_select(quantity_options), 
                      { prompt: "数量を選択" }, 
                      { class: "form-select" } %>
                </div>
                
                <div class="d-grid gap-2">
                  <%= f.submit "カートに入れる", class: "btn btn-outline-success" %>
                </div>
              <% end %>
              
                <button type="button" class="btn btn-success w-100 mt-2" 
                        onclick="directPurchase(<%= product.id %>)">
                  今すぐ購入
                </button>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      現在、商品がありません。
    </div>
  <% end %>
</div>


