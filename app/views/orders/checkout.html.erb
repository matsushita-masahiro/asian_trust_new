<div class="container mt-4">
  <h3>購入確認</h3>
  
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5>注文内容</h5>
        </div>
        <div class="card-body">
          <% if @cart&.cart_items&.any? %>
            <% @cart.cart_items.each do |item| %>
              <div class="row mb-3 pb-3 border-bottom">
                <div class="col-md-6">
                  <h6><%= item.product.name %></h6>
                  <p class="text-muted mb-0">単位: <%= item.product.display_unit %></p>
                </div>
                <div class="col-md-2 text-center">
                  <span class="badge bg-secondary">× <%= item.quantity %></span>
                </div>
                <div class="col-md-2 text-end">
                  ¥<%= number_with_delimiter(item.product.price_for(current_user.level_symbol) || 0) %>
                </div>
                <div class="col-md-2 text-end">
                  <strong>¥<%= number_with_delimiter(item.subtotal(current_user.level_symbol)) %></strong>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted">カートに商品がありません</p>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <!-- 配送先情報カード -->
      <% if params[:delivery_type].present? %>
        <div class="card mb-3">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0">
              <i class="fas fa-shipping-fast me-2"></i>
              配送先情報
            </h5>
          </div>
          <div class="card-body">
            <% 
              # 商品別配送先情報を準備
              stem_cell_items = @cart&.cart_items&.select { |item| item.product.name.include?('骨髄幹細胞培培養上清液') } || []
              other_items = @cart&.cart_items&.select { |item| !item.product.name.include?('骨髄幹細胞培培養上清液') } || []
              
              has_stem_cell_product = stem_cell_items.any?
              has_other_products = other_items.any?
              
              # クリニック情報
              selected_clinic = params[:clinic_id].present? ? User.find_by(id: params[:clinic_id]) : nil
              
              delivery_destinations = []
              
              # クリニック配送先
              if has_stem_cell_product
                if selected_clinic&.invoice_base
                  delivery_destinations << {
                    title: "#{selected_clinic.name}（クリニック配送）",
                    icon: 'fas fa-hospital',
                    address: "〒#{selected_clinic.invoice_base.postal_code}<br>#{selected_clinic.invoice_base.address}".html_safe,
                    note: '骨髄幹細胞培培養上清液',
                    phone: selected_clinic.phone,
                    type: 'clinic'
                  }
                else
                  delivery_destinations << {
                    title: 'クリニック配送',
                    icon: 'fas fa-hospital',
                    address: nil,
                    note: 'クリニック情報が見つかりません',
                    type: 'clinic'
                  }
                end
              end
              
              # 自宅配送先
              if has_other_products
                # 選択された住所タイプに基づいて住所を取得
                selected_address = @selected_address
                address_type_label = case @address_type
                                   when 'shipping'
                                     '配送先住所'
                                   else
                                     '登録住所'
                                   end
                
                delivery_destinations << {
                  title: "#{address_type_label}（自宅配送）",
                  icon: 'fas fa-home',
                  address: (selected_address&.postal_code.present? && selected_address&.address.present?) ? 
                           "〒#{selected_address.postal_code}<br>#{selected_address.address}".html_safe : 
                           '<span class="text-danger">住所が登録されていません</span>'.html_safe,
                  note: 'その他の商品',
                  type: 'home'
                }
              end
            %>
            
            <% delivery_destinations.each_with_index do |destination, index| %>
              <div class="<%= 'mb-4' if delivery_destinations.size > 1 %>">
                <div class="d-flex align-items-start mb-3">
                  <i class="<%= destination[:icon] %> me-3 mt-1 text-primary"></i>
                  <div>
                    <div class="fw-bold"><%= destination[:title] %></div>
                    <small class="text-muted"><%= destination[:note] %></small>
                  </div>
                </div>
                
                <% if destination[:address].present? %>
                  <div class="alert alert-light">
                    <i class="fas fa-map-marker-alt me-2"></i>
                    <strong>配送先住所:</strong>
                    <div class="mt-2"><%= destination[:address] %></div>
                    <% if destination[:phone].present? %>
                      <div class="mt-2">
                        <i class="fas fa-phone me-2"></i>
                        <strong>電話番号:</strong> <%= destination[:phone] %>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>配送先:</strong>
                    <div class="mt-2"><%= destination[:note] %></div>
                  </div>
                <% end %>
                
                <% if delivery_destinations.size > 1 && index < delivery_destinations.size - 1 %>
                  <hr class="my-3">
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- 注文合計カード -->
      <div class="card">
        <div class="card-header">
          <h5>注文合計</h5>
        </div>
        <div class="card-body">
          <% 
            # 基本料金計算
            subtotal = @cart&.total_amount(current_user.level_symbol) || 0
            
            # 配送先数を計算
            delivery_count = delivery_destinations.size
            shipping_fee = delivery_count * 6000
            
            # 事務手数料（クリニック配送がある場合）
            admin_fee = has_stem_cell_product ? 10000 : 0
            
            # 合計金額
            total_amount = subtotal + shipping_fee + admin_fee
          %>
          
          <div class="d-flex justify-content-between mb-2">
            <span>商品代金:</span>
            <span>¥<%= number_with_delimiter(subtotal) %></span>
          </div>
          <% if has_stem_cell_product && has_other_products %>
            <!-- 複数配送先の場合：送料を2行で表示 -->
            <div class="d-flex justify-content-between mb-2">
              <span>送料:</span>
              <span>¥6,000</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>送料（骨髄別送）:</span>
              <span>¥6,000</span>
            </div>
          <% else %>
            <!-- 単一配送先の場合：従来通り -->
            <div class="d-flex justify-content-between mb-2">
              <span>送料 (<%= delivery_count %>箇所):</span>
              <span>¥<%= number_with_delimiter(shipping_fee) %></span>
            </div>
          <% end %>
          <% if admin_fee > 0 %>
            <div class="d-flex justify-content-between mb-2">
              <span>事務手数料:</span>
              <span class="text-warning">¥<%= number_with_delimiter(admin_fee) %></span>
            </div>
          <% end %>
          <% 
            # 税抜き合計（商品代金+送料+事務手数料）
            subtotal_before_tax = subtotal + shipping_fee + admin_fee
            # 消費税計算
            tax_amount = calculate_tax(subtotal_before_tax)
            # 税込み合計
            total_amount_with_tax = subtotal_before_tax + tax_amount
          %>
          <div class="d-flex justify-content-between mb-2">
            <span>小計（税抜）:</span>
            <span>¥<%= number_with_delimiter(subtotal_before_tax) %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>消費税（<%= tax_rate_percentage %>%）:</span>
            <span>¥<%= number_with_delimiter(tax_amount) %></span>
          </div>
          <hr>
          <div class="d-flex justify-content-between mb-3">
            <strong>合計:</strong>
            <strong class="text-success">¥<%= number_with_delimiter(total_amount_with_tax) %></strong>
          </div>
          
          <!-- 料金説明 -->
          <div class="alert alert-light small">
            <i class="fas fa-info-circle me-2"></i>
            <strong>料金について:</strong>
            <ul class="mb-0 mt-2">
              <% if has_stem_cell_product && has_other_products %>
                <li>送料: ご登録住所への配送 ¥6,000</li>
                <li>送料（骨髄別送）: クリニックへの配送 ¥6,000</li>
                <li class="text-warning">事務手数料: クリニック配送 ¥10,000</li>
              <% elsif has_stem_cell_product %>
                <li>送料（骨髄別送）: クリニックへの配送 ¥6,000</li>
                <li class="text-warning">事務手数料: クリニック配送 ¥10,000</li>
              <% else %>
                <li>送料: 配送先1箇所につき ¥6,000</li>
              <% end %>
            </ul>
          </div>
          
          <div class="d-grid gap-2">
            <% if params[:delivery_type].present? %>
              <% 
                payment_params = { delivery_type: params[:delivery_type] }
                payment_params[:address_type] = params[:address_type] if params[:address_type].present?
                payment_params[:clinic_id] = params[:clinic_id] if params[:clinic_id].present?
              %>
              <%= link_to "お支払い方法を選択する", select_method_payments_path(payment_params), 
                  class: "btn btn-success btn-lg" %>
            <% else %>
              <%= link_to "カートに戻って配送先を選択", cart_path, class: "btn btn-warning btn-lg" %>
            <% end %>
            <%= link_to "カートに戻る", cart_path, class: "btn btn-outline-secondary" %>
            <%= link_to "商品一覧に戻る", orders_products_path, class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
