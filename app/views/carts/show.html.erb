<%= javascript_import_module_tag "carts" %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3>カート</h3>
    <%= link_to "商品一覧に戻る", orders_products_path, class: "btn btn-primary" %>
  </div>
  
  <% if @cart_items.any? %>
    <div class="row">
      <div class="col-md-12">
        <div class="card">
          <div class="card-body">
            <table class="table">
              <thead>
                <tr>
                  <th>商品名</th>
                  <th class="text-center">数量</th>
                  <th class="text-end">単価</th>
                  <th class="text-end">小計</th>
                  <th>配送先</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @cart_items.each do |item| %>
                  <% 
                    # 骨髄幹細胞培養上清液（ID: 1）の場合は、保存されている数量を5で割って表示
                    display_quantity = (item.product.id == 1) ? (item.quantity / 5) : item.quantity
                    # 骨髄幹細胞培養上清液（ID: 1）の場合は10cc単位で表示
                    display_unit = (item.product.id == 1) ? "10cc" : item.product.display_unit
                    
                    # 単価計算
                    if item.product.respond_to?(:category) && item.product.category == 'wott'
                      unit_price = item.product.wott_price_for(current_user.wott_level_symbol) || 0
                    else
                      unit_price = item.product.price_for(current_user.level_symbol) || 0
                    end
                    
                    # 骨髄幹細胞培養上清液（ID: 1）の場合は10cc単位で表示（5倍）
                    display_unit_price = (item.product.id == 1) ? (unit_price * 5) : unit_price
                    # 小計計算
                    item_subtotal = display_unit_price * display_quantity
                  %>
                  <tr>
                    <td>
                      <h6 class="mb-1"><%= item.product.name %></h6>
                      <small class="text-muted">単位: <%= display_unit %></small>
                    </td>
                    <td class="text-center">
                      <%= form_with url: update_item_cart_path, method: :patch, local: true, class: "d-inline" do |f| %>
                        <%= f.hidden_field :cart_item_id, value: item.id %>
                        <%= f.hidden_field :product_id, value: item.product.id %>
                        <% 
                          # WOTT商品またはMANNERSSOUND商品の場合は5個まで、その他は10個まで
                          max_quantity = (['wott', 'ms'].include?(item.product.category)) ? 5 : 10
                          
                          # 骨髄幹細胞培養上清液の場合は、選択肢の値も5倍にする（内部保存用）
                          if item.product.id == 1
                            quantity_options = (1..max_quantity).map { |i| [i, i * 5] }
                          else
                            quantity_options = (1..max_quantity).map { |i| [i, i] }
                          end
                        %>
                        <%= f.select :quantity, options_for_select(quantity_options, item.quantity), 
                            {}, { class: "form-select form-select-sm", onchange: "this.form.submit();", style: "width: 80px;" } %>
                      <% end %>
                    </td>
                    <td class="text-end">
                      ¥<%= number_with_delimiter(display_unit_price) %>
                    </td>
                    <td class="text-end">
                      <strong>¥<%= number_with_delimiter(item_subtotal) %></strong>
                    </td>
                    <td>
                      <%= form_with url: update_delivery_cart_path, method: :patch, local: true, class: "delivery-form" do |f| %>
                        <%= f.hidden_field :cart_item_id, value: item.id %>
                        
                        <% 
                          # デフォルトの配送先を設定
                          default_delivery_type = item.delivery_type || (item.product.id == 1 ? 'clinic' : 'home')
                        %>
                        
                        <div class="mb-2">
                          <div class="form-check form-check-inline">
                            <%= f.radio_button :delivery_type, 'clinic', 
                                checked: (default_delivery_type == 'clinic'),
                                class: "form-check-input delivery-type-radio",
                                data: { item_id: item.id },
                                onchange: "updateDeliveryType(this, #{item.id});" %>
                            <label class="form-check-label small">
                              <i class="fas fa-hospital text-primary"></i> クリニック
                            </label>
                          </div>
                          <div class="form-check form-check-inline">
                            <%= f.radio_button :delivery_type, 'home', 
                                checked: (default_delivery_type == 'home'),
                                class: "form-check-input delivery-type-radio",
                                data: { item_id: item.id },
                                onchange: "updateDeliveryType(this, #{item.id});" %>
                            <label class="form-check-label small">
                              <i class="fas fa-home text-success"></i> 住所
                            </label>
                          </div>
                          <div class="form-check form-check-inline">
                            <%= f.radio_button :delivery_type, 'other', 
                                checked: (default_delivery_type == 'other'),
                                class: "form-check-input delivery-type-radio",
                                data: { item_id: item.id },
                                onchange: "updateDeliveryType(this, #{item.id});" %>
                            <label class="form-check-label small">
                              <i class="fas fa-map-marker-alt text-warning"></i> その他へ送る
                            </label>
                          </div>
                        </div>
                        
                        <% 
                          # クリニック情報を取得
                          clinic_level = Level.find_by(name: 'クリニック')
                          clinics = clinic_level ? User.joins(:invoice_base).where(level: clinic_level).includes(:invoice_base) : []
                        %>
                        
                        <!-- クリニック選択 -->
                        <div class="clinic-selection" id="clinic-selection-<%= item.id %>" style="<%= 'display: none;' unless default_delivery_type == 'clinic' %>">
                          <%= f.select :clinic_id, 
                              options_for_select(
                                clinics.map { |c| [c.name, c.id] },
                                item.clinic_id
                              ),
                              { prompt: 'クリニックを選択' },
                              { class: "form-select form-select-sm", onchange: "this.form.submit();" } %>
                        </div>
                        
                        <!-- 住所選択 -->
                        <div class="address-selection" id="address-selection-<%= item.id %>" style="<%= 'display: none;' unless default_delivery_type == 'home' %>">
                          <% 
                            default_address_type = item.address_type || 'registration'
                          %>
                          <%= f.select :address_type,
                              options_for_select(
                                [['登録住所', 'registration'], ['配送先住所', 'shipping']],
                                default_address_type
                              ),
                              {},
                              { class: "form-select form-select-sm", onchange: "this.form.submit();" } %>
                        </div>
                        
                        <!-- その他の配送先入力 -->
                        <div class="other-delivery-form" id="other-delivery-<%= item.id %>" style="<%= 'display: none;' unless default_delivery_type == 'other' %>">
                          <div class="mt-2">
                            <% 
                              # その他配送が既に確定されているかチェック
                              is_other_confirmed = default_delivery_type == 'other' && 
                                                   item.other_recipient_name.present? && 
                                                   item.other_postal_code.present? && 
                                                   item.other_address.present? && 
                                                   item.other_phone_number.present?
                            %>
                            <div class="mb-2">
                              <%= f.text_field :other_recipient_name, 
                                  placeholder: "お届け先名", 
                                  value: item.other_recipient_name,
                                  class: "form-control form-control-sm other-delivery-input",
                                  required: default_delivery_type == 'other',
                                  readonly: is_other_confirmed %>
                            </div>
                            <div class="mb-2">
                              <%= f.text_field :other_postal_code, 
                                  placeholder: "郵便番号（例：1234567）", 
                                  value: item.other_postal_code,
                                  class: "form-control form-control-sm other-delivery-input",
                                  pattern: "[0-9]{7}",
                                  maxlength: "7",
                                  required: default_delivery_type == 'other',
                                  readonly: is_other_confirmed %>
                            </div>
                            <div class="mb-2">
                              <%= f.text_area :other_address, 
                                  placeholder: "住所", 
                                  value: item.other_address,
                                  class: "form-control form-control-sm other-delivery-input",
                                  rows: 2,
                                  required: default_delivery_type == 'other',
                                  readonly: is_other_confirmed %>
                            </div>
                            <div class="mb-2">
                              <%= f.text_field :other_phone_number, 
                                  placeholder: "電話番号（例：090-1234-5678）", 
                                  value: item.other_phone_number,
                                  class: "form-control form-control-sm other-delivery-input",
                                  required: default_delivery_type == 'other',
                                  readonly: is_other_confirmed %>
                            </div>
                            <div>
                              <% if is_other_confirmed %>
                                <button type="button" class="btn btn-success btn-sm w-100" disabled>
                                  <i class="fas fa-check me-1"></i>確定済み
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-1" onclick="enableOtherDeliveryEdit(<%= item.id %>)">
                                  <i class="fas fa-edit me-1"></i>編集
                                </button>
                              <% else %>
                                <%= f.submit "確定", class: "btn btn-primary btn-sm w-100", id: "confirm-btn-#{item.id}" %>
                              <% end %>
                            </div>
                          </div>
                        </div>
                      <% end %>
                    </td>
                    <td class="text-end">
                      <%= form_with url: remove_item_cart_path, method: :delete, local: true, class: "d-inline" do |f| %>
                        <%= f.hidden_field :cart_item_id, value: item.id %>
                        <%= f.submit "削除", class: "btn btn-outline-danger btn-sm", 
                            data: { confirm: "この商品をカートから削除しますか？" } %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            

            
            <!-- カート合計と購入ボタン -->
            <div class="row mt-4">
              <div class="col-md-8">
                <div class="alert alert-info">
                  <h6><i class="fas fa-info-circle me-2"></i>配送先について</h6>
                  <ul class="mb-0 small">
                    <li><strong>骨髄幹細胞培養上清液</strong> → クリニック配送（事務手数料¥10,000）</li>
                    <li><strong>その他の商品</strong> → ご登録住所配送</li>
                    <li>配送先ごとに送料¥6,000がかかります</li>
                  </ul>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card">
                  <div class="card-body">
                    <% 
                      # 基本料金計算
                      subtotal = @cart.total_amount_for_user(current_user)
                      
                      # 配送先情報を計算（orders/checkoutと同じロジック）
                      delivery_destinations = []
                      clinic_ids = []
                      has_home_delivery = false
                      has_other_delivery = false
                      
                      @cart_items.each do |item|
                        delivery_type = item.delivery_type || (item.product.id == 1 ? 'clinic' : 'home')
                        
                        if delivery_type == 'clinic' && item.clinic_id.present?
                          clinic_ids << item.clinic_id unless clinic_ids.include?(item.clinic_id)
                        elsif delivery_type == 'home'
                          has_home_delivery = true
                        elsif delivery_type == 'other'
                          has_other_delivery = true
                        end
                      end
                      
                      # クリニック配送先を追加
                      clinic_ids.each do |clinic_id|
                        clinic = User.joins(:invoice_base).find_by(id: clinic_id)
                        if clinic&.invoice_base
                          delivery_destinations << {
                            title: "#{clinic.name}（クリニック配送）",
                            type: 'clinic'
                          }
                        end
                      end
                      
                      # 自宅配送先を追加
                      if has_home_delivery
                        delivery_destinations << {
                          title: "登録住所（自宅配送）",
                          type: 'home'
                        }
                      end
                      
                      # その他配送先を追加（重複を避けるため住所でグループ化）
                      if has_other_delivery
                        other_items = @cart_items.select { |item| item.delivery_type == 'other' }
                        unique_other_addresses = {}
                        
                        other_items.each do |item|
                          if item.other_postal_code.present? && item.other_address.present?
                            address_key = "#{item.other_postal_code}_#{item.other_address}"
                            unless unique_other_addresses.key?(address_key)
                              unique_other_addresses[address_key] = {
                                title: "#{item.other_recipient_name || 'その他お届け先'}（その他配送）",
                                type: 'other'
                              }
                            end
                          end
                        end
                        
                        delivery_destinations.concat(unique_other_addresses.values)
                      end
                      
                      # 配送先数と送料を計算
                      delivery_count = delivery_destinations.size
                      shipping_fee = delivery_count * 6000
                      has_stem_cell_product = clinic_ids.any?
                      admin_fee = has_stem_cell_product ? 10000 : 0
                      
                      # 税抜き合計
                      subtotal_before_tax = subtotal + shipping_fee + admin_fee
                      # 消費税計算
                      tax_amount = calculate_tax(subtotal_before_tax)
                      # 税込み合計
                      total_amount_with_tax = subtotal_before_tax + tax_amount
                    %>
                    
                    <div class="d-flex justify-content-between mb-2">
                      <span>商品数:</span>
                      <span><%= @cart.total_items %>個</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>商品代金:</span>
                      <span>¥<%= number_with_delimiter(subtotal) %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>送料:</span>
                      <span>¥<%= number_with_delimiter(shipping_fee) %></span>
                    </div>
                    <% if admin_fee > 0 %>
                      <div class="d-flex justify-content-between mb-2">
                        <span>事務手数料:</span>
                        <span class="text-warning">¥<%= number_with_delimiter(admin_fee) %></span>
                      </div>
                    <% end %>
                    <div class="d-flex justify-content-between mb-2">
                      <span>消費税（<%= tax_rate_percentage %>%）:</span>
                      <span>¥<%= number_with_delimiter(tax_amount) %></span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                      <strong>合計:</strong>
                      <strong class="text-success">¥<%= number_with_delimiter(total_amount_with_tax) %></strong>
                    </div>
                    
                    <%= form_with url: orders_checkout_path, method: :get, local: true do |f| %>
                      <% @cart_items.each do |item| %>
                        <%= f.hidden_field "items[#{item.id}][delivery_type]", value: item.delivery_type || (item.product.id == 1 ? 'clinic' : 'home') %>
                        <%= f.hidden_field "items[#{item.id}][clinic_id]", value: item.clinic_id if item.clinic_id.present? %>
                        <%= f.hidden_field "items[#{item.id}][address_type]", value: item.address_type || 'registration' %>
                        <% if item.delivery_type == 'other' %>
                          <%= f.hidden_field "items[#{item.id}][other_recipient_name]", value: item.other_recipient_name %>
                          <%= f.hidden_field "items[#{item.id}][other_postal_code]", value: item.other_postal_code %>
                          <%= f.hidden_field "items[#{item.id}][other_address]", value: item.other_address %>
                          <%= f.hidden_field "items[#{item.id}][other_phone_number]", value: item.other_phone_number %>
                        <% end %>
                      <% end %>
                      <%= f.submit "購入手続きへ", class: "btn btn-success btn-lg w-100" %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="alert alert-info text-center">
      <h4>カートは空です</h4>
      <p>商品を選んでカートに追加してください。</p>
      <%= link_to "商品一覧を見る", orders_products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
