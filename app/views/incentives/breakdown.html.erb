<% content_for :title, "インセンティブ明細 - #{@target_user.display_name}" %>

<div class="container incentive-container">
  <div class="row">
    <div class="col-12">
      <!-- パンくずリスト -->
      <nav aria-label="breadcrumb" class="breadcrumb-custom">
        <ol class="breadcrumb">
          <li class="breadcrumb-item">
            <%= link_to incentives_path(target_month: @target_month) do %>
              <i class="fas fa-chart-line me-1"></i>インセンティブ
            <% end %>
          </li>
          <li class="breadcrumb-item active" aria-current="page">
            <%= @target_user.display_name %>の明細
          </li>
        </ol>
      </nav>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">
          <i class="fas fa-list-alt me-2"></i>インセンティブ明細 - <%= @target_user.display_name %>
        </h4>
        <div class="flex-shrink-0">
          <%= link_to incentives_path(target_month: @target_month), class: "btn btn-outline-secondary btn-sm" do %>
            <i class="fas fa-arrow-left me-1"></i>一覧に戻る
          <% end %>
        </div>
      </div>
      
      <!-- インセンティブサマリー -->
      <div class="row mb-4">
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <h6 class="text-muted">ユーザー情報</h6>
              <p><strong>名前:</strong> <%= @target_user.name %></p>
              <p><strong>レベル:</strong> <span class="badge bg-secondary"><%= @target_user.level_label %></span></p>
              <p><strong>期間:</strong> <%= @start_date.strftime("%Y年%m月%d日") %> 〜 <%= @end_date.strftime("%Y年%m月%d日") %></p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card incentive-summary-card h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <div class="text-center mb-3">
                <h5 class="mb-0">
                  <i class="fas fa-calendar-alt me-2"></i>
                  インセンティブ合計（<%= @target_date.strftime("%Y年%m月") %>）
                </h5>
              </div>
              <div class="text-end">
                <div class="summary-item">
                  <div class="summary-value text-success">¥<%= number_with_delimiter(@incentive_summary[:total_incentive]) %></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>



      <!-- ユーザーの商品単価 -->
      <div class="alert alert-info mb-4">
        <i class="fas fa-tag me-2"></i><strong><%= @target_user.display_name %>の商品単価:</strong>
        <% @user_product_prices.each_with_index do |price_info, index| %>
          <%= price_info[:product].display_name %>: ¥<%= number_with_delimiter(price_info[:price]) %><%= index < @user_product_prices.length - 1 ? ' / ' : '' %>
        <% end %>
      </div>

      <!-- 購入明細 -->
      <% 
        # 自己購入を除外した購入明細を取得し、購入日で昇順ソート（古いものから）
        descendant_details = @detailed_incentives.dig(:details, :purchase_details)&.select { |d| d[:category] == 'descendant_sales' }&.sort_by { |d| d[:purchase_date] } || []
        total_incentive = descendant_details.sum { |d| d[:total_incentive] || 0 }
      %>
      <% if descendant_details.any? %>
        <div class="card">
          <div class="card-header">
            <h6 class="mb-0">
              <i class="fas fa-shopping-cart me-2"></i>購入明細
            </h6>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>購入日</th>
                    <th>購入者</th>
                    <th>商品名</th>
                    <th class="text-end">購入者単価</th>
                    <th>直下ユーザー</th>
                    <th class="text-end">直下ユーザー単価</th>
                    <th class="text-end">数量</th>
                    <th class="text-end">インセンティブ単価</th>
                    <th class="text-end">インセンティブ合計</th>
                  </tr>
                </thead>
                <tbody>
                  <% descendant_details.each do |detail| %>
                    <tr>
                      <td><%= detail[:purchase_date]&.strftime("%Y/%m/%d") %></td>
                      <td><%= detail[:purchaser_display_name] %></td>
                      <td><%= detail[:product_name] %></td>
                      <td class="text-end">¥<%= number_with_delimiter(detail[:calculation_details][:purchaser_price]) %></td>
                      <td><%= detail[:direct_referral_display_name] || '-' %></td>
                      <td class="text-end">¥<%= number_with_delimiter(detail[:direct_referral_price]) %></td>
                      <td class="text-end"><%= detail[:quantity] %></td>
                      <td class="text-end">¥<%= number_with_delimiter(detail[:incentive_unit_price]) %></td>
                      <td class="text-end text-success">¥<%= number_with_delimiter(detail[:total_incentive]) %></td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot>
                  <tr class="table-primary fw-bold">
                    <td colspan="8" class="text-end">合計</td>
                    <td class="text-end text-success">¥<%= number_with_delimiter(total_incentive) %></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      <% else %>
        <div class="card">
          <div class="card-body text-center py-5">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">購入明細がありません</h5>
            <p class="text-muted">この期間中の下位ユーザーの購入実績はありません。</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
.breakdown-item {
  padding: 1rem;
  border: 1px solid #dee2e6;
  border-radius: 0.375rem;
  text-align: center;
  margin-bottom: 1rem;
}

.breakdown-label {
  font-size: 0.9rem;
  color: #6c757d;
  margin-bottom: 0.5rem;
}

.breakdown-value {
  font-size: 1.5rem;
  font-weight: bold;
}

.incentive-summary-card .summary-value {
  font-size: 2rem;
  font-weight: bold;
}

.table th {
  font-weight: 600;
  font-size: 0.9rem;
}

.table td {
  font-size: 0.9rem;
}
</style>