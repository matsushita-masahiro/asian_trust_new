<div class="hierarchy-row level-<%= level %>">
  <%= link_to user_path(hierarchy_data[:user]), class: "user-node-link" do %>
    <div class="user-node">
      <div class="user-name">
        <%= hierarchy_data[:user].name %>
        
        <% # 幹細胞レベル（アドバイザー側）を先に表示 %>
        <% if hierarchy_data[:user].level %>
          <span class="badge <%= level_badge_class(hierarchy_data[:user].level.name) %> ms-2" style="font-size: 0.5rem; padding: 0.2rem 0.4rem;">
            <i class="fas fa-user-tie me-1"></i><%= hierarchy_data[:user].level.name %>（幹細胞）
          </span>
        <% end %>
        
        <% # WOTTレベル（お客様側）を後に表示 %>
        <% if hierarchy_data[:user].wott_level %>
          <span class="badge <%= wott_level_badge_class(hierarchy_data[:user].wott_level.name) %> ms-1" style="font-size: 0.5rem; padding: 0.2rem 0.4rem; opacity: 0.85;">
            <i class="fas fa-shopping-cart me-1"></i><%= hierarchy_data[:user].wott_level.name %>（WOTT）
          </span>
        <% end %>
      </div>
      
      <div class="user-stats">
        <small class="text-muted">
          <i class="fas fa-users me-1"></i>
          直下: <%= hierarchy_data[:children].count %>名
          <% if hierarchy_data[:children].any? %>
            | 全下位: <%= count_all_descendants(hierarchy_data[:user]) %>名
          <% end %>
        </small>
      </div>
    </div>
  <% end %>
  
  <% if hierarchy_data[:children].any? %>
    <div class="children-container">
      <% hierarchy_data[:children].each do |child_data| %>
        <%= render 'hierarchy_node', hierarchy_data: child_data, level: level + 1 %>
      <% end %>
    </div>
  <% end %>
</div>