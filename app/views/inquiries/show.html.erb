<div class="container mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <h4 class="text-primary mb-4">
        <i class="fas fa-envelope me-2"></i>
        お問合せ詳細
      </h4>

      <div class="card mb-4">
        <div class="card-header bg-light">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">お問合せ内容</h5>
            <small class="text-muted">
              <%= @inquiry.created_at.strftime('%Y年%m月%d日 %H:%M') %>
            </small>
          </div>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <strong>お名前:</strong> <%= @inquiry.name %>
          </div>
          <div class="mb-3">
            <strong>メールアドレス:</strong> <%= @inquiry.email %>
          </div>
          <% if @inquiry.phone.present? %>
            <div class="mb-3">
              <strong>電話番号:</strong> <%= @inquiry.phone %>
            </div>
          <% end %>
          <div class="mb-3">
            <strong>お問合せ内容:</strong>
            <div class="mt-2 p-3 bg-light rounded">
              <%= simple_format(@inquiry.message) %>
            </div>
          </div>
        </div>
      </div>

      <% if @inquiry.answers.any? %>
        <h5 class="text-success mb-3">
          <i class="fas fa-reply me-2"></i>
          事務局からの回答
        </h5>
        <% @inquiry.answers.order(created_at: :asc).each do |answer| %>
          <div class="card mb-3">
            <div class="card-header bg-success text-white">
              <div class="d-flex justify-content-between align-items-center">
                <span><i class="fas fa-user-tie me-2"></i>事務局</span>
                <small><%= answer.created_at.strftime('%Y年%m月%d日 %H:%M') %></small>
              </div>
            </div>
            <div class="card-body">
              <%= simple_format(answer.content) %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info">
          <i class="fas fa-info-circle me-2"></i>
          まだ回答がありません。事務局からの回答をお待ちください。
        </div>
      <% end %>

      <div class="mt-4 text-center">
        <%= link_to "お問合せ履歴に戻る", inquiries_path, class: "btn btn-outline-primary me-2" %>
        <%= link_to "マイページに戻る", mypage_users_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>
