<% content_for :title, "階層図 - #{current_user.display_name}" %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4" style="margin-top: 80px;">
        <h4 class="text-primary">
          <i class="fas fa-sitemap me-2"></i>
          <%= current_user.display_name %>の階層図
        </h4>
      </div>
    </div>
  </div>

  <!-- 統計情報 -->
  <div class="row mb-4">
    <div class="col-md-4 mb-3">
      <div class="card bg-primary text-white">
        <div class="card-body text-center py-4">
          <h6 class="card-title">直下ユーザー数</h6>
          <h3 class="mb-0"><%= current_user.referrals.count %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body text-center py-4">
          <h6 class="card-title">全下位ユーザー数</h6>
          <h3 class="mb-0"><%= count_all_descendants(current_user) %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card bg-info text-white">
        <div class="card-body text-center py-4">
          <h6 class="card-title">階層レベル</h6>
          <h3 class="mb-0"><%= current_user.level&.name || "未設定" %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- 階層図 -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="fas fa-users me-2"></i>
            下位ユーザー構造図
          </h5>
        </div>
        <div class="card-body">
          <% if current_user.referrals.any? %>
            <div class="hierarchy-container-vertical">
              <!-- 自分のノード -->
              <div class="hierarchy-row level-0">
                <div class="user-node current-user">
                  <div class="user-name">
                    <%= current_user.display_name %>
                    
                    <% # 幹細胞レベル（アドバイザー側）を先に表示 %>
                    <% if current_user.level %>
                      <span class="badge <%= level_badge_class(current_user.level.name) %> ms-2" style="font-size: 0.5rem; padding: 0.2rem 0.4rem;">
                        <i class="fas fa-user-tie me-1"></i><%= current_user.level.name %>（幹細胞）
                      </span>
                    <% end %>
                    
                    <% # WOTTレベル（お客様側）を後に表示 %>
                    <% if current_user.wott_level %>
                      <span class="badge <%= wott_level_badge_class(current_user.wott_level.name) %> ms-1" style="font-size: 0.5rem; padding: 0.2rem 0.4rem; opacity: 0.85;">
                        <i class="fas fa-shopping-cart me-1"></i><%= current_user.wott_level.name %>（WOTT）
                      </span>
                    <% end %>
                  </div>
                  <div class="user-stats">
                    <small class="text-muted">
                      <i class="fas fa-users me-1"></i>
                      直下: <%= current_user.referrals.count %>名 | 
                      全下位: <%= count_all_descendants(current_user) %>名
                    </small>
                  </div>
                </div>
              </div>
              
              <!-- 下位ユーザーの階層 -->
              <div class="children-container">
                <% current_user.referrals.order(:id).each do |child| %>
                  <%= render 'hierarchy_node', hierarchy_data: build_hierarchy_node(child), level: 1 %>
                <% end %>
              </div>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-users fa-3x text-muted mb-3"></i>
              <h5 class="text-muted">下位ユーザーがいません</h5>
              <p class="text-muted">まだ誰も紹介していないか、紹介したユーザーが登録を完了していません。</p>
              <% if current_user.level&.value && ![4, 5, 7].include?(current_user.level.value) %>
                <%= link_to referrals_path, class: "btn btn-primary" do %>
                  <i class="fas fa-user-plus me-2"></i>
                  ユーザーを紹介する
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>


<% content_for :javascript do %>
<script>
  // 階層図の展開/折りたたみ機能（将来的に追加可能）
  document.addEventListener('DOMContentLoaded', function() {
    console.log('階層図が読み込まれました');
  });
</script>
<% end %>