<div class="container py-5 pt-5">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-primary">⚙️ 請求書情報設定</h3>
      </div>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-light">
          <h5 class="mb-0">請求元情報を設定</h5>
        </div>
        <div class="card-body">
          <!-- 請求元情報設定フォーム -->
          <h6 class="text-muted mb-3">あなたの会社情報（請求書に記載される情報）</h6>
          <%= form_with model: @invoice_base, url: settings_invoices_path, method: :post, local: true, class: "needs-validation", novalidate: true do |f| %>
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :company_name, "会社名", class: "form-label" %>
                <%= f.text_field :company_name, class: "form-control", 
                    value: @invoice_base.company_name.presence || current_user.name, 
                    placeholder: "株式会社サンプル", required: true %>
                <div class="invalid-feedback">
                  会社名を入力してください。
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :department, "部署", class: "form-label" %>
                <%= f.text_field :department, class: "form-control" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :email, "メールアドレス", class: "form-label" %>
              <%= f.email_field :email, class: "form-control", 
                  value: @invoice_base.email.presence || current_user.email, 
                  placeholder: "info@example.com" %>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <%= f.label :postal_code, "郵便番号", class: "form-label" %>
                <div class="input-group">
                  <%= f.text_field :postal_code, class: "form-control", placeholder: "150-0045", id: "postal_code_field" %>
                  <button type="button" class="btn btn-outline-secondary" id="address_search_btn">
                    <i class="fas fa-search"></i> 住所検索
                  </button>
                </div>
                <div class="form-text">郵便番号を入力すると自動で住所が入力されます</div>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :address, "住所", class: "form-label" %>
              <%= f.text_area :address, class: "form-control", rows: 2, placeholder: "東京都千代田区千代田1-1-1", required: true, id: "address_field" %>
              <div class="invalid-feedback">
                住所を入力してください。
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :notes, "備考", class: "form-label" %>
              <%= f.text_area :notes, class: "form-control", rows: 3, placeholder: "その他の情報や備考を入力してください" %>
            </div>

            <!-- 振込先情報セクション -->
            <h6 class="text-muted mb-3 mt-4">振込先情報</h6>
            
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :bank_name, "銀行名", class: "form-label" %>
                <%= f.text_field :bank_name, class: "form-control", placeholder: "○○銀行" %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :bank_branch_name, "支店名", class: "form-label" %>
                <%= f.text_field :bank_branch_name, class: "form-control", placeholder: "○○支店" %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :bank_account_type, "口座種別", class: "form-label" %>
                <%= f.select :bank_account_type, 
                    options_for_select([
                      ['普通', 'savings'],
                      ['当座', 'checking']
                    ], @invoice_base.bank_account_type), 
                    { prompt: '選択してください' }, 
                    { class: "form-select" } %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :bank_account_number, "口座番号", class: "form-label" %>
                <%= f.text_field :bank_account_number, class: "form-control", placeholder: "1234567" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :bank_account_name, "口座名義", class: "form-label" %>
              <%= f.text_field :bank_account_name, class: "form-control", placeholder: "カ）サンプル" %>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <%= link_to "キャンセル", invoices_path, class: "btn btn-outline-secondary me-md-2" %>
              <%= f.submit "請求元情報を保存", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Bootstrap form validation
(function() {
  'use strict';
  window.addEventListener('load', function() {
    var forms = document.getElementsByClassName('needs-validation');
    var validation = Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  }, false);
})();

// 郵便番号から住所を自動取得
document.addEventListener('DOMContentLoaded', function() {
  const postalCodeField = document.getElementById('postal_code_field');
  const addressField = document.getElementById('address_field');
  const searchBtn = document.getElementById('address_search_btn');

  // 郵便番号フォーマット関数
  function formatPostalCode(value) {
    const digitsOnly = value.replace(/\D/g, '');
    if (digitsOnly.length === 7) {
      return digitsOnly.slice(0, 3) + '-' + digitsOnly.slice(3);
    }
    return value;
  }

  // 住所検索関数
  async function searchAddress(postalCode) {
    const formattedCode = formatPostalCode(postalCode);
    const digitsOnly = formattedCode.replace(/\D/g, '');
    
    if (digitsOnly.length !== 7) {
      alert('郵便番号は7桁で入力してください');
      return;
    }

    try {
      searchBtn.disabled = true;
      searchBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 検索中...';
      
      // 郵便番号APIを使用（zipcloud.ibsnet.co.jp）
      const response = await fetch(`https://zipcloud.ibsnet.co.jp/api/search?zipcode=${digitsOnly}`);
      const data = await response.json();
      
      if (data.status === 200 && data.results && data.results.length > 0) {
        const result = data.results[0];
        const fullAddress = result.address1 + result.address2 + result.address3;
        
        // 郵便番号をフォーマットして設定
        postalCodeField.value = formattedCode;
        // 住所を設定
        addressField.value = fullAddress;
        
        // 成功メッセージ
        showMessage('住所を自動入力しました', 'success');
      } else {
        showMessage('該当する住所が見つかりませんでした', 'warning');
      }
    } catch (error) {
      console.error('住所検索エラー:', error);
      showMessage('住所検索に失敗しました', 'danger');
    } finally {
      searchBtn.disabled = false;
      searchBtn.innerHTML = '<i class="fas fa-search"></i> 住所検索';
    }
  }

  // メッセージ表示関数
  function showMessage(message, type) {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show mt-2`;
    alertDiv.innerHTML = `
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    postalCodeField.parentNode.parentNode.appendChild(alertDiv);
    
    // 3秒後に自動で消す
    setTimeout(() => {
      if (alertDiv.parentNode) {
        alertDiv.remove();
      }
    }, 3000);
  }

  // 検索ボタンクリック時
  searchBtn.addEventListener('click', function() {
    const postalCode = postalCodeField.value.trim();
    if (postalCode) {
      searchAddress(postalCode);
    } else {
      alert('郵便番号を入力してください');
    }
  });

  // 郵便番号入力時の自動フォーマット
  postalCodeField.addEventListener('input', function() {
    this.value = formatPostalCode(this.value);
  });

  // Enterキーで検索
  postalCodeField.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      searchBtn.click();
    }
  });
});
</script>