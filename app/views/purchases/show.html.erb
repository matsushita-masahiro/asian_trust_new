<div class="container-fluid mt-5">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-primary">🛒 購入詳細</h4>
        <div>
          <%= link_to "購入履歴に戻る", my_history_purchases_path, class: "btn btn-outline-secondary me-2" %>
          <%= link_to "マイページに戻る", mysales_path, class: "btn btn-outline-primary" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- 購入情報 -->
    <div class="col-md-4 mb-4">
      <div class="card">
        <div class="card-header bg-light">
          <h5 class="card-title mb-0">📋 購入情報</h5>
        </div>
        <div class="card-body">
          <table class="table table-borderless">
            <tr>
              <th width="40%">購入日時:</th>
              <td>
                <div><%= @purchase.purchased_at.strftime("%Y年%m月%d日") %></div>
                <small class="text-muted"><%= @purchase.purchased_at.strftime("%H:%M") %></small>
              </td>
            </tr>
            <tr>
              <th>購入ID:</th>
              <td><span class="badge bg-secondary">#<%= @purchase.id %></span></td>
            </tr>
            <tr>
              <th>商品数:</th>
              <td><%= @total_items %>個</td>
            </tr>
            <tr>
              <th>商品代金:</th>
              <td>¥<%= number_with_delimiter(@items_total) %></td>
            </tr>
            <% if @shipping_fees_total > 0 %>
              <tr>
                <th>送料:</th>
                <td>¥<%= number_with_delimiter(@shipping_fees_total) %></td>
              </tr>
            <% end %>
            <% if @admin_fee > 0 %>
              <tr>
                <th>事務手数料:</th>
                <td>¥<%= number_with_delimiter(@admin_fee) %></td>
              </tr>
            <% end %>
            <tr>
              <th>消費税 (10%):</th>
              <td>¥<%= number_with_delimiter(@tax_amount) %></td>
            </tr>
            <tr>
              <th>合計金額:</th>
              <td>
                <span class="fw-bold text-success fs-5">
                  ¥<%= number_with_delimiter(@total_amount) %>
                </span>
              </td>
            </tr>
          </table>
        </div>
      </div>
    </div>

    <!-- 購入商品詳細 -->
    <div class="col-md-8 mb-4">
      <div class="card">
        <div class="card-header bg-light">
          <h5 class="card-title mb-0">🛍️ 購入商品詳細</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead class="table-light">
                <tr>
                  <th>商品名</th>
                  <th>単価</th>
                  <th>数量</th>
                  <th>小計</th>
                </tr>
              </thead>
              <tbody>
                <% @purchase_items.each do |item| %>
                  <tr>
                    <td>
                      <div class="fw-bold"><%= item.product.name %></div>
                      <% if item.product.description.present? %>
                        <small class="text-muted"><%= truncate(item.product.description, length: 50) %></small>
                      <% end %>
                    </td>
                    <td>
                      <span class="text-muted">¥<%= number_with_delimiter(item.seller_price) %></span>
                    </td>
                    <td>
                      <span class="badge bg-primary"><%= item.quantity %></span>
                    </td>
                    <td>
                      <span class="fw-bold">¥<%= number_with_delimiter(item.seller_price * item.quantity) %></span>
                    </td>
                  </tr>
                <% end %>
                
                <!-- 送料の表示 -->
                <% @shipping_fee_details.each do |fee_detail| %>
                  <tr class="table-secondary">
                    <td colspan="3" class="text-end">
                      <i class="fas fa-shipping-fast me-1"></i><%= fee_detail[:type_name] %>
                    </td>
                    <td><span class="fw-bold">¥<%= number_with_delimiter(fee_detail[:amount]) %></span></td>
                  </tr>
                <% end %>
                
                <!-- 事務手数料の表示 -->
                <% if @admin_fee > 0 %>
                  <tr class="table-secondary">
                    <td colspan="3" class="text-end">
                      <i class="fas fa-file-invoice me-1"></i>事務手数料
                    </td>
                    <td><span class="fw-bold">¥<%= number_with_delimiter(@admin_fee) %></span></td>
                  </tr>
                <% end %>
                
                <!-- 消費税の表示 -->
                <tr class="table-secondary">
                  <td colspan="3" class="text-end">
                    <i class="fas fa-percent me-1"></i>消費税 (10%)
                  </td>
                  <td><span class="fw-bold">¥<%= number_with_delimiter(@tax_amount) %></span></td>
                </tr>
              </tbody>
              <tfoot class="table-light">
                <tr>
                  <th colspan="2">合計</th>
                  <th><%= @total_items %>個</th>
                  <th class="text-success fw-bold">¥<%= number_with_delimiter(@total_amount) %></th>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 購入履歴の月別サマリー -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-light">
          <h5 class="card-title mb-0">📊 <%= @purchase.purchased_at.strftime('%Y年%m月') %>の購入サマリー</h5>
        </div>
        <div class="card-body">
          <% 
            # 同月の購入履歴を取得
            month_start = @purchase.purchased_at.beginning_of_month
            month_end = @purchase.purchased_at.end_of_month
            month_purchases = current_user.purchases.where(purchased_at: month_start..month_end)
            month_total_amount = month_purchases.sum(&:total_price)
            month_total_count = month_purchases.count
            month_total_items = month_purchases.joins(:purchase_items).sum('purchase_items.quantity')
          %>
          
          <div class="row text-center">
            <div class="col-md-4">
              <div class="border rounded p-3">
                <h6 class="text-muted">月間購入回数</h6>
                <h4 class="text-primary"><%= month_total_count %>回</h4>
              </div>
            </div>
            <div class="col-md-4">
              <div class="border rounded p-3">
                <h6 class="text-muted">月間購入商品数</h6>
                <h4 class="text-success"><%= month_total_items %>個</h4>
              </div>
            </div>
            <div class="col-md-4">
              <div class="border rounded p-3">
                <h6 class="text-muted">月間購入金額</h6>
                <h4 class="text-info">¥<%= number_with_delimiter(month_total_amount) %></h4>
              </div>
            </div>
          </div>
          
          <div class="mt-3 text-center">
            <%= link_to "#{@purchase.purchased_at.strftime('%Y年%m月')}の全購入履歴を見る", 
                my_history_purchases_path(month: @purchase.purchased_at.strftime('%Y-%m')), 
                class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>