<div id="sales-index">
  <div class="container" style="margin-top: 20px; padding-top: 20px;">
  
    <!-- 年月度プルダウン（固定） -->
    <div class="sticky-top bg-white month-selector-wrapper" style="z-index: 1020;">
      <%= render 'shared/month_selector' %>
    </div>
  
    <!-- ヘッダー -->
    <div class="bg-light p-3 rounded shadow-sm mb-4">
      <h4 class="mb-2 fw-bold text-dark"><%= @user.display_name %>の売上明細</h4>
      <div class="text-muted fs-6">
        📅 （<%= @selected_month %>）販売履歴
      </div>
    </div>
  
    <!-- ユーザーの商品単価 -->
    <div class="alert alert-info mb-4">
      <i class="fas fa-tag me-2"></i><strong><%= @user.name %>の商品単価:</strong>
      <% @user_product_prices.each_with_index do |price_info, index| %>
        <%= price_info[:product].display_name %>: ¥<%= number_with_delimiter(price_info[:price]) %><%= index < @user_product_prices.length - 1 ? ' / ' : '' %>
      <% end %>
    </div>

    <% if @purchases.any? %>
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle text-nowrap">
          <thead class="table-secondary text-white">
            <tr>
              <th>販売店</th>
              <th>購入者名</th>
              <th>商品名</th>
              <th class="text-end">購入者単価（円）</th>
              <th class="text-end">数量</th>
              <th class="text-end">合計（円）</th>
              <th class="text-end" style="width: 100px;">インセン単価（¥）</th>
              <th class="text-end" style="width: 100px;">インセン小計（¥）</th>
              <th>購入日</th>
            </tr>
          </thead>
          <tbody>
            <% @purchases.each do |purchase| %>
              <% purchase.purchase_items.each_with_index do |item, index| %>
                <% 
                  # 各アイテムに対するボーナスを個別計算
                  # @userの視点でインセンティブを計算
                  item_bonus = @user.bonus_for_purchase_item(item)
                %>
                <tr>
                  <% if index == 0 %>
                    <td rowspan="<%= purchase.purchase_items.count %>" class="fw-bold">
                      <% if purchase.user.bonus_eligible? %>
                        <!-- インセンティブ受給資格がある場合は空欄 -->
                        -
                      <% else %>
                        <!-- インセンティブ受給資格がない場合は紹介者（販売店）を表示 -->
                        <%= purchase.user.referrer&.display_name || '-' %>
                      <% end %>
                    </td>
                    <td rowspan="<%= purchase.purchase_items.count %>">
                      <% 
                        # WOTT商品が含まれているかチェック
                        has_wott_product = purchase.purchase_items.any? { |pi| pi.product.category == 'wott' }
                      %>
                      <% if has_wott_product && purchase.user.has_wott_level? %>
                        <%= purchase.user.name %>（<span class="text-info fw-bold"><%= purchase.user.wott_level_name %></span>）
                      <% else %>
                        <%= purchase.user.display_name %>
                      <% end %>
                    </td>
                  <% end %>
                  <td><%= item.product.display_name %></td>
                  <td class="text-end"><%= number_with_delimiter(item.seller_price) %></td>
                  <td class="text-end"><%= item.quantity %></td>
                  <td class="text-end text-danger fw-bold"><%= number_with_delimiter(item.seller_price * item.quantity) %></td>
                  <td class="text-end text-info fw-bold">
                    <% 
                      # インセンティブ単価を計算
                      incentive_unit = item_bonus > 0 ? (item_bonus.to_f / item.quantity).round : 0
                    %>
                    <%= number_with_delimiter(incentive_unit) %>
                  </td>
                  <td class="text-end text-success fw-bold"><%= number_with_delimiter(item_bonus) %></td>
                  <% if index == 0 %>
                    <td rowspan="<%= purchase.purchase_items.count %>"><%= purchase.purchased_at&.strftime("%Y/%m/%d") %></td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
  
            <!-- 合計行 -->
            <tr class="table-primary fw-bold text-end">
              <td colspan="5" class="text-end">合計</td>
              <td class="text-end text-danger"><%= number_with_delimiter(@total_sum) %></td>
              <td class="text-end"></td> <!-- インセンティブ単価列（空） -->
              <td class="text-end text-success"><%= number_with_delimiter(@total_bonus) %></td>
              <td></td> <!-- 購入日列（空） -->
            </tr>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted">今月の売上明細はありません。</p>
    <% end %>
  
    <!-- 戻るボタン -->
    <div class="mt-4 mb-5 text-center">
      <button onclick="history.back()" class="btn btn-outline-secondary btn-lg px-4">⬅ 戻る</button>
    </div>
  </div>

</div>
