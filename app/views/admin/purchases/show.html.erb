<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4" style="margin-top: 80px;">
        <h4 class="text-primary">購入詳細</h4>
        <%= link_to "← 購入履歴に戻る", admin_purchases_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">購入情報</h5>
        </div>
        <div class="card-body">
          <% 
            # purchase_invoiceがある場合は税込み金額を使用
            if @purchase.purchase_invoice&.total_with_tax.present? && @purchase.purchase_invoice.total_with_tax > 0
              total_with_tax = @purchase.purchase_invoice.total_with_tax
              # invoice内の詳細を使用
              seller_price_total = @purchase.purchase_items.sum { |item| item.quantity * (item.seller_price || item.unit_price) }
              shipping_fee = @purchase.purchase_invoice.shipping_fee || 0
              admin_fee = @purchase.purchase_invoice.admin_fee || 0
              tax_amount = @purchase.purchase_invoice.tax_amount || 0
            else
              # 従来の計算方法（税込み）
              seller_price_total = @purchase.purchase_items.sum { |item| item.quantity * (item.seller_price || item.unit_price) }
              shipping_fee = @purchase.total_shipping_fees
              admin_fee = @purchase.purchase_invoice&.admin_fee || 0
              subtotal_before_tax = seller_price_total + shipping_fee + admin_fee
              tax_amount = (subtotal_before_tax * 0.1).round  # 消費税10%
              total_with_tax = subtotal_before_tax + tax_amount
            end
          %>
          <div class="row mb-4">
            <div class="col-md-6">
              <table class="table table-borderless">
                <tr>
                  <th width="30%">購入ID:</th>
                  <td><%= @purchase.id %></td>
                </tr>
                <tr>
                  <th>購入者:</th>
                  <td><%= @purchase.user.name.present? ? @purchase.user.name : @purchase.user.email %></td>
                </tr>
                <tr>
                  <th>購入日:</th>
                  <td><%= @purchase.purchased_at.strftime("%Y年%m月%d日 %H:%M") %></td>
                </tr>
                <tr>
                  <th>ステータス:</th>
                  <td>
                    <% if @purchase.built? %>
                      <span class="badge bg-warning">入金待ち</span>
                    <% elsif @purchase.paid? %>
                      <span class="badge bg-success">支払い完了</span>
                    <% else %>
                      <span class="badge bg-secondary"><%= @purchase.status %></span>
                    <% end %>
                  </td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <div class="text-end">
                <div class="card border-0 bg-light">
                  <div class="card-body">
                    <h6 class="text-muted mb-2">料金詳細</h6>
                    <div class="d-flex justify-content-between mb-1">
                      <span>商品代金:</span>
                      <span>¥<%= number_with_delimiter(seller_price_total) %></span>
                    </div>
                    <% if shipping_fee > 0 %>
                      <div class="d-flex justify-content-between mb-1">
                        <span>送料:</span>
                        <span>¥<%= number_with_delimiter(shipping_fee) %></span>
                      </div>
                    <% end %>
                    <% if admin_fee > 0 %>
                      <div class="d-flex justify-content-between mb-1">
                        <span>事務手数料:</span>
                        <span class="text-warning">¥<%= number_with_delimiter(admin_fee) %></span>
                      </div>
                    <% end %>
                    <% if tax_amount > 0 %>
                      <div class="d-flex justify-content-between mb-1">
                        <span>消費税:</span>
                        <span>¥<%= number_with_delimiter(tax_amount) %></span>
                      </div>
                    <% end %>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between">
                      <strong>合計金額:</strong>
                      <strong class="text-primary">¥<%= number_with_delimiter(total_with_tax) %></strong>
                    </div>
                    <p class="text-muted small mb-0 mt-2">商品数: <%= @purchase.purchase_items.count %>点</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 商品一覧 -->
          <h6 class="mb-3">購入商品一覧</h6>
          <div class="table-responsive">
            <table class="table table-striped">
              <thead>
                <tr>
                  <th>商品名</th>
                  <th>数量</th>
                  <th>単価</th>
                  <th>小計</th>
                  <th>操作</th>
                </tr>
              </thead>
              <tbody>
                <% @purchase.purchase_items.each do |item| %>
                  <tr>
                    <td><%= item.product.name %></td>
                    <td><%= item.quantity %></td>
                    <td>¥<%= number_with_delimiter(item.seller_price || item.unit_price) %></td>
                    <td>¥<%= number_with_delimiter(item.quantity * (item.seller_price || item.unit_price)) %></td>
                    <td>
                      <%= link_to "編集", edit_admin_purchase_item_path(item), class: "btn btn-sm btn-outline-primary" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr>
                  <th colspan="3">商品代金計</th>
                  <th>¥<%= number_with_delimiter(seller_price_total) %></th>
                  <th></th>
                </tr>
                <% if shipping_fee > 0 %>
                  <tr>
                    <th colspan="3">送料</th>
                    <th>¥<%= number_with_delimiter(shipping_fee) %></th>
                    <th></th>
                  </tr>
                <% end %>
                <% if admin_fee > 0 %>
                  <tr>
                    <th colspan="3">事務手数料</th>
                    <th class="text-warning">¥<%= number_with_delimiter(admin_fee) %></th>
                    <th></th>
                  </tr>
                <% end %>
                <% if tax_amount > 0 %>
                  <tr>
                    <th colspan="3">消費税</th>
                    <th>¥<%= number_with_delimiter(tax_amount) %></th>
                    <th></th>
                  </tr>
                <% end %>
                <tr class="table-success">
                  <th colspan="3">合計金額</th>
                  <th class="text-success">¥<%= number_with_delimiter(total_with_tax) %></th>
                  <th></th>
                </tr>
              </tfoot>
            </table>
          </div>

          <!-- 入金確認ボタン / 請求書発行ボタン -->
          <% if @purchase.built? %>
            <% if @purchase.purchase_invoice&.receipt_requested? %>
              <div class="mt-4 text-center">
                <%= link_to "#", 
                    class: "btn btn-primary btn-lg",
                    data: { 
                      confirm: "請求書を発行しますか？\n\n購入者: #{@purchase.user.name.present? ? @purchase.user.name : @purchase.user.email}\n合計金額: ¥#{number_with_delimiter(total_with_tax)}" 
                    } do %>
                  <i class="fas fa-file-invoice me-2"></i>請求書発行する
                <% end %>
              </div>
            <% else %>
              <div class="mt-4 text-center">
                <%= link_to confirm_payment_admin_purchase_path(@purchase), 
                    method: :patch, 
                    class: "btn btn-success btn-lg",
                    data: { 
                      confirm: "この購入の入金を確認しますか？\n\n購入者: #{@purchase.user.name.present? ? @purchase.user.name : @purchase.user.email}\n合計金額: ¥#{number_with_delimiter(total_with_tax)}\n\n確認後、お客様にメールが送信されます。" 
                    } do %>
                  <i class="fas fa-check-circle me-2"></i>入金確認
                <% end %>
              </div>
            <% end %>
          <% elsif @purchase.paid? %>
            <% if @purchase.purchase_invoice&.status == 4 %>
              <div class="mt-4 text-center">
                <%= link_to "#", 
                    class: "btn btn-info btn-lg",
                    data: { 
                      confirm: "領収書を発行しますか？\n\n購入者: #{@purchase.user.name.present? ? @purchase.user.name : @purchase.user.email}\n合計金額: ¥#{number_with_delimiter(total_with_tax)}" 
                    } do %>
                  <i class="fas fa-receipt me-2"></i>領収書発行する
                <% end %>
              </div>
            <% elsif @purchase.purchase_invoice&.status == 5 %>
              <div class="mt-4 text-center">
                <span class="badge bg-info fs-6 p-3">
                  <i class="fas fa-receipt me-2"></i>領収書発行完了
                </span>
              </div>
            <% else %>
              <div class="mt-4 text-center">
                <span class="badge bg-success fs-6 p-3">
                  <i class="fas fa-check-circle me-2"></i>入金確認済み
                </span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>