<nav class="navbar navbar-expand-lg navbar-dark fixed-top" data-turbo-permanent style="background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%); backdrop-filter: blur(10px); box-shadow: 0 4px 20px rgba(0,0,0,0.3);"
  <div class="container-fluid">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
      <%= image_tag "abt_logo.png", alt: "ABT Logo", class: "navbar-logo me-3" %>
      <%= ENV['APRICATION_NAME'] %>
    <% end %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <% unless current_user.admin? %>
            <li class="nav-item">
              <%= link_to "予約・注文", orders_path, class: "nav-link" %>
            </li>
          <% end %>
          <% if user_signed_in? && !current_user.admin %>
            <li class="nav-item">
              <%= link_to "請求書管理", invoices_path, class: "nav-link" %>
            </li>
          <% end %>
          <% if user_signed_in? && !current_user.admin? && current_user.bonus_eligible? %>
            <li class="nav-item">
              <%= link_to "インセンティブ", incentives_path, class: "nav-link" %>
            </li>
          <% end %>
          <% if user_signed_in? && !current_user.admin? && current_user.referrals.any? %>
            <li class="nav-item">
              <%= link_to "階層図", hierarchy_path, class: "nav-link" %>
            </li>
          <% end %>

          <li class="nav-item custom-dropdown">
            <a class="nav-link custom-dropdown-toggle" href="#" id="mypageDropdown" role="button">
              マイページ <i class="fas fa-chevron-down ms-1"></i>
            </a>
            <ul class="custom-dropdown-menu" id="mypageDropdownMenu">
              <li><%= link_to "マイアカウント", user_path(current_user), class: "custom-dropdown-item" %></li>
              <li>
                <% if current_user.level.value == 7 %>
                  <%= link_to "購入情報", mysales_path, class: "custom-dropdown-item" %>
                <% else %>
                  <%= link_to "売上情報", mysales_path, class: "custom-dropdown-item" %>
                <% end %>
              </li>
              <% if current_user&.level&.value && ![4, 5, 7].include?(current_user.level.value) %>
                <li><%= link_to "紹介機能", referrals_path, class: "custom-dropdown-item" %></li>
              <% end %>
            </ul>
          </li>
          <li class="nav-item">
            <%= link_to "ログアウト", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "nav-link" %>
          </li>
          <% if current_user.admin? || current_user.level&.value == 0 %>
            <li class="nav-item">
              <%= link_to "ダッシュボード", admin_root_path, class: "nav-link" %>
            </li>
          <% end %>
        <% else %>
          <li class="nav-item">
            <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<style>
  /* カスタムドロップダウンメニュー */
  .custom-dropdown {
    position: relative;
  }
  
  .custom-dropdown-toggle {
    cursor: pointer;
    text-decoration: none !important;
  }
  
  .custom-dropdown-toggle:hover {
    color: #ffffff !important;
  }
  
  .custom-dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    min-width: 160px;
    padding: 0.5rem 0;
    margin: 0;
    list-style: none;
    z-index: 1000;
    
    /* 初期状態（非表示） */
    opacity: 0;
    transform: translateY(-10px);
    visibility: hidden;
    transition: all 0.3s ease-in-out;
  }
  
  .custom-dropdown-menu.show {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }
  
  .custom-dropdown-menu li {
    margin: 0;
  }
  
  .custom-dropdown-item {
    display: block;
    width: 100%;
    padding: 0.375rem 1rem;
    color: #212529;
    text-decoration: none;
    background-color: transparent;
    border: 0;
    transition: all 0.2s ease-in-out;
  }
  
  .custom-dropdown-item:hover {
    background-color: #f8f9fa;
    color: #1e2125;
    text-decoration: none;
    transform: translateX(5px);
  }
  
  /* ナビゲーションロゴのスタイル */
  .navbar-logo {
    height: 40px;
    width: auto;
  }
  
  /* かっこいいフォント設定 */
  .navbar-brand {
    font-family: 'Poppins', sans-serif !important;
    font-weight: 700 !important;
    font-size: 1.5rem !important;
    letter-spacing: 0.5px !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3) !important;
  }
  
  .nav-link {
    font-family: 'Inter', sans-serif !important;
    font-weight: 500 !important;
    font-size: 0.95rem !important;
    letter-spacing: 0.3px !important;
    transition: all 0.3s ease !important;
  }
  
  .nav-link:hover {
    transform: translateY(-1px) !important;
    text-shadow: 0 2px 8px rgba(255,255,255,0.3) !important;
  }
  
  .custom-dropdown-toggle {
    font-family: 'Inter', sans-serif !important;
    font-weight: 600 !important;
    font-size: 0.95rem !important;
    letter-spacing: 0.3px !important;
  }
  
  .custom-dropdown-item {
    font-family: 'Inter', sans-serif !important;
    font-weight: 500 !important;
    font-size: 0.9rem !important;
    letter-spacing: 0.2px !important;
  }
  
  /* レスポンシブ対応 */
  @media (max-width: 991.98px) {
    .custom-dropdown-menu {
      position: static;
      box-shadow: none;
      border: none;
      background-color: #495057;
      border-radius: 0;
    }
    
    .custom-dropdown-item {
      color: #ffffff;
    }
    
    .custom-dropdown-item:hover {
      background-color: #6c757d;
      color: #ffffff;
      transform: none;
    }
  }
</style>
