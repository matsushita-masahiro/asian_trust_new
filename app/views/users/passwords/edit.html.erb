<div class="container d-flex align-items-center justify-content-center devise-password-edit" style="min-height: 80vh;">
  <div class="card shadow-lg p-4 devise-password-card" style="max-width: 480px; width: 100%;">
    <div class="text-center mb-4">
      <div class="mb-3">
        <i class="fas fa-key devise-icon success"></i>
      </div>
      <h4 class="text-success mb-2">新しいパスワードを設定</h4>
      <p class="text-muted small">セキュリティのため、強力なパスワードを設定してください。</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-3">
        <%= f.label :password, "新しいパスワード", class: "form-label fw-bold" %>
        <% if @minimum_password_length %>
          <small class="text-muted">（<%= @minimum_password_length %>文字以上）</small>
        <% end %>
        <div class="input-group devise-input-group success-focus">
          <span class="input-group-text bg-light">
            <i class="fas fa-lock text-muted"></i>
          </span>
          <%= f.password_field :password, 
              autofocus: true, 
              autocomplete: "new-password", 
              class: "form-control",
              placeholder: "新しいパスワードを入力",
              id: "new_password" %>
          <button type="button" class="btn btn-outline-secondary" onclick="console.log('Button clicked'); togglePassword('new_password', this)">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, "パスワード確認", class: "form-label fw-bold" %>
        <div class="input-group devise-input-group success-focus">
          <span class="input-group-text bg-light">
            <i class="fas fa-lock text-muted"></i>
          </span>
          <%= f.password_field :password_confirmation, 
              autocomplete: "new-password", 
              class: "form-control",
              placeholder: "パスワードを再入力",
              id: "confirm_password" %>
          <button type="button" class="btn btn-outline-secondary" onclick="console.log('Confirm button clicked'); togglePassword('confirm_password', this)">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      </div>

      <div class="d-grid mb-3">
        <%= f.submit "パスワードを変更する", class: "btn btn-success btn-lg devise-btn-success" %>
      </div>
    <% end %>

    <hr class="my-3">

    <%= render "users/shared/links" %>
  </div>
</div>

<script>
// パスワード表示切り替え機能
window.togglePassword = function(fieldId, button) {
  try {
    const field = document.getElementById(fieldId);
    const icon = button.querySelector('i');
    
    if (!field || !icon) {
      console.warn('Field or icon not found:', fieldId);
      return;
    }
    
    if (field.type === 'password') {
      field.type = 'text';
      icon.classList.remove('fa-eye');
      icon.classList.add('fa-eye-slash');
    } else {
      field.type = 'password';
      icon.classList.remove('fa-eye-slash');
      icon.classList.add('fa-eye');
    }
  } catch (error) {
    console.warn('Error in togglePassword:', error);
  }
};

// パスワード一致チェック機能
function initPasswordValidation() {
  try {
    const newPassword = document.getElementById('new_password');
    const confirmPassword = document.getElementById('confirm_password');
    
    if (newPassword && confirmPassword) {
      const validatePassword = function() {
        if (newPassword.value !== confirmPassword.value) {
          confirmPassword.style.borderColor = '#dc3545';
        } else {
          confirmPassword.style.borderColor = '#28a745';
        }
      };
      
      confirmPassword.addEventListener('input', validatePassword);
      console.log('✅ Password validation initialized');
    }
  } catch (error) {
    console.warn('Error initializing password validation:', error);
  }
}

// 初期化
document.addEventListener('DOMContentLoaded', initPasswordValidation);
document.addEventListener('turbo:load', initPasswordValidation);
</script>