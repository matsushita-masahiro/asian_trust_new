<div class="container pt-5 mt-5 px-4">
  <% if @category.present? %>
    <!-- 特定カテゴリの商品一覧 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2>🧾 <%= category_display_name(@category) %>商品一覧</h2>
        <%= link_to "← カテゴリ選択に戻る", admin_products_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
      <div>
        <% if @show_deleted %>
          <%= link_to "有効な商品を表示", admin_products_path(category: @category), class: "btn btn-outline-primary" %>
        <% else %>
          <%= link_to "削除済み商品を表示", admin_products_path(category: @category, show_deleted: true), class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    </div>

    <% if @show_deleted %>
      <div class="alert alert-warning">
        <i class="fas fa-trash me-2"></i>削除済み商品を表示しています
      </div>
    <% end %>

    <ul class="list-group">
      <% @products.each do |product| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong><%= product.name %></strong><br>
            <% if product.short_name.present? %>
              略称：<%= product.short_name %><br>
            <% end %>

            <% if product.unit_quantity.present? && product.unit_label.present? %>
              <% display_quantity = (product.unit_quantity.to_f == product.unit_quantity.to_i) ? product.unit_quantity.to_i : product.unit_quantity %>
              販売単位：<%= "#{display_quantity}#{product.unit_label}" %><br>
            <% end %>

            基本金額：¥<%= number_with_delimiter(product.base_price) %><br>
            <span class="badge bg-<%= product.is_active ? 'success' : 'secondary' %>">
              <%= product.is_active ? '有効' : '無効' %>
            </span>
            <% if @show_deleted %>
              <span class="badge bg-danger ms-1">削除済み</span>
            <% end %>
          </div>
          <div>
            <% if @show_deleted %>
              <%= link_to '復元', restore_admin_product_path(product), 
                  method: :patch, 
                  class: 'btn btn-sm btn-outline-success me-2',
                  data: { confirm: "「#{product.name}」を復元しますか？" } %>
            <% else %>
              <%= link_to '編集', edit_admin_product_path(product), class: 'btn btn-sm btn-outline-primary' %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <!-- カテゴリ選択画面 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>🧾 商品管理</h2>
    </div>

    <div class="row g-4">
      <!-- 幹細胞培養上清液 -->
      <div class="col-md-4">
        <div class="card h-100 category-card" style="cursor: pointer;" onclick="location.href='<%= admin_products_path(category: 'sl') %>'">
          <div class="card-body text-center p-4">
            <div class="mb-3">
              <i class="fas fa-flask fa-3x text-primary"></i>
            </div>
            <h5 class="card-title">幹細胞培養上清液</h5>
            <p class="card-text text-muted">
              幹細胞培養上清液関連商品の管理
            </p>
            <div class="mt-3">
              <span class="badge bg-primary">
                <%= Product.active.where(category: 'sl').count %>商品
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- WOTT -->
      <div class="col-md-4">
        <div class="card h-100 category-card" style="cursor: pointer;" onclick="location.href='<%= admin_products_path(category: 'wott') %>'">
          <div class="card-body text-center p-4">
            <div class="mb-3">
              <i class="fas fa-microchip fa-3x text-success"></i>
            </div>
            <h5 class="card-title">WOTT</h5>
            <p class="card-text text-muted">
              WOTT関連商品の管理
            </p>
            <div class="mt-3">
              <span class="badge bg-success">
                <%= Product.active.where(category: 'wott').count %>商品
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- MANNERSOUND -->
      <div class="col-md-4">
        <div class="card h-100 category-card" style="cursor: pointer;" onclick="location.href='<%= admin_products_path(category: 'ms') %>'">
          <div class="card-body text-center p-4">
            <div class="mb-3">
              <i class="fas fa-music fa-3x text-warning"></i>
            </div>
            <h5 class="card-title">MANNERSOUND</h5>
            <p class="card-text text-muted">
              MANNERSOUND関連商品の管理
            </p>
            <div class="mt-3">
              <span class="badge bg-warning">
                <%= Product.active.where(category: 'ms').count %>商品
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 全体統計 -->
    <div class="row mt-4">
      <div class="col-12">
        <div class="card">
          <div class="card-body">
            <h6 class="card-title">商品統計</h6>
            <div class="row text-center">
              <div class="col-md-3">
                <div class="stat-item">
                  <div class="stat-number text-primary h4"><%= Product.active.count %></div>
                  <div class="stat-label text-muted small">有効商品</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="stat-item">
                  <div class="stat-number text-danger h4"><%= Product.deleted.count %></div>
                  <div class="stat-label text-muted small">削除済み商品</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="stat-item">
                  <div class="stat-number text-success h4"><%= Product.where(is_active: true).count %></div>
                  <div class="stat-label text-muted small">アクティブ商品</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="stat-item">
                  <div class="stat-number text-secondary h4"><%= Product.where(is_active: false).count %></div>
                  <div class="stat-label text-muted small">非アクティブ商品</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
.category-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 16px rgba(0,0,0,0.1);
  transition: all 0.3s ease;
}

.category-card {
  transition: all 0.3s ease;
  border: 2px solid #e9ecef;
}

.category-card:hover {
  border-color: #0d6efd;
}

.stat-item {
  padding: 1rem;
}
</style>
