<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4>購入請求書管理</h4>
  </div>
  
  <!-- ステータスフィルター -->
  <div class="card mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <%= form_with url: admin_purchase_invoices_path, method: :get, local: true, class: "d-flex" do |f| %>
            <%= f.select :status, options_for_select([
              ['全て', ''],
              ['下書き', PurchaseInvoice::DRAFT],
              ['送付済み', PurchaseInvoice::SENT],
              ['支払い完了', PurchaseInvoice::PAID],
              ['領収書依頼済み', PurchaseInvoice::RECEIPT_REQUESTED],
              ['領収書発行完了', PurchaseInvoice::RECEIPT_SENT]
            ], params[:status]), {}, { class: "form-select me-2" } %>
            <%= f.submit "フィルター", class: "btn btn-outline-primary" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
  <% if @purchase_invoices.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>請求書番号</th>
            <th>購入者</th>
            <th>販売者</th>
            <th>請求日</th>
            <th>支払期限</th>
            <th class="text-end">金額</th>
            <th>ステータス</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @purchase_invoices.each do |invoice| %>
            <tr>
              <td>
                <%= link_to invoice.invoice_number, admin_purchase_invoice_path(invoice), 
                    class: "text-decoration-none fw-bold" %>
              </td>
              <td><%= invoice.purchase.user.name %></td>
              <td><%= invoice.user.name %></td>
              <td><%= invoice.invoice_date.strftime("%Y/%m/%d") %></td>
              <td><%= invoice.due_date.strftime("%Y/%m/%d") %></td>
              <td class="text-end">
                <% display_amount = invoice.total_with_tax.to_i > 0 ? invoice.total_with_tax.to_i : invoice.total_amount.to_i %>
                <%= number_with_delimiter(display_amount) %>円
              </td>
              <td>
                <span class="badge bg-<%= invoice.status == 0 ? 'secondary' : invoice.status == 1 ? 'warning' : invoice.status == 2 ? 'success' : invoice.status == 3 ? 'info' : 'primary' %>">
                  <%= invoice.status_display_name %>
                </span>
              </td>
              <td>
                <div class="btn-group" role="group">
                  <%= link_to "詳細", admin_purchase_invoice_path(invoice), 
                      class: "btn btn-sm btn-outline-primary" %>
                  
                  <% if invoice.draft? %>
                    <%= link_to "送付", send_invoice_admin_purchase_invoice_path(invoice), 
                        method: :patch, class: "btn btn-sm btn-primary",
                        confirm: "請求書を送付しますか？" %>
                  <% end %>
                  
                  <% if invoice.sent? %>
                    <%= link_to "支払確認", confirm_payment_admin_purchase_invoice_path(invoice), 
                        method: :patch, class: "btn btn-sm btn-success",
                        confirm: "支払いを確認しますか？" %>
                  <% end %>
                  
                  <% if invoice.receipt_requested? %>
                    <%= link_to "領収書発行", send_receipt_admin_purchase_invoice_path(invoice), 
                        method: :patch, class: "btn btn-sm btn-info",
                        confirm: "領収書を発行しますか？" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">
      <i class="fas fa-info-circle"></i>
      購入請求書はありません。
    </div>
  <% end %>
  
  <div class="mt-3">
    <%= link_to "ダッシュボードに戻る", admin_root_path, class: "btn btn-secondary" %>
  </div>
</div>