<div class="container-fluid" style="padding-top: 100px;">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-primary">
          <i class="fas fa-level-up-alt me-2"></i>
          WOTTレベル昇格申請管理
        </h4>
        <%= link_to admin_root_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-arrow-left me-1"></i>ダッシュボードに戻る
        <% end %>
      </div>
    </div>
  </div>

  <!-- ステータスフィルター -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="btn-group" role="group">
        <%= link_to admin_wott_level_upgrade_requests_path(status: 'pending'), 
            class: "btn btn-#{@status == 'pending' ? 'primary' : 'outline-primary'}" do %>
          <i class="fas fa-clock me-1"></i>承認待ち
          <% if WottLevelUpgradeRequest.pending.count > 0 %>
            <span class="badge bg-danger ms-1"><%= WottLevelUpgradeRequest.pending.count %></span>
          <% end %>
        <% end %>
        <%= link_to admin_wott_level_upgrade_requests_path(status: 'approved'), 
            class: "btn btn-#{@status == 'approved' ? 'success' : 'outline-success'}" do %>
          <i class="fas fa-check me-1"></i>承認済み
        <% end %>
        <%= link_to admin_wott_level_upgrade_requests_path(status: 'rejected'), 
            class: "btn btn-#{@status == 'rejected' ? 'danger' : 'outline-danger'}" do %>
          <i class="fas fa-times me-1"></i>却下
        <% end %>
        <%= link_to admin_wott_level_upgrade_requests_path(status: 'all'), 
            class: "btn btn-#{@status == 'all' ? 'secondary' : 'outline-secondary'}" do %>
          <i class="fas fa-list me-1"></i>すべて
        <% end %>
      </div>
    </div>
  </div>

  <!-- 申請リスト -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <% if @requests.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>申請日時</th>
                    <th>ユーザー</th>
                    <th>現在のレベル</th>
                    <th>申請レベル</th>
                    <th>購入ID</th>
                    <th>ステータス</th>
                    <th>処理者</th>
                    <th>処理日時</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <% @requests.each do |request| %>
                    <tr>
                      <td><%= request.created_at.strftime("%Y/%m/%d %H:%M") %></td>
                      <td>
                        <%= link_to admin_user_path(request.user) do %>
                          <%= request.user.name %>
                        <% end %>
                      </td>
                      <td>
                        <span class="badge bg-secondary">
                          <%= request.current_level_name %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-primary">
                          <%= request.requested_level_name %>
                        </span>
                      </td>
                      <td>
                        <% if request.purchase %>
                          <%= link_to "##{request.purchase.id}", admin_purchase_path(request.purchase), class: "text-decoration-none" %>
                        <% else %>
                          -
                        <% end %>
                      </td>
                      <td>
                        <% 
                          status_badge = case request.status
                                        when 'pending' then 'bg-warning'
                                        when 'approved' then 'bg-success'
                                        when 'rejected' then 'bg-danger'
                                        else 'bg-secondary'
                                        end
                          status_text = case request.status
                                       when 'pending' then '承認待ち'
                                       when 'approved' then '承認済み'
                                       when 'rejected' then '却下'
                                       else request.status
                                       end
                        %>
                        <span class="badge <%= status_badge %>"><%= status_text %></span>
                      </td>
                      <td>
                        <% if request.processed_by %>
                          <%= request.processed_by.name %>
                        <% else %>
                          -
                        <% end %>
                      </td>
                      <td>
                        <% if request.processed_at %>
                          <%= request.processed_at.strftime("%Y/%m/%d %H:%M") %>
                        <% else %>
                          -
                        <% end %>
                      </td>
                      <td>
                        <% if request.pending? %>
                          <div class="btn-group btn-group-sm">
                            <%= button_to approve_admin_wott_level_upgrade_request_path(request), 
                                method: :post, 
                                class: "btn btn-success btn-sm",
                                data: { confirm: "#{request.user.name}さんのWOTTレベルを#{request.requested_level_name}に昇格させますか？" } do %>
                              <i class="fas fa-check"></i>
                            <% end %>
                            <%= button_to reject_admin_wott_level_upgrade_request_path(request), 
                                method: :post, 
                                class: "btn btn-danger btn-sm",
                                data: { confirm: "この申請を却下しますか？" } do %>
                              <i class="fas fa-times"></i>
                            <% end %>
                          </div>
                        <% else %>
                          <%= link_to admin_wott_level_upgrade_request_path(request), class: "btn btn-sm btn-outline-secondary" do %>
                            <i class="fas fa-eye"></i>
                          <% end %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            
            <%= paginate @requests %>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
              <h5 class="text-muted">申請がありません</h5>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
