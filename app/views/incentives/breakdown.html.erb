<% content_for :title, "インセンティブ明細 - #{@target_user.display_name}" %>

<div class="container incentive-container">
  <div class="row">
    <div class="col-12">
      <!-- パンくずリスト -->
      <nav aria-label="breadcrumb" class="breadcrumb-custom">
        <ol class="breadcrumb">
          <li class="breadcrumb-item">
            <%= link_to incentives_path(target_month: @target_month) do %>
              <i class="fas fa-chart-line me-1"></i>インセンティブ
            <% end %>
          </li>
          <li class="breadcrumb-item active" aria-current="page">
            <%= @target_user.display_name %>の明細
          </li>
        </ol>
      </nav>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">
          <i class="fas fa-list-alt me-2"></i>インセンティブ明細 - <%= @target_user.display_name %>
        </h4>
        <div class="flex-shrink-0">
          <%= link_to incentives_path(target_month: @target_month), class: "btn btn-outline-secondary btn-sm" do %>
            <i class="fas fa-arrow-left me-1"></i>一覧に戻る
          <% end %>
        </div>
      </div>
      
      <!-- インセンティブサマリー -->
      <div class="row mb-4">
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <h6 class="text-muted">ユーザー情報</h6>
              <p><strong>名前:</strong> <%= @target_user.name %></p>
              <p>
                <strong>レベル:</strong> 
                <span class="badge bg-secondary"><%= @display_level&.name || @target_user.level_label %></span>
                <% if @target_user.level && @display_level && @target_user.level.id != @display_level.id %>
                  <i class="fas fa-arrow-right mx-2"></i>
                  <span class="badge bg-success"><%= @target_user.level.name %></span>
                  <small class="text-muted">(現在)</small>
                <% end %>
              </p>
              <% if @display_wott_level %>
                <p>
                  <strong>WOTTレベル:</strong> 
                  <span class="badge bg-info"><%= @display_wott_level.name %></span>
                  <% if @target_user.wott_level && @target_user.wott_level.id != @display_wott_level.id %>
                    <i class="fas fa-arrow-right mx-2"></i>
                    <span class="badge bg-success"><%= @target_user.wott_level.name %></span>
                    <small class="text-muted">(現在)</small>
                  <% end %>
                </p>
              <% end %>
              <p><strong>期間:</strong> <%= @start_date.strftime("%Y年%m月%d日") %> 〜 <%= @end_date.strftime("%Y年%m月%d日") %></p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card incentive-summary-card h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <div class="text-center mb-3">
                <h5 class="mb-0">
                  <i class="fas fa-calendar-alt me-2"></i>
                  インセンティブ合計（<%= @target_date.strftime("%Y年%m月") %>）
                </h5>
              </div>
              <div class="text-end">
                <div class="summary-item">
                  <div class="summary-value text-success">¥<%= number_with_delimiter(@incentive_summary[:total_incentive]) %></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>



      <!-- ユーザーの商品単価（上清液のみ表示） -->
      <% sl_products = @user_product_prices.select { |p| p[:product].category == 'sl' } %>
      <% if sl_products.any? %>
        <div class="alert alert-info mb-4">
          <i class="fas fa-tag me-2"></i><strong><%= @target_user.display_name %>の商品単価:</strong>
          <% sl_products.each_with_index do |price_info, index| %>
            <%= price_info[:product].display_name %>: ¥<%= number_with_delimiter(price_info[:price]) %><%= index < sl_products.length - 1 ? ' / ' : '' %>
          <% end %>
        </div>
      <% end %>

      <!-- 購入明細 -->
      <% 
        # 全ての購入明細を取得し、購入日で昇順ソート（古いものから）
        all_details = @detailed_incentives.dig(:details, :purchase_details) || []
        
        # カテゴリー毎に分類
        sl_details = all_details.select { |d| d[:product_category] == 'sl' }.sort_by { |d| d[:purchase_date] }
        wott_details = all_details.select { |d| d[:product_category] == 'wott' }.sort_by { |d| d[:purchase_date] }
        ms_details = all_details.select { |d| d[:product_category] == 'ms' }.sort_by { |d| d[:purchase_date] }
        ag_details = all_details.select { |d| d[:product_category] == 'ag' }.sort_by { |d| d[:purchase_date] }
        
        total_incentive = all_details.sum { |d| d[:total_incentive] || 0 }
        
        # カテゴリー毎の明細配列（Productモデルからカテゴリー名を取得）
        category_details = [
          { key: 'sl', name: Product.category_name_for('sl'), details: sl_details },
          { key: 'wott', name: Product.category_name_for('wott'), details: wott_details },
          { key: 'ms', name: Product.category_name_for('ms'), details: ms_details },
          { key: 'ag', name: Product.category_name_for('ag'), details: ag_details }
        ]
      %>

      <!-- カテゴリー毎のインセンティブ表示 -->
      <% category_details.each do |category| %>
        <% next if category[:details].empty? %>
        
        <div class="card mb-4">
          <div class="card-header">
            <h6 class="mb-0">
              <i class="fas fa-box me-2"></i><%= category[:name] %>のインセンティブ
            </h6>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th class="border-end">購入日</th>
                    <th>購入者</th>
                    <% if category[:key] == 'wott' || category[:key] == 'ms' %>
                      <% if category[:key] == 'wott' %>
                        <th>WOTTレベル</th>
                        <th class="text-end">基本価格</th>
                        <th class="text-end border-end">インセンティブ%</th>
                      <% else %>
                        <th>購入者レベル</th>
                        <th class="text-end">基本価格</th>
                        <th class="text-end border-end">インセンティブ%</th>
                      <% end %>
                    <% else %>
                      <th>商品名</th>
                      <th class="text-end border-end">購入者単価</th>
                      <th>直下ユーザー</th>
                      <th class="text-end border-end">直下ユーザー単価</th>
                    <% end %>
                    <th class="text-end">数量</th>
                    <th class="text-end">インセンティブ単価</th>
                    <th class="text-end">インセンティブ合計</th>
                  </tr>
                </thead>
                <tbody>
                  <% category[:details].each do |detail| %>
                    <tr>
                      <td class="border-end"><%= detail[:purchase_date]&.strftime("%Y/%m/%d") %></td>
                      <td><%= detail[:purchaser_display_name] %></td>
                      <% if category[:key] == 'wott' || category[:key] == 'ms' %>
                        <% if category[:key] == 'wott' %>
                          <td><span class="badge bg-info"><%= detail[:calculation_details][:purchaser_level] %></span></td>
                          <td class="text-end">¥<%= number_with_delimiter(detail[:calculation_details][:base_price] || 0) %></td>
                          <td class="text-end border-end"><%= number_to_percentage((detail[:calculation_details][:incentive_rate] || 0) * 100, precision: 0) %></td>
                        <% else %>
                          <td><span class="badge bg-warning text-dark"><%= detail[:calculation_details][:purchaser_level] %></span></td>
                          <td class="text-end">¥<%= number_with_delimiter(detail[:calculation_details][:base_price] || 0) %></td>
                          <td class="text-end border-end"><%= number_to_percentage((detail[:calculation_details][:incentive_rate] || 0) * 100, precision: 0) %></td>
                        <% end %>
                      <% else %>
                        <td><%= detail[:product_name] %></td>
                        <td class="text-end border-end">¥<%= number_with_delimiter(detail[:calculation_details][:purchaser_price]) %></td>
                        <td><%= detail[:direct_referral_display_name] || '-' %></td>
                        <td class="text-end border-end">¥<%= number_with_delimiter(detail[:direct_referral_price]) %></td>
                      <% end %>
                      <td class="text-end"><%= detail[:quantity] %></td>
                      <td class="text-end">¥<%= number_with_delimiter(detail[:incentive_unit_price]) %></td>
                      <td class="text-end text-success">¥<%= number_with_delimiter(detail[:total_incentive]) %></td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot>
                  <tr class="table-info fw-bold">
                    <td colspan="<%= (category[:key] == 'wott' || category[:key] == 'ms') ? '7' : '8' %>" class="text-end"><%= category[:name] %>インセンティブ小計</td>
                    <td class="text-end text-success">¥<%= number_with_delimiter(category[:details].sum { |d| d[:total_incentive] || 0 }) %></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      <% end %>

      <!-- 合計 -->
      <% if all_details.any? %>
        <div class="card">
          <div class="card-body">
            <div class="row">
              <div class="col-md-8">
                <h5 class="mb-0">インセンティブ総合計</h5>
              </div>
              <div class="col-md-4 text-end">
                <h4 class="mb-0 text-success">¥<%= number_with_delimiter(total_incentive) %></h4>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        <div class="card">
          <div class="card-body text-center py-5">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">購入明細がありません</h5>
            <p class="text-muted">この期間中のインセンティブ対象となる購入実績はありません。</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

