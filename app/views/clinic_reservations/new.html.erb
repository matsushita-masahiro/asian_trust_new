<!-- 緊急予約モーダル -->
<div class="modal fade" id="emergencyReservationModal" tabindex="-1" aria-labelledby="emergencyReservationModalLabel" aria-hidden="true">
  <div class="modal-dialog mt-5 pt-5">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="emergencyReservationModalLabel">
          <i class="fas fa-exclamation-triangle me-2"></i>緊急予約の方
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with model: @purchase, url: request_emergency_reservation_purchase_path(@purchase), method: :patch, local: true, id: "emergency-reservation-form", data: { turbo: false } do |f| %>
        <div class="modal-body">
          <div class="alert alert-warning">
            <i class="fas fa-info-circle me-2"></i>
            <strong>緊急予約について</strong><br>
            1週間以内など、通常より早い日程での予約をご希望の場合は、下記に詳細をご記入ください。事務局が優先的に対応いたします。
          </div>
          
          <div class="mb-3">
            <label for="emergency_message" class="form-label">
              <strong>緊急予約の理由・希望日時など</strong>
              <span class="text-danger">*</span>
            </label>
            <%= f.text_area :emergency_reservation_message, 
                class: "form-control", 
                id: "emergency_message",
                rows: 5, 
                placeholder: "緊急予約が必要な理由、希望日時、その他ご要望などをご記入ください。",
                required: true %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
          <%= f.submit "緊急予約を依頼する", class: "btn btn-danger" %>
        </div>
      <% end %>
    </div>
  </div>
</div>



