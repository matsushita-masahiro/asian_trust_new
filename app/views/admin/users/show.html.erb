<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4 mobile-header" style="margin-top: 80px;">
        <div class="d-flex align-items-center mobile-title-section">
          <h4 class="text-primary me-3 user-name-horizontal"><%= @user.name.present? ? @user.name : @user.email %></h4>
          <%= form_with url: admin_user_path(@user), method: :get, local: true, class: "d-flex align-items-center", id: "month-form" do |f| %>
            <label class="form-label me-2 mb-0">対象月:</label>
            <%= f.month_field :month, value: @selected_month, class: "form-control", style: "width: 180px;", onchange: "document.getElementById('month-form').submit();" %>
          <% end %>
        </div>
        <div class="mobile-nav-buttons">
          <% if @user.referrer %>
            <%= link_to admin_user_path(@user.referrer, month: @selected_month), class: "btn btn-outline-info me-2" do %>
              <i class="fas fa-arrow-up me-1"></i>一つ上の階層へ
            <% end %>
          <% end %>
          <%= link_to "ユーザー編集", edit_admin_user_path(@user), class: "btn btn-outline-warning me-2" %>
          <%= link_to "代理店一覧に戻る", admin_users_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  </div>

  <!-- 基本情報・レベル別統計・売上情報 -->
  <div class="row mb-4 mobile-cards">
    <!-- 基本情報 -->
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">基本情報</h5>
        </div>
        <div class="card-body">
          <table class="table table-borderless">
            <tr>
              <th width="40%">ID:</th>
              <td><%= @user.id %></td>
            </tr>
            <tr>
              <th>レベル:</th>
              <td>
                <% if @user.level %>
                  <span class="badge bg-success"><%= @user.level.name %></span>
                <% else %>
                  <span class="text-muted">未設定</span>
                <% end %>
              </td>
            </tr>
            <% if @pending_application %>
              <tr>
                <th>申請中:</th>
                <td>
                  <div class="level-change-application">
                    <div class="d-flex align-items-center mb-2">
                      <span class="badge bg-warning me-2">申請中</span>
                      <span class="level-change-text">
                        <%= @pending_application.current_level.name %> 
                        <i class="fas fa-arrow-right mx-2"></i> 
                        <%= @pending_application.target_level.name %>
                      </span>
                    </div>
                    <div class="application-details">
                      <div class="text-muted">
                        <i class="fas fa-calendar me-1"></i>
                        実行予定:
                      </div>
                      <div class="fw-bold text-dark mb-2">
                        <%= @pending_application.scheduled_date.strftime('%Y年%m月%d日') %>
                      </div>
                      <div class="mt-2">
                        <%= link_to "申請詳細", admin_level_change_application_path(@pending_application), 
                            class: "btn btn-sm btn-outline-info" %>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
            <tr>
              <th>メールアドレス:</th>
              <td class="text-break"><%= @user.email %></td>
            </tr>
            <tr>
              <th>登録日:</th>
              <td><%= @user.created_at.strftime("%Y年%m月%d日") %></td>
            </tr>
            <tr>
              <th>紹介者:</th>
              <td>
                <% if @user.referrer %>
                  <%= link_to (@user.referrer.name.present? ? @user.referrer.name : @user.referrer.email), admin_user_path(@user.referrer, month: @selected_month), class: "text-decoration-none" %>
                <% else %>
                  <span class="text-muted">なし</span>
                <% end %>
              </td>
            </tr>
            <tr>
              <th>登録住所:</th>
              <td class="address-cell">
                <div id="registration-address-display">
                  <% if @user.registration_address.present? %>
                    <div class="address-content">
                      <% if @user.registration_address.postal_code.present? %>
                        <small class="text-muted">〒<%= @user.registration_address.postal_code %></small><br>
                      <% end %>
                      <span class="address-text"><%= @user.registration_address.address %></span>
                    </div>
                  <% elsif @invoice_base&.address.present? %>
                    <!-- 後方互換性のための表示 -->
                    <div class="address-content">
                      <% if @invoice_base.postal_code.present? %>
                        <small class="text-muted">〒<%= @invoice_base.postal_code %></small><br>
                      <% end %>
                      <span class="address-text"><%= @invoice_base.address %></span>
                      <small class="text-warning d-block mt-1">
                        <i class="fas fa-exclamation-triangle me-1"></i>旧形式の住所データ
                      </small>
                    </div>
                  <% else %>
                    <span class="text-muted">未登録</span>
                  <% end %>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="editAddress('registration')">
                  <i class="fas fa-edit me-1"></i>編集
                </button>
              </td>
            </tr>
            <tr>
              <th>配送先住所:</th>
              <td class="address-cell">
                <div id="shipping-address-display">
                  <% if @user.shipping_address.present? %>
                    <div class="address-content">
                      <% if @user.shipping_address.postal_code.present? %>
                        <small class="text-muted">〒<%= @user.shipping_address.postal_code %></small><br>
                      <% end %>
                      <span class="address-text"><%= @user.shipping_address.address %></span>
                    </div>
                  <% else %>
                    <span class="text-muted">未登録</span>
                  <% end %>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="editAddress('shipping')">
                  <i class="fas fa-edit me-1"></i>編集
                </button>
              </td>
            </tr>
          </table>
        </div>
      </div>
    </div>

    <!-- レベル別統計 -->
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="fas fa-chart-bar me-2"></i>レベル別統計
          </h5>
        </div>
        <div class="card-body">
          <div class="level-stats-list">
            <div class="level-stat-item mb-2">
              <i class="fas fa-crown text-danger me-2"></i>
              <span class="level-name">総代理店</span>
              <span class="level-count"><%= @level_counts[:total_agents] %>名</span>
            </div>
            <div class="level-stat-item mb-2">
              <i class="fas fa-user-tie text-warning me-2"></i>
              <span class="level-name">代理店</span>
              <span class="level-count"><%= @level_counts[:agents] %>名</span>
            </div>
            <div class="level-stat-item mb-2">
              <i class="fas fa-user-graduate text-success me-2"></i>
              <span class="level-name">アドバイザー</span>
              <span class="level-count"><%= @level_counts[:advisors] %>名</span>
            </div>
            <div class="level-stat-item mb-2">
              <i class="fas fa-spa text-info me-2"></i>
              <span class="level-name">サロン</span>
              <span class="level-count"><%= @level_counts[:salons] %>名</span>
            </div>
            <div class="level-stat-item mb-2">
              <i class="fas fa-hospital text-primary me-2"></i>
              <span class="level-name">クリニック</span>
              <span class="level-count"><%= @level_counts[:clinics] %>名</span>
            </div>
            <div class="level-stat-item mb-2">
              <i class="fas fa-users text-secondary me-2"></i>
              <span class="level-name">お客様</span>
              <span class="level-count"><%= @level_counts[:customers] %>名</span>
            </div>
            <hr class="my-2">
            <div class="level-stat-item">
              <i class="fas fa-chart-line text-primary me-2"></i>
              <span class="level-name fw-bold">総計</span>
              <span class="level-count fw-bold text-primary"><%= @user.descendants.count %>名</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 売上・インセンティブ情報 -->
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="fas fa-calendar-alt me-2"></i><%= @selected_month_display %>の実績
          </h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <div class="stats-card bg-success bg-gradient text-white rounded-3 p-3 text-center">
              <div class="stats-icon mb-2">
                <i class="fas fa-yen-sign fa-2x"></i>
              </div>
              <div class="stats-number h5 fw-bold">¥<%= number_with_delimiter(@total_sales_amount) %></div>
              <div class="stats-label small">売上</div>
              <div class="stats-breakdown mt-2" style="font-size: 0.75rem; opacity: 0.9;">
                <div>本人: ¥<%= number_with_delimiter(@own_sales_amount) %></div>
                <div>下位: ¥<%= number_with_delimiter(@descendant_sales_amount) %></div>
              </div>
            </div>
          </div>
          <div>
            <%= link_to admin_user_bonuses_path(@user, month: @selected_month), class: "text-decoration-none" do %>
              <div class="stats-card bg-warning bg-gradient text-white rounded-3 p-3 text-center clickable-card">
                <div class="stats-icon mb-2">
                  <i class="fas fa-gift fa-2x"></i>
                </div>
                <div class="stats-number h5 fw-bold">¥<%= number_with_delimiter(@incentive_summary[:total_incentive] || 0) %></div>
                <div class="stats-label small">インセンティブ <i class="fas fa-external-link-alt fa-sm"></i></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 統計情報カード用のカスタムスタイル -->
  <style>
    .stats-card {
      transition: all 0.3s ease;
      border: none;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .stats-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }
    
    .clickable-card {
      cursor: pointer;
    }
    
    .clickable-card:hover {
      transform: translateY(-8px) !important;
      box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3) !important;
    }
    
    .stats-icon {
      opacity: 0.8;
    }
    
    .stats-number {
      font-weight: 700;
      margin: 0;
    }
    
    .stats-label {
      font-weight: 500;
      opacity: 0.9;
    }
    
    /* レベル別統計のスタイル */
    .level-stats-list {
      font-size: 0.9rem;
    }
    
    .level-stat-item {
      display: flex;
      align-items: center;
      padding: 0.4rem 0;
      border-bottom: 1px solid #f0f0f0;
    }
    
    .level-stat-item:last-child {
      border-bottom: none;
    }
    
    .level-stat-item .level-name {
      flex: 1;
      margin-left: 0.5rem;
      font-size: 0.85rem;
    }
    
    .level-stat-item .level-count {
      font-weight: 600;
      min-width: 40px;
      text-align: right;
      font-size: 0.9rem;
    }
    
    .financial-item {
      margin-bottom: 1rem;
    }
    
    .financial-item:last-child {
      margin-bottom: 0;
    }
    
    /* レベル変更申請表示のスタイル */
    .level-change-application {
      background-color: #fff3cd;
      border: 1px solid #ffeaa7;
      border-radius: 0.375rem;
      padding: 0.75rem;
    }
    
    .level-change-text {
      font-weight: 500;
      color: #856404;
    }
    
    .application-details {
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px solid #ffeaa7;
    }
    
    /* 基本情報テーブルのスタイル */
    .table-borderless td {
      word-wrap: break-word;
      overflow-wrap: break-word;
      word-break: break-all;
      hyphens: auto;
    }
    
    /* 住所専用スタイル */
    .address-cell {
      max-width: 1px !important;
      width: 1px !important;
    }
    
    .address-content {
      word-wrap: break-word !important;
      overflow-wrap: break-word !important;
      word-break: break-all !important;
      white-space: normal !important;
      line-height: 1.4;
    }
    
    .address-text {
      display: block;
      word-wrap: break-word !important;
      overflow-wrap: break-word !important;
      word-break: break-all !important;
      white-space: normal !important;
    }
    
    /* 下位ユーザーの購入履歴行のスタイル */
    .descendant-purchase-row {
      background-color: #f8f9fa !important;
    }
    
    .descendant-purchase-row:hover {
      background-color: #e9ecef !important;
    }
    
    /* レスポンシブ対応 */
    @media (max-width: 768px) {
      /* ヘッダーの上部余白を小さくする */
      .mobile-header {
        margin-top: 20px !important;
      }
      
      .stats-card {
        margin-bottom: 1rem;
      }
      
      .stats-number {
        font-size: 1.5rem !important;
      }
      
      .stats-icon i {
        font-size: 1.5rem !important;
      }
      
      .level-stats-section, .financial-stats-section {
        margin-bottom: 1.5rem;
      }
      
      .level-stat-item {
        padding: 0.3rem 0;
      }
      
      .level-stat-item .level-name {
        font-size: 0.8rem;
      }
      
      .level-stat-item .level-count {
        font-size: 0.85rem;
        min-width: 35px;
      }
      
      /* 基本情報テーブルのモバイル対応 */
      .table-borderless th {
        width: 35% !important;
        font-size: 0.85rem;
        padding: 0.5rem 0.25rem;
        vertical-align: top;
      }
      
      .table-borderless td {
        width: 65% !important;
        font-size: 0.85rem;
        padding: 0.5rem 0.25rem;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        word-break: break-all !important;
        hyphens: auto !important;
        max-width: 0;
      }
      
      /* メールアドレスと住所の特別な処理 */
      .table-borderless td.text-break {
        line-height: 1.4;
        white-space: normal !important;
      }
      
      /* 住所セルの強制改行 */
      .address-cell {
        max-width: 0 !important;
        width: 65% !important;
        overflow: hidden !important;
      }
      
      .address-content {
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        word-break: break-all !important;
        white-space: normal !important;
        line-height: 1.3 !important;
        font-size: 0.8rem !important;
      }
      
      .address-text {
        display: block !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        word-break: break-all !important;
        white-space: normal !important;
      }
    }
  </style>



  <!-- 購入履歴 -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0"><%= @selected_month_display %>の購入履歴</h5>
        </div>
        <div class="card-body">
          <% if @purchases.any? || @descendant_purchases.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead class="table-light">
                  <tr>
                    <th>購入日</th>
                    <th>購入者</th>
                    <th>商品名</th>
                    <th>数量</th>
                    <th>単価</th>
                    <th>合計</th>
                  </tr>
                </thead>
                <tbody>
                  <!-- 本人の購入履歴 -->
                  <% @purchases.includes(purchase_items: :product, user: []).each do |purchase| %>
                    <% purchase.purchase_items.each_with_index do |item, index| %>
                      <tr>
                        <% if index == 0 %>
                          <td rowspan="<%= purchase.purchase_items.count %>"><%= purchase.purchased_at.strftime("%Y/%m/%d") %></td>
                          <td rowspan="<%= purchase.purchase_items.count %>"><%= purchase.user.name.present? ? purchase.user.name : purchase.user.email %></td>
                        <% end %>
                        <td><%= item.product.name %></td>
                        <td><%= item.quantity %></td>
                        <td>¥<%= number_with_delimiter(item.seller_price) %></td>
                        <td class="text-success">¥<%= number_with_delimiter(item.seller_price * item.quantity) %></td>
                      </tr>
                    <% end %>
                  <% end %>
                  
                  <!-- 下位ユーザーの購入履歴（薄いグレー背景） -->
                  <% @descendant_purchases.each do |purchase| %>
                    <% purchase.purchase_items.each_with_index do |item, index| %>
                      <tr class="descendant-purchase-row">
                        <% if index == 0 %>
                          <td rowspan="<%= purchase.purchase_items.count %>"><%= purchase.purchased_at.strftime("%Y/%m/%d") %></td>
                          <td rowspan="<%= purchase.purchase_items.count %>">
                            <%= link_to admin_user_path(purchase.user, month: @selected_month), class: "text-decoration-none text-primary" do %>
                              <%= purchase.user.name.present? ? purchase.user.name : purchase.user.email %>
                            <% end %>
                          </td>
                        <% end %>
                        <td><%= item.product.name %></td>
                        <td><%= item.quantity %></td>
                        <td>¥<%= number_with_delimiter(item.seller_price) %></td>
                        <td class="text-success">¥<%= number_with_delimiter(item.seller_price * item.quantity) %></td>
                      </tr>
                    <% end %>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-4">
              <p class="text-muted"><%= @selected_month_display %>の購入履歴はありません</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- 住所編集モーダル -->
  <div class="modal fade" id="addressEditModal" tabindex="-1" aria-labelledby="addressEditModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addressEditModalLabel">住所編集</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addressEditForm">
            <input type="hidden" id="addressType" name="address[address_type]">
            <input type="hidden" id="methodField" name="_method" value="post">
            <div class="mb-3">
              <label for="postalCode" class="form-label">郵便番号</label>
              <input type="text" class="form-control" id="postalCode" name="address[postal_code]" placeholder="123-4567">
              <div class="form-text">ハイフンありなしどちらでも入力可能です</div>
            </div>
            <div class="mb-3">
              <label for="addressText" class="form-label">住所 <span class="text-danger">*</span></label>
              <textarea class="form-control" id="addressText" name="address[address]" rows="3" required></textarea>
            </div>
          </form>
          <div id="addressEditErrors" class="alert alert-danger d-none"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
          <button type="button" class="btn btn-danger" id="deleteAddressBtn" onclick="deleteAddress()" style="display: none;">削除</button>
          <button type="button" class="btn btn-primary" onclick="saveAddress()">保存</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentAddressType = '';
    let currentAddressId = null;

    function editAddress(addressType) {
      console.log('editAddress called with type:', addressType);
      currentAddressType = addressType;
      currentAddressId = null; // リセット
      
      const modalElement = document.getElementById('addressEditModal');
      console.log('Modal element found:', modalElement);
      
      const modal = new bootstrap.Modal(modalElement);
      
      // モーダルタイトルを設定
      const addressTypeLabels = {
        'registration': '登録住所',
        'shipping': '配送先住所'
      };
      document.getElementById('addressEditModalLabel').textContent = addressTypeLabels[addressType] + 'の編集';
      
      // フォームをリセット
      document.getElementById('addressEditForm').reset();
      document.getElementById('addressType').value = addressType;
      document.getElementById('methodField').value = 'post';
      document.getElementById('addressEditErrors').classList.add('d-none');
      
      // 既存の住所データを取得してフォームに設定
      <% if @user.registration_address.present? %>
        if (addressType === 'registration') {
          currentAddressId = <%= @user.registration_address.id %>;
          document.getElementById('postalCode').value = '<%= @user.registration_address.postal_code %>';
          document.getElementById('addressText').value = '<%= j(@user.registration_address.address) %>';
          document.getElementById('methodField').value = 'patch';
          document.getElementById('deleteAddressBtn').style.display = 'inline-block';
        }
      <% end %>
      
      <% if @user.shipping_address.present? %>
        if (addressType === 'shipping') {
          currentAddressId = <%= @user.shipping_address.id %>;
          document.getElementById('postalCode').value = '<%= @user.shipping_address.postal_code %>';
          document.getElementById('addressText').value = '<%= j(@user.shipping_address.address) %>';
          document.getElementById('methodField').value = 'patch';
          document.getElementById('deleteAddressBtn').style.display = 'inline-block';
        }
      <% end %>
      
      if (!currentAddressId) {
        document.getElementById('deleteAddressBtn').style.display = 'none';
      }
      
      console.log('Current address ID:', currentAddressId);
      console.log('Method field value:', document.getElementById('methodField').value);
      
      modal.show();
    }

    function saveAddress() {
      console.log('saveAddress called');
      const form = document.getElementById('addressEditForm');
      const formData = new FormData(form);
      
      const url = currentAddressId ? 
        `/admin/users/<%= @user.id %>/addresses/${currentAddressId}` : 
        `/admin/users/<%= @user.id %>/addresses`;
      
      const method = currentAddressId ? 'PATCH' : 'POST';
      
      console.log('Request URL:', url);
      console.log('Request method:', method);
      console.log('Form data:', Object.fromEntries(formData));
      
      // CSRFトークンの確認
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      console.log('CSRF token element:', csrfToken);
      console.log('CSRF token value:', csrfToken ? csrfToken.getAttribute('content') : 'NOT FOUND');
      
      fetch(url, {
        method: method,
        body: formData,
        headers: {
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : '',
          'Accept': 'application/json'
        }
      })
      .then(response => {
        console.log('Response status:', response.status);
        console.log('Response headers:', response.headers);
        return response.json();
      })
      .then(data => {
        console.log('Response data:', data);
        if (data.success) {
          // 成功時の処理
          updateAddressDisplay(currentAddressType, data.address);
          bootstrap.Modal.getInstance(document.getElementById('addressEditModal')).hide();
          showAlert('success', data.message);
        } else {
          // エラー時の処理
          showErrors(data.errors);
        }
      })
      .catch(error => {
        console.error('Fetch error:', error);
        showAlert('danger', '住所の保存中にエラーが発生しました: ' + error.message);
      });
    }

    function deleteAddress() {
      if (!currentAddressId) return;
      
      if (!confirm('この住所を削除してもよろしいですか？')) return;
      
      fetch(`/admin/users/<%= @user.id %>/addresses/${currentAddressId}`, {
        method: 'DELETE',
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
          'Accept': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // 成功時の処理
          updateAddressDisplay(currentAddressType, null);
          bootstrap.Modal.getInstance(document.getElementById('addressEditModal')).hide();
          showAlert('success', data.message);
        } else {
          showAlert('danger', '住所の削除中にエラーが発生しました');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        showAlert('danger', '住所の削除中にエラーが発生しました');
      });
    }

    function updateAddressDisplay(addressType, addressData) {
      const displayElement = document.getElementById(`${addressType}-address-display`);
      
      if (addressData) {
        let html = '<div class="address-content">';
        if (addressData.postal_code) {
          html += `<small class="text-muted">〒${addressData.postal_code}</small><br>`;
        }
        html += `<span class="address-text">${addressData.address}</span>`;
        html += '</div>';
        displayElement.innerHTML = html;
      } else {
        displayElement.innerHTML = '<span class="text-muted">未登録</span>';
      }
    }

    function showErrors(errors) {
      const errorDiv = document.getElementById('addressEditErrors');
      errorDiv.innerHTML = errors.join('<br>');
      errorDiv.classList.remove('d-none');
    }

    function showAlert(type, message) {
      // 既存のアラートを削除
      const existingAlert = document.querySelector('.alert-dismissible');
      if (existingAlert) {
        existingAlert.remove();
      }
      
      // 新しいアラートを作成
      const alertDiv = document.createElement('div');
      alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
      alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      `;
      
      // ページの上部に挿入
      const container = document.querySelector('.container-fluid');
      container.insertBefore(alertDiv, container.firstChild);
      
      // 3秒後に自動で消す
      setTimeout(() => {
        if (alertDiv.parentNode) {
          alertDiv.remove();
        }
      }, 3000);
    }
  </script>

</div>