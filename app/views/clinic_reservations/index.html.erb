<div class="container-fluid px-3 mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
  <!-- まだ予約していない購入一覧 -->
  <% if @unreserved_purchases.any? %>
    <div class="card mb-4">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0">
          <i class="fas fa-calendar-plus me-2"></i>
          予約可能な購入
        </h5>
      </div>
      <div class="card-body p-2">
        <% @unreserved_purchases.each do |purchase| %>
          <div class="card mb-3 border-success">
            <div class="card-body p-3">
              <div class="row align-items-center">
                <div class="col-8">
                  <h6 class="mb-1 text-success">購入 #<%= purchase.id %></h6>
                  <small class="text-muted d-block mb-2"><%= purchase.purchased_at.strftime('%Y/%m/%d') %></small>
                  
                  <div class="mb-2">
                    <% purchase.purchase_items.each do |item| %>
                      <small class="d-block text-dark">
                        <i class="fas fa-box me-1"></i>
                        <%= truncate(item.product.name, length: 25) %> × <%= item.quantity %>
                      </small>
                    <% end %>
                  </div>
                  
                  <% delivery_info = purchase.delivery_informations.where(delivery_type: ['clinic', 'multiple']).first %>
                  <% if delivery_info&.clinic_id.present? %>
                    <% clinic = User.find_by(id: delivery_info.clinic_id) %>
                    <small class="text-primary">
                      <i class="fas fa-hospital me-1"></i>
                      <%= clinic&.name || "クリニック情報なし" %>
                    </small>
                  <% end %>
                </div>
                <div class="col-4 text-end">
                  <%= link_to "予約する", new_purchase_clinic_reservation_path(purchase), 
                      class: "btn btn-success btn-sm w-100" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- 過去の予約一覧 -->
  <div class="card">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">
        <i class="fas fa-calendar-alt me-2"></i>
        クリニック予約一覧
      </h5>
    </div>
    <div class="card-body p-2">
      <% if @clinic_reservations.any? %>
        <% @clinic_reservations.each do |reservation| %>
          <div class="card mb-3">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h6 class="mb-0 text-primary">予約 #<%= reservation.id %></h6>
                <% case reservation.status %>
                <% when ClinicReservation::PENDING %>
                  <span class="badge bg-warning">予約申込中</span>
                <% when ClinicReservation::CONFIRMED %>
                  <span class="badge bg-success">予約確定</span>
                <% when ClinicReservation::COMPLETED %>
                  <span class="badge bg-info">施術完了</span>
                <% when ClinicReservation::CANCELLED %>
                  <span class="badge bg-danger">キャンセル</span>
                <% end %>
              </div>
              
              <div class="mb-2">
                <small class="text-muted">申込日: <%= reservation.created_at.strftime('%Y/%m/%d') %></small>
              </div>
              
              <!-- 希望日時 -->
              <div class="mb-2">
                <div class="d-flex align-items-center mb-1">
                  <i class="fas fa-calendar text-primary me-2"></i>
                  <strong class="small">第1希望:</strong>
                  <span class="ms-2 small"><%= reservation.preferred_date_1&.strftime('%m/%d') %> <%= reservation.preferred_time_1 %></span>
                </div>
                <% if reservation.preferred_date_2.present? %>
                  <div class="d-flex align-items-center mb-1">
                    <i class="fas fa-calendar text-muted me-2"></i>
                    <small class="text-muted">第2希望: <%= reservation.preferred_date_2&.strftime('%m/%d') %> <%= reservation.preferred_time_2 %></small>
                  </div>
                <% end %>
                <% if reservation.preferred_date_3.present? %>
                  <div class="d-flex align-items-center mb-1">
                    <i class="fas fa-calendar text-muted me-2"></i>
                    <small class="text-muted">第3希望: <%= reservation.preferred_date_3&.strftime('%m/%d') %> <%= reservation.preferred_time_3 %></small>
                  </div>
                <% end %>
              </div>
              
              <!-- 施術方法 -->
              <div class="mb-3">
                <div class="d-flex align-items-start">
                  <i class="fas fa-syringe text-info me-2 mt-1"></i>
                  <div class="flex-grow-1">
                    <% reservation.treatment_methods_array.first(1).each do |method| %>
                      <small class="d-block text-dark"><%= truncate(method, length: 40) %></small>
                    <% end %>
                    <% if reservation.treatment_methods_array.size > 1 %>
                      <small class="text-muted">他<%= reservation.treatment_methods_array.size - 1 %>件</small>
                    <% end %>
                  </div>
                </div>
              </div>
              
              <!-- 詳細ボタン -->
              <div class="text-end">
                <%= link_to "詳細を見る", reservation, class: "btn btn-outline-primary btn-sm" %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
          <h6 class="text-muted">予約はまだありません</h6>
          <% if @unreserved_purchases.empty? %>
            <p class="text-muted small">商品を購入後、クリニック予約を行ってください。</p>
            <%= link_to "商品を見る", orders_products_path, class: "btn btn-primary btn-sm" %>
          <% else %>
            <p class="text-muted small">上記の購入からクリニック予約を行ってください。</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
    </div>
  </div>
</div>

