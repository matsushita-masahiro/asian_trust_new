<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4" style="margin-top: 80px;">
        <h4 class="text-primary">購入詳細</h4>
        <%= link_to "← 購入履歴に戻る", admin_purchases_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">購入情報</h5>
        </div>
        <div class="card-body">
          <% unit_price_total = @purchase.purchase_items.sum { |item| item.quantity * item.unit_price } %>
          <div class="row mb-4">
            <div class="col-md-6">
              <table class="table table-borderless">
                <tr>
                  <th width="30%">購入ID:</th>
                  <td><%= @purchase.id %></td>
                </tr>
                <tr>
                  <th>購入者:</th>
                  <td><%= @purchase.user.name.present? ? @purchase.user.name : @purchase.user.email %></td>
                </tr>
                <tr>
                  <th>購入日:</th>
                  <td><%= @purchase.purchased_at.strftime("%Y年%m月%d日 %H:%M") %></td>
                </tr>
                <tr>
                  <th>ステータス:</th>
                  <td>
                    <% if @purchase.built? %>
                      <span class="badge bg-warning">入金待ち</span>
                    <% elsif @purchase.paid? %>
                      <span class="badge bg-success">支払い完了</span>
                    <% else %>
                      <span class="badge bg-secondary"><%= @purchase.status %></span>
                    <% end %>
                  </td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <div class="text-end">
                <h4 class="text-primary">合計金額: ¥<%= number_with_delimiter(unit_price_total) %></h4>
                <p class="text-muted">商品数: <%= @purchase.purchase_items.count %>点</p>
              </div>
            </div>
          </div>

          <!-- 商品一覧 -->
          <h6 class="mb-3">購入商品一覧</h6>
          <div class="table-responsive">
            <table class="table table-striped">
              <thead>
                <tr>
                  <th>商品名</th>
                  <th>数量</th>
                  <th>単価</th>
                  <th>小計</th>
                  <th>操作</th>
                </tr>
              </thead>
              <tbody>
                <% @purchase.purchase_items.each do |item| %>
                  <tr>
                    <td><%= item.product.name %></td>
                    <td><%= item.quantity %></td>
                    <td>¥<%= number_with_delimiter(item.unit_price) %></td>
                    <td>¥<%= number_with_delimiter(item.total_price) %></td>
                    <td>
                      <%= link_to "編集", edit_admin_purchase_item_path(item), class: "btn btn-sm btn-outline-primary" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr class="table-info">
                  <th colspan="3">合計</th>
                  <th>¥<%= number_with_delimiter(unit_price_total) %></th>
                  <th></th>
                </tr>
              </tfoot>
            </table>
          </div>

          <!-- 入金確認ボタン -->
          <% if @purchase.built? %>
            <div class="mt-4 text-center">
              <%= link_to confirm_payment_admin_purchase_path(@purchase), 
                  method: :patch, 
                  class: "btn btn-success btn-lg",
                  data: { 
                    confirm: "この購入の入金を確認しますか？\n\n購入者: #{@purchase.user.name.present? ? @purchase.user.name : @purchase.user.email}\n合計金額: ¥#{number_with_delimiter(unit_price_total)}\n\n確認後、お客様にメールが送信されます。" 
                  } do %>
                <i class="fas fa-check-circle me-2"></i>入金確認
              <% end %>
            </div>
          <% elsif @purchase.paid? %>
            <div class="mt-4 text-center">
              <span class="badge bg-success fs-6 p-3">
                <i class="fas fa-check-circle me-2"></i>入金確認済み
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>