<div class="container-fluid mt-5 mb-5">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
          <i class="fas fa-hospital me-2"></i>
          クリニック管理
        </h2>
        <%= link_to "新しいクリニックを追加", new_admin_clinic_path, class: "btn btn-primary" %>
      </div>

      <!-- 登録済みクリニック一覧 -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-list me-2"></i>
            予約可能クリニック (<%= @clinics.count %>件)
          </h5>
        </div>
        <div class="card-body">
          <% if @clinics.any? %>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>クリニック名</th>
                    <th>ステータス</th>
                    <th>営業時間設定</th>
                    <th>休憩時間設定</th>
                    <th>休日設定</th>
                    <th>予約数</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <% @clinics.each do |clinic| %>
                    <tr>
                      <td>
                        <strong><%= clinic.name %></strong>
                      </td>
                      <td>
                        <% if clinic.is_active %>
                          <span class="badge bg-success">アクティブ</span>
                        <% else %>
                          <span class="badge bg-secondary">非アクティブ</span>
                        <% end %>
                      </td>
                      <td>
                        <% business_hours_count = clinic.clinic_business_hours.count %>
                        <% if business_hours_count > 0 %>
                          <span class="badge bg-info"><%= business_hours_count %>曜日設定済み</span>
                        <% else %>
                          <span class="badge bg-warning">未設定</span>
                        <% end %>
                      </td>
                      <td>
                        <% break_times_count = clinic.clinic_break_times.count %>
                        <% if break_times_count > 0 %>
                          <span class="badge bg-info"><%= break_times_count %>件設定済み</span>
                        <% else %>
                          <span class="text-muted">なし</span>
                        <% end %>
                      </td>
                      <td>
                        <% holidays_count = clinic.clinic_holidays.count %>
                        <% if holidays_count > 0 %>
                          <span class="badge bg-info"><%= holidays_count %>件設定済み</span>
                        <% else %>
                          <span class="text-muted">なし</span>
                        <% end %>
                      </td>
                      <td>
                        <span class="badge bg-primary"><%= clinic.clinic_reservations.count %>件</span>
                      </td>
                      <td>
                        <div class="btn-group" role="group">
                          <%= link_to "詳細", admin_clinic_path(clinic), class: "btn btn-sm btn-outline-primary" %>
                          <%= link_to "編集", edit_admin_clinic_path(clinic), class: "btn btn-sm btn-outline-secondary" %>
                          <%= link_to "削除", admin_clinic_path(clinic), method: :delete, 
                              class: "btn btn-sm btn-outline-danger",
                              confirm: "本当に削除しますか？関連する予約データも削除されます。" %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-4">
              <i class="fas fa-hospital fa-3x text-muted mb-3"></i>
              <p class="text-muted">登録済みクリニックがありません</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- 未登録のクリニックユーザー -->
      <% if @available_clinic_users.any? %>
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">
              <i class="fas fa-plus-circle me-2"></i>
              予約機能未設定のクリニックユーザー (<%= @available_clinic_users.count %>件)
            </h5>
          </div>
          <div class="card-body">
            <p class="text-muted mb-3">
              以下のクリニックユーザーは予約機能が設定されていません。
              「追加」ボタンをクリックして予約機能を有効にできます。
            </p>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>ユーザー名</th>
                    <th>メールアドレス</th>
                    <th>レベル</th>
                    <th>登録日</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <% @available_clinic_users.each do |user| %>
                    <tr>
                      <td><%= user.name %></td>
                      <td><%= user.email %></td>
                      <td><span class="badge bg-info"><%= user.level.name %></span></td>
                      <td><%= user.created_at.strftime("%Y/%m/%d") %></td>
                      <td>
                        <%= link_to "予約機能を追加", enable_reservation_admin_clinics_path(user_id: user.id), 
                            method: :post, class: "btn btn-sm btn-success",
                            confirm: "#{user.name}に予約機能を追加しますか？" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>